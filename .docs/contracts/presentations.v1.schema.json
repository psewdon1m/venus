{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:venus:presentations-state:v1",
  "title": "Current room-scoped presentation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "room_id",
    "epoch",
    "rev",
    "available",
    "import_available",
    "server_time",
    "expires_at",
    "can_control",
    "documents",
    "live",
    "job"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "room_id": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "string",
      "format": "uuid"
    },
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "available": {
      "type": "boolean"
    },
    "import_available": {
      "type": "boolean"
    },
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "can_control": {
      "type": "boolean"
    },
    "documents": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "live": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/live"
        }
      ]
    },
    "job": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/job"
        }
      ]
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_version",
        "rev",
        "title",
        "default_mode",
        "allow_switch",
        "page_count",
        "available"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "content_version": {
          "type": "string",
          "format": "uuid"
        },
        "rev": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "default_mode": {
          "enum": [
            "scroll",
            "slides"
          ]
        },
        "allow_switch": {
          "type": "boolean"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "content_version",
        "page_index"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_version": {
          "type": "string",
          "format": "uuid"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "state",
        "expires_at",
        "failure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "awaiting_upload",
            "rendering",
            "ready",
            "failed",
            "cancelled"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "failure": {
          "enum": [
            null,
            "invalid_pdf",
            "limits",
            "cancelled",
            "conflict",
            "unavailable"
          ]
        }
      }
    }
  }
}
