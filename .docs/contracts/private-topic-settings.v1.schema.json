{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venus.invalid/contracts/private-topic-settings.v1.schema.json",
  "title": "Owner-only room private topic settings, additive inactive adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "room_id", "owner_member_id", "rev", "safety_revision", "taxonomy_digest", "allow_topic_ids", "exclude_topic_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "room_id": {"type": "string", "format": "uuid"},
    "owner_member_id": {"type": "string", "format": "uuid"},
    "rev": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "safety_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "taxonomy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allow_topic_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}},
    "exclude_topic_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}}
  },
  "$defs": {
    "Put": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "expected_rev", "taxonomy_digest", "allow_topic_ids", "exclude_topic_ids"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
        "expected_rev": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "taxonomy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "allow_topic_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}},
        "exclude_topic_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}}
      }
    },
    "Exclude": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "taxonomy_digest", "topic_ids"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
        "taxonomy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "topic_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}}
      }
    }
  }
}
