          "format": "date-time"
        },
        "audience": {
          "const": "room"
        },
        "payload": {
          "$ref": "#/$defs/RoomView"
        }
      },
      "required": [
        "schema",
        "event_id",
        "room_id",
        "room_rev",
        "stream",
        "stream_rev",
        "type",
        "server_time",
        "audience",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "room_id": {
          "type": "string",
          "format": "uuid"
        },
        "room_rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream": {
          "const": "room"
        },
        "stream_rev": {
