{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:venus:calls-command:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_rev",
        "idempotency_key"
      ],
      "properties": {
        "expected_rev": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_rev",
        "idempotency_key",
        "audio",
        "video"
      ],
      "properties": {
        "expected_rev": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_rev",
        "idempotency_key",
        "member_id"
      ],
      "properties": {
        "expected_rev": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "member_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  ]
}
