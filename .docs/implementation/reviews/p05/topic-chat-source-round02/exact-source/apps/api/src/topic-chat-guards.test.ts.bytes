import {describe,it,expect} from 'vitest';
import {proposeConsent,consentResponse} from '@venus/relationship-engine';
import {TopicGames} from './topic-games.js';
import {Keyring} from './security.js';
import {gameDeliveryFence,type Rooms} from './rooms.js';
/** Actual HTTP-delivery and idempotency methods; explicit SQL/auth/source doubles.
 * Real PG/lifecycle/browser proof belongs to the separate integration producer. */
function fixture(){
 const request='11111111-1111-4111-8111-111111111111',keys=new Keyring('test',{test:Buffer.alloc(32,47).toString('base64')}),input={request_id:request,conversation_id:'conversation',epoch:1,text:'SYNTHETIC CHAT'},receipt={schema_version:2 as const,request_id:request,game_rev:1,conversation_id:'conversation',epoch:1};
 let now=1000,late=()=>{},queries=0;const auth={room:{id:'room',meeting_context:'online',host_member_id:'alice'},member:{id:'alice',role:'host'}};
 const game={id:'session',room_id:'room',rev:'1',state:'active'},baseline={context:'online',capabilities:['private_text_chat']},snapshot={baseline};
 const actors=['alice','bob'];let invitation=proposeConsent('invitation',actors,'invitation',now);for(const actor of actors)invitation=consentResponse(invitation,actor,'accept',now,{offer_id:invitation.offer_id,scope:'invitation',proposal_revision:1});
 const data={state:'active',boot_id:'',conversation_id:'conversation',plan:{interaction:'pair_private',actors},invitation,chat_quota:{total:7}},l={game,snapshot,data,row:{id:'round'},safety:{members:actors.map(member_id=>({member_id,revision:1,allow_topic_ids:['music'],excluded_topic_ids:[]}))}};
 const conv={state:{state:'open',epoch:1,clock_floor:1000,parent_expires_at:181000,offer:{state:'active',expires_at:181000},scope:{actors},preferences:Object.fromEntries(actors.map(id=>[id,{revision:1,allow:['music'],excluded:[]}]))}};
 const cached={operation:'chat',request_hash:keys.fingerprint({input,operation:'chat',scope:{sessionId:'session',roundId:'round'}}),receipt_cipher:keys.encrypt(receipt,`topic-game-receipt:room:alice:${request}:2`)};
 const c={query:async(sql:string)=>{queries++;if(sql.startsWith('SELECT private_protocol'))return {rows:[{private_protocol:2}]};if(sql.startsWith('SELECT operation,request_hash'))return {rows:[cached]};throw Error('Unexpected SQL in read-only receipt/replay: '+sql);}};
 const rooms={now:()=>now,options:{keys},transaction:async(fn:(c:unknown)=>unknown)=>fn(c),access:async()=>auth,finalAccessFence:async()=>{late();return ()=>{};}} as unknown as Rooms;
 const games=new TopicGames(rooms,{enabled:true,privateTextChat:true,source:{active:async()=>null,pinned:async()=>{throw Error('source double');},assertCurrent:()=>{}},safety:{read:async()=>{throw Error('safety double');},excludeLocked:async()=>{throw Error('safety double');},assertCurrent:()=>{}}});data.boot_id=games.bootId;
 Object.assign(games,{loaded:async()=>{Object.defineProperty(game,gameDeliveryFence,{configurable:true,value:()=>{}});return l;},actor:async()=>{},conversation:async()=>conv});
 let delivered=0;return {games,input,receipt,auth,baseline,data,conv,late:(fn:()=>void)=>late=fn,now:(n:number)=>now=n,queries:()=>queries,delivered:()=>delivered,deliver:()=>games.dispatchChatReceipt('room','credential','session','round',receipt,()=>delivered++),replay:()=>games.sendChat('room','credential','session','round',input)};
}
describe('V2 chat current policy, receipt dispatch and read-only replay',()=>{
 it('delivers an online enabled receipt for a currently consenting pair actor',async()=>{const f=fixture();await f.deliver();expect(f.delivered()).toBe(1);});
 it.each(['in_person','flag_off','capless','current_context','foreign_actor','stopped','old_boot','old_epoch','old_conversation'] as const)('denies %s at both receipt dispatch and exact retry',async fault=>{const f=fixture();if(fault==='in_person')f.baseline.context='in_person';if(fault==='flag_off')f.games.options.privateTextChat=false;if(fault==='capless')f.baseline.capabilities=[];if(fault==='current_context')f.auth.room.meeting_context='in_person';if(fault==='foreign_actor')f.auth.member.id='outsider';if(fault==='stopped')f.data.state='stopped';if(fault==='old_boot')f.data.boot_id='previous';if(fault==='old_epoch')f.conv.state.epoch=2;if(fault==='old_conversation')f.data.conversation_id='replacement';await expect(f.deliver()).rejects.toThrow();await expect(f.replay()).rejects.toThrow();expect(f.delivered()).toBe(0);expect(f.data.chat_quota.total).toBe(7);});
 it.each(['flag','context','consent_expiry'] as const)('rechecks %s after the final credential await',async fault=>{for(const operation of ['deliver','replay'] as const){const f=fixture();f.late(()=>{if(fault==='flag')f.games.options.privateTextChat=false;if(fault==='context')f.auth.room.meeting_context='in_person';if(fault==='consent_expiry')f.now(181000);});await expect(f[operation]()).rejects.toThrow();expect(f.delivered()).toBe(0);expect(f.data.chat_quota.total).toBe(7);}});
 it('returns the original receipt without target/reconcile/writes or quota consumption',async()=>{const f=fixture();expect(await f.replay()).toEqual(f.receipt);expect(await f.replay()).toEqual(f.receipt);expect(f.queries()).toBe(4);expect(f.data.chat_quota.total).toBe(7);});
 it('keeps omitted backend flag disabled',async()=>{const f=fixture();delete f.games.options.privateTextChat;await expect(f.deliver()).rejects.toMatchObject({code:'PRIVATE_CHAT_UNAVAILABLE'});expect(f.delivered()).toBe(0);});
 it.each(['\ud800','\udfff','valid\ud800tail','\u202eoverride','bad\nline','   '])('rejects malformed Unicode/control text before SQL %#',async text=>{const f=fixture();f.input.text=text;await expect(f.replay()).rejects.toMatchObject({code:'INVALID_TEXT',statusCode:400});expect(f.queries()).toBe(0);});
 it('accepts a well-formed supplementary character in plain text',async()=>{const f=fixture();let ran=false;Object.assign(f.games,{mutation:async()=>{ran=true;return f.receipt;}});f.input.text='Привет 🦋';await f.replay();expect(ran).toBe(true);});
});

describe('next round publication after an awaited write',()=>{
 async function next(context:string,flag:boolean,lateOff=false){const f=fixture();f.baseline.context=context;f.games.options.privateTextChat=flag;let writes=0,parentChecks=0;const game={id:'session',room_id:'room',current_round:1},plan={round_id:'new-round',room_id:'room',session_id:'session',round_index:2,mode:'questions',interaction:'pair_private',actors:['alice','bob']};Object.defineProperty(game,gameDeliveryFence,{configurable:true,value:()=>parentChecks++});Object.assign(f.games,{bump:async()=>{if(lateOff)f.games.options.privateTextChat=false;}});const c={query:async()=>{writes++;return {rows:[]};}},create=Reflect.get(f.games,'newRound') as (...args:unknown[])=>Promise<unknown>;return {f,game,writes:()=>writes,parentChecks:()=>parentChecks,run:()=>create.call(f.games,c,{game,snapshot:{baseline:f.baseline}},plan)};}
 it('denies an unavailable online channel before inserting a new round',async()=>{const f=await next('online',false);await expect(f.run()).rejects.toMatchObject({code:'PRIVATE_CHAT_UNAVAILABLE'});expect(f.writes()).toBe(0);});
 it('preserves the old fence and rejects flag-off after the final round write',async()=>{const f=await next('online',true,true);await f.run();expect(f.writes()).toBe(3);const check=Reflect.get(f.game,gameDeliveryFence) as ()=>void;expect(check).toThrow(expect.objectContaining({code:'PRIVATE_CHAT_UNAVAILABLE'}));expect(f.parentChecks()).toBe(1);});
 it('allows in-person verbal private rounds with chat switched off',async()=>{const f=await next('in_person',false);await f.run();expect(Reflect.get(f.game,gameDeliveryFence)).not.toThrow();expect(f.parentChecks()).toBe(1);});
});
