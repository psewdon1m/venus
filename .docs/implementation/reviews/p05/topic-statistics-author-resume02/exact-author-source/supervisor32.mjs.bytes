/** New external32GiB host supervisor. Never substitutes for128/512MiB consumers.
 * Statistical worker is a separate host process. Only inert native-free probe
 * uses Docker; no build/pull or functional runtime fixture is launched here.
 */
import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {readFileSync,writeFileSync,renameSync,mkdirSync,existsSync,lstatSync,statfsSync} from 'node:fs';
import {resolve,join,dirname,parse,sep} from 'node:path';
import {fileURLToPath} from 'node:url';
import {performance} from 'node:perf_hooks';
import {setTimeout,clearTimeout} from 'node:timers';
import {createHash} from 'node:crypto';
import {limits,validateResourcePlan} from './resource32-policy.mjs';
import {buildAuthority} from './worker.mjs';
import {authorize} from './section-runner.mjs';
const here=dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex');
export function checkSample(s){assert.equal(s.global_cap_bytes,limits.global);assert.equal(s.native_reserved_bytes,limits.native);for(const k of ['payload','archive','inputs','control']){assert(Number.isSafeInteger(s[k+'_allocated_bytes'])&&s[k+'_allocated_bytes']>=0);assert(s[k+'_allocated_bytes']<=limits[k],'STATS32_'+k.toUpperCase()+'_CAP');}assert(s.payload_allocated_bytes+s.archive_allocated_bytes+s.inputs_allocated_bytes+s.control_allocated_bytes+limits.native+limits.active+limits.safety<=limits.global,'GLOBAL32_CAP');for(const k of ['actual_host_free_bytes','actual_native_free_bytes'])assert(BigInt(s[k])>=BigInt(limits.reserve+limits.global),'LOW_ACTUAL_FREE:'+k);return true;}
export function validatePlan(p){validateResourcePlan(p);for(const k of ['repository','output_root','ack','source_manifest','input_manifest','fixture_directory','node','python'])assert(typeof p[k]==='string'&&p[k].length>0);assert.equal(p.worker_protocol,'EXTERNAL_GUARD_REQUIRED');const root=resolve(p.output_root),repo=resolve(p.repository);assert(root!==repo&&!root.startsWith(repo+sep),'OUTPUT_MUST_BE_EXTERNAL_TO_CLEAN_SOURCE');assert(!existsSync(root),'NO_EXISTING_OUTPUT_REUSE');assert.equal(p.native_probe_scope,'INERT_READ_ONLY_NO_MOUNTS');return true;}
function bounded(command,args,timeout=10000,cap=1024*1024){return new Promise((done,reject)=>{const c=spawn(command,args,{windowsHide:true}),chunks=[],errors=[];let bytes=0,closed=false;const end=(e,v)=>{if(closed)return;closed=true;clearTimeout(timer);e?reject(e):done(v);},timer=setTimeout(()=>{c.kill('SIGKILL');end(Error('GUARD_COMMAND_TIMEOUT'));},timeout);for(const[s,out]of [[c.stdout,chunks],[c.stderr,errors]])s.on('data',b=>{bytes+=b.length;if(bytes>cap){c.kill('SIGKILL');end(Error('GUARD_CAPTURE_CAP'));}else out.push(b);});c.on('error',e=>end(e));c.on('close',code=>code===0?end(null,Buffer.concat(chunks).toString()):end(Error('GUARD_COMMAND_FAILURE:'+command+':'+code+':'+Buffer.concat(errors).toString().slice(0,1000))));});}
export function validateProbe(r,p){assert.equal(r.Name,'/'+p.project+'-native-free');assert.equal(r.Image,p.image);assert.equal(r.Config.Labels['com.venus.stats32.owner'],p.owner);assert.equal(r.HostConfig.NetworkMode,'none');assert.equal(r.HostConfig.IpcMode,'none');assert.equal(r.HostConfig.ReadonlyRootfs,true);assert.equal(r.HostConfig.Memory,64*1024**2);assert.equal(r.HostConfig.LogConfig.Type,'none');assert.deepEqual(r.Mounts,[]);assert.deepEqual(r.Config.Entrypoint,['node']);return true;}
function checkParents(path){for(let p=resolve(path);;p=dirname(p)){const s=lstatSync(p);assert(s.isDirectory()&&!s.isSymbolicLink()&&!(s.fileAttributes&0x400),'OUTPUT_PARENT_LINK');if(p===parse(p).root)break;}}
export async function main(args=process.argv.slice(2)){
 if(args.length===0||args[0]==='--describe'){console.log(JSON.stringify({status:'NOT_RUN',profile:'P05_STATS32_EXTERNAL_1',limits,actual_statistics_RUN:false,actual_runtime84_RUN:false}));return;}
 assert.equal(args.length,1);const planFile=resolve(args[0]),p=JSON.parse(readFileSync(planFile));validatePlan(p);const ack=JSON.parse(readFileSync(p.ack));authorize(ack,buildAuthority(p));assert.equal(ack.image,p.image);assert.deepEqual(ack.stats32_limits,limits);assert.equal(ack.total_wall_ms,p.total_wall_ms);assert.deepEqual(ack.section_wall_ms,p.section_wall_ms);
 const helper=join(here,'allocated-tree07.py');assert.equal(sha(readFileSync(helper)),'7adcdaf51b40191ee5abf76def60292aa4a49364a62721968c68cd0ef7ebb4de','ACCEPTED_ALLOCATED_HELPER_PIN');checkParents(dirname(p.output_root));
 const docker=async a=>JSON.parse(await bounded('docker',a)),name=p.project+'-native-free';let probeCreated=false,worker=null,failed=null,counter=0,stop=false,stdoutBytes=0,stderrBytes=0;const started=performance.now(),raw={stdout:[],stderr:[]};
 // Exact local image inspect only; Docker never pulls a missing image.
 assert.equal(sha(readFileSync(planFile)),ack.resource_plan_sha256,'RESOURCE_PLAN_ACK_PIN');assert.equal((await docker(['image','inspect',p.image]))[0].Id,p.image);assert.equal((await bounded('docker',['ps','-aq','--filter','label=com.venus.stats32.owner='+p.owner])).trim(),'','OWNER_ALREADY_HAS_CONTAINERS');assert.equal((await bounded('docker',['volume','ls','-q','--filter','label=com.venus.stats32.owner='+p.owner])).trim(),'','OWNER_ALREADY_HAS_VOLUMES');
 mkdirSync(p.output_root);for(const n of ['payload','archive','inputs','control'])mkdirSync(join(p.output_root,n));writeFileSync(join(p.output_root,'control','OWNER'),p.owner+'\n',{flag:'wx'});
 function atomic(name,value){const path=join(p.output_root,'control',name),next=path+'.next';assert(!existsSync(next));writeFileSync(next,JSON.stringify(value)+'\n',{flag:'wx'});renameSync(next,path);}
 async function allocation(path){let last;for(let i=0;i<3;i++){try{const r=JSON.parse(await bounded(p.python,['-B',helper,'--root',path],1500));return r.allocated_bytes;}catch(e){last=e;}}throw last;}
 async function measure(){assert(performance.now()-started<p.total_wall_ms,'GLOBAL_WALL_LIMIT');const nativeAt=performance.now(),free=JSON.parse(await bounded('docker',['exec',name,'node','-e',"const f=require('fs'),a=require('assert/strict');a(!f.readFileSync('/proc/self/mountinfo','utf8').split('\\n').some(l=>l.split(' ')[4]==='/dev/shm'));const s=f.statfsSync('/app',{bigint:true});console.log(JSON.stringify({free:String(s.bavail*s.bsize)}));"],1500)),s={owner:p.owner,counter:++counter,stop_requested:false,global_cap_bytes:limits.global,native_reserved_bytes:limits.native,actual_native_free_bytes:free.free};const fs=statfsSync(p.output_root,{bigint:true});s.actual_host_free_bytes=String(fs.bavail*fs.bsize);for(const n of ['payload','archive','inputs','control'])s[n+'_allocated_bytes']=await allocation(join(p.output_root,n));assert(performance.now()-nativeAt<2000,'NATIVE_SAMPLE_STALE_AFTER_HOST_SCAN');checkSample(s);s.host_payload_allocated_bytes=s.payload_allocated_bytes;atomic('guard.json',s);return s;}
 async function killWorker(){if(!worker||worker.exitCode!==null)return;if(process.platform==='win32')await bounded('taskkill',['/PID',String(worker.pid),'/T','/F'],5000).catch(()=>{});else{try{process.kill(-worker.pid,'SIGKILL');}catch{worker.kill('SIGKILL');}}}
 try{
  const script="const fs=require('fs'),assert=require('assert/strict');assert(!fs.readFileSync('/proc/self/mountinfo','utf8').split('\\n').some(l=>l.split(' ')[4]==='/dev/shm'));setInterval(()=>{},1000);";
  await bounded('docker',['create','--name',name,'--label','com.venus.stats32.owner='+p.owner,'--network','none','--ipc','none','--read-only','--user','1000:1000','--cap-drop','ALL','--security-opt','no-new-privileges:true','--memory','64m','--cpus','0.1','--pids-limit','32','--log-driver','none','--entrypoint','node',p.image,'-e',script]);probeCreated=true;validateProbe((await docker(['inspect',name]))[0],p);await bounded('docker',['start',name]);await measure();
  worker=spawn(p.node,[join(here,'worker.mjs'),planFile],{windowsHide:true,detached:process.platform!=='win32',stdio:['ignore','pipe','pipe']});const completion=new Promise(resolve=>{worker.on('error',e=>{failed=e;resolve(-1);});worker.on('close',resolve);});
  worker.stdout.on('data',b=>{stdoutBytes+=b.length;if(stdoutBytes>1024**2){failed=Error('WORKER_STDOUT_CAP');void killWorker();}else raw.stdout.push(b);});worker.stderr.on('data',b=>{stderrBytes+=b.length;if(stderrBytes>1024**2){failed=Error('WORKER_STDERR_CAP');void killWorker();}else raw.stderr.push(b);});
  const monitoring=(async()=>{while(!stop){await new Promise(r=>setTimeout(r,250));if(!stop)await measure();}})().catch(async e=>{failed=e;await killWorker();});
  const code=await completion;stop=true;await monitoring;assert(!failed,failed?.message);assert.equal(code,0,'STAT_WORKER_NONZERO');await measure();const result=JSON.parse(readFileSync(join(p.output_root,'control','worker-final.json')));assert.equal(result.status,'PURE_SECTIONS_COMPLETE_REQUIRES_INDEPENDENT_RAW_AUDIT');atomic('supervisor-final.json',{status:'BOUNDED_PURE_EXECUTION_COMPLETE_REQUIRES_INDEPENDENT_RAW_AUDIT',owner:p.owner,elapsed_ms:performance.now()-started,full_P05_PASS:false});
 }catch(e){stop=true;await killWorker();atomic('supervisor-final.json',{status:'NOT_ACCEPTED_PREFIX_RETAINED',owner:p.owner,error:e.message,elapsed_ms:performance.now()-started,full_P05_PASS:false});throw e;}
 finally{stop=true;for(const key of ['stdout','stderr'])writeFileSync(join(p.output_root,'control','worker-'+key+'.txt'),Buffer.concat(raw[key]),{flag:'wx'});if(probeCreated){const rows=await docker(['inspect',name]);validateProbe(rows[0],p);await bounded('docker',['rm','-f',name]);}assert.equal((await bounded('docker',['ps','-aq','--filter','label=com.venus.stats32.owner='+p.owner])).trim(),'','OWNED_PROBE_CLEANUP_INCOMPLETE');}
}
if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url))main().catch(e=>{console.error(e.stack);process.exitCode=1;});
