timeline=[{k:x.get(k)for k in ['id','locale','cycle','started_native_ms','response_native_ms','body_complete_native_ms','status','request_response_ui_equal']}|{'kind':x['route']['kind'],'dto_rev':x['dto'].get('rev'),'dto_session':x['dto'].get('session'),'dto_round':x['dto'].get('round'),'error_code':x['dto'].get('error_code')}for x in rows]
