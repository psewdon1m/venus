observed={'status':'PASS_READONLY_ACTUAL_FAILURE_DIAGNOSIS_NOT_BROWSER_ACCEPTANCE','actual_index_sha256':sha(E/'INDEX.json'),'verified_children':48,'producer_pins':len(pins),'case_status':{'PASS':5,'FAIL':1,'NOT_RUN':10},'cleanup':'PASS','prepared_cycle':28,'prepared_monotonic_ms':t['prepared_monotonic_ms'],'prepared_lease_remaining_ms':t['lease_remaining_ms'],'ticket_deadline_monotonic_ms':t['deadline_monotonic_ms'],'click_started_monotonic_ms':event['click_started_monotonic_ms'],'new_same_scope_own_request_started_monotonic_ms':own['started_native_ms'],'request_after_click_start_ms':own['started_native_ms']-event['click_started_monotonic_ms'],'matching_POST_observed':False,'assertion_timestamp_observed':False,'assertion_current_snapshot_observed':False,'current_scope_rev_at_failure':failure['actual_fixture']['game_rev'],'actual_primary_condition_within_combined_assert':'UNOBSERVED_NOT_READY_VS_CYCLE_CHANGED','timeline':timeline,'helper_snapshot_scope':'PASSIVE_OBSERVER_MODEL_ONLY_NOT_APP_CACHE_OR_AUTH','actual_Docker_calls':0,'actual_repeat':False}
