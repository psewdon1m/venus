import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {EventEmitter} from 'node:events';
import {setTimeout} from 'node:timers';
import {performance} from 'node:perf_hooks';
import {emitTerminal,verifyTerminal} from '../p05-topic-measurements-method08/verify-terminal.mjs';
const load=p=>JSON.parse(readFileSync(p)),root='.docs/implementation/evidence/p05/resume-r100-method07-attempt01/run',prep=load(root+'/preparation.json'),supervisor=load(root+'/control/live/watchdog-terminal.json'),ownedAfter=load(root+'/control/receipts/owned-after-cleanup.json'),rows=[];
const base={terminal_transport:'BOUNDED_STDOUT_AFTER_SUPERVISOR_V1',status:'COMPLETE_NON_GATING',error:null,capacityFault:null,cleanup:'completed',exportVerified:true,exportVerifiedCounter:987,workerStopped:true,auditFailures:[],owner:prep.owner,container:prep.container,volume:prep.volume,source_identity:prep.source_identity,image:prep.image,root:prep.root,supervisor_exit_code:0,supervisor_status:'SUPERVISOR_COMPLETE_NON_GATING',elapsed_ms:72000,statistics_RUN:false,full_matrix_feasibility:false};
const opts=()=>structuredClone({exitCode:0,prep,supervisor,ownedAfter});
async function check(name,work){try{const details=await work();rows.push({name,status:'PASS',details});}catch(e){rows.push({name,status:'FAIL',error:e.message});}}
await check('fake08transportshape reconciles actual07 closed proof fixtures only',()=>assert.equal(verifyTerminal(JSON.stringify(base),opts()).status,'VERIFIED_COMPLETE_NON_GATING_TERMINAL'));
for(const[k,v]of [['status','NOT_ACCEPTED'],['error','late'],['capacityFault','HOST_RECEIPT_WRITE_GUARD_FAILED'],['auditFailures',[{path:'late'}]],['exportVerified',false],['workerStopped',false],['cleanup','retained'],['owner','foreign'],['container','foreign'],['volume','foreign'],['source_identity','foreign'],['image','foreign'],['root','foreign'],['supervisor_exit_code',1],['supervisor_status','FAILED'],['elapsed_ms',-1],['exportVerifiedCounter',0],['statistics_RUN',true],['full_matrix_feasibility',true]])await check('strict verifier rejects '+k,()=>assert.throws(()=>verifyTerminal(JSON.stringify({...base,[k]:v}),opts())));
await check('missing explicitnull field/extrafield/twoobjects/truncated/oversize/old07 denied',()=>{const missing={...base};delete missing.capacityFault;for(const text of [JSON.stringify(missing),JSON.stringify({...base,extra:true}),JSON.stringify(base)+'\n'+JSON.stringify(base),'{',' '.repeat(65537),readFileSync('.docs/implementation/evidence/p05/resume-r100-method07-attempt01/p05-resume-r100-method07-run01.txt','utf8')])assert.throws(()=>verifyTerminal(text,opts()));});
for(const which of ['exit','supervisor-fault','supervisor-phase','supervisor-owner','supervisor-low-space','supervisor-disallowed-space','supervisor-stop','supervisor-manual','retained-volume','retained-prefix','worker-running'])await check('external proof '+which+' denied',()=>{const o=opts();if(which==='exit')o.exitCode=1;if(which==='supervisor-fault')o.supervisor.capacity_fault='low';if(which==='supervisor-phase')o.supervisor.phase='RUN';if(which==='supervisor-owner')o.supervisor.owner='foreign';if(which==='supervisor-low-space')o.supervisor.last_actual_host_sample.available_bytes='0';if(which==='supervisor-disallowed-space')o.supervisor.last_actual_host_sample.host_output_allowed=false;if(which==='supervisor-stop')o.supervisor.worker_stop_confirmed=false;if(which==='supervisor-manual')o.supervisor.manual_cleanup_required=true;if(which==='retained-volume')o.ownedAfter.remaining.volumes=['retained'];if(which==='retained-prefix')o.ownedAfter.prefix_retained_without_export=true;if(which==='worker-running')o.ownedAfter.workerStopped=false;assert.throws(()=>verifyTerminal(JSON.stringify(base),o));});
class Sink extends EventEmitter{constructor(mode){super();this.mode=mode;this.text='';this.destroyed=false;this.calls=0;}write(s,cb){this.calls++;this.text+=s;if(this.mode==='throw')throw Error('PIPE');if(this.mode==='cb-error')cb(Error('EPIPE'));if(this.mode==='event-error')this.emit('error',Error('EPIPE'));if(this.mode==='ok')cb();if(this.mode==='delayed')setTimeout(()=>cb(),20);return false;}destroy(){this.destroyed=true;}}
await check('false backpressure return still awaits callback and exact newline',async()=>{const s=new Sink('delayed'),start=performance.now();let done=false;const p=emitTerminal(base,{stream:s}).then(()=>{done=true;});await Promise.resolve();assert.equal(done,false);await p;assert(performance.now()-start>=10);assert.equal(s.text,JSON.stringify(base)+'\n');assert.equal(s.calls,1);});
for(const mode of ['throw','cb-error','event-error','blocked'])await check('emitter '+mode+' fails closed',async()=>{const s=new Sink(mode);await assert.rejects(emitTerminal(base,{stream:s,timeoutMs:10}));if(mode==='blocked')assert(s.destroyed);});
await check('oversize emits zero bytes',async()=>{const s=new Sink('ok');await assert.rejects(emitTerminal({...base,padding:'X'.repeat(65536)},{stream:s}));assert.equal(s.calls,0);});
const source=readFileSync('.artifacts/p05-topic-measurements-method08/r100-v3-launcher.mjs','utf8'),tailStart=source.indexOf('  clearInterval(heartbeat);'),tail=source.slice(tailStart,source.indexOf('\n }',tailStart)),AsyncFunction=Object.getPrototypeOf(async function(){}).constructor;
const replay=new AsyncFunction('patch','emitFails',`
const prep=${JSON.stringify(prep)},root=prep.root,performance={now:()=>100},started=0,heartbeat=null,watchdog={exitCode:0},clearInterval=()=>{},process={exitCode:0};
let status='COMPLETE_NON_GATING',error=null,capacityFault=null,cleanup='completed',exportVerified=true,exportVerifiedCounter=987,workerStopped=true,auditFailures=[],supervisorExitCode=0,supervisorStatus='SUPERVISOR_COMPLETE_NON_GATING';
const outputs=[],safe=()=>{throw Error('POSTSTOPWRITE');},writeFileSync=()=>{throw Error('POSTSTOPWRITE');};
({status,error,capacityFault,cleanup,exportVerified,exportVerifiedCounter,workerStopped,auditFailures,supervisorExitCode,supervisorStatus}={status,error,capacityFault,cleanup,exportVerified,exportVerifiedCounter,workerStopped,auditFailures,supervisorExitCode,supervisorStatus,...patch});
const emitTerminal=async r=>{if(emitFails)throw Error('PIPE');outputs.push(r);};
${tail}
return{status,exitCode:process.exitCode,outputs};`);
await check('exact launcher tail emits success without any owned write',async()=>{const r=await replay({},false);assert.equal(r.status,'COMPLETE_NON_GATING');assert.equal(r.outputs.length,1);verifyTerminal(JSON.stringify(r.outputs[0]),opts());});
for(const patch of [{error:'late'},{capacityFault:'late'},{auditFailures:[{}]},{cleanup:'retained'},{exportVerified:false},{workerStopped:false},{supervisorExitCode:1},{supervisorStatus:'FAILED'}])await check('exact launcher rejects final '+Object.keys(patch)[0],async()=>{const r=await replay(patch,false);assert.equal(r.status,'NOT_ACCEPTED');assert.equal(r.outputs[0].status,'NOT_ACCEPTED');});
await check('exact launcher emission failure sets failure exit',async()=>{const r=await replay({},true);assert.equal(r.status,'NOT_ACCEPTED');assert.equal(r.exitCode,1);});
console.log(JSON.stringify({status:rows.every(x=>x.status==='PASS')?'PASS_INDEPENDENT_METHOD_ONLY':'FAIL',controls:rows,count:rows.length,actual_R100:false,actual_Docker_calls:0,prepare_calls:0,statistics_RUN:false},null,2));if(rows.some(r=>r.status!=='PASS'))process.exitCode=1;
