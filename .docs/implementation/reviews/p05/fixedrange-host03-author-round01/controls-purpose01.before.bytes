import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {producerPins,validateAuthority,verifyRangeExport} from '../p05-fixedrange-host03.mjs';
import {durableSink} from '../p05-pilot-corpus-ranges01/raw/durable-sink.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),here=path.dirname(fileURLToPath(import.meta.url)),root=path.join(here,'fixture');
assert(!fs.existsSync(root));fs.mkdirSync(root);const producer=path.join(root,'producer');fs.mkdirSync(producer);
const range={section:'m3-fairness',start:100,count:2,end:102};
const bindingRaw=Buffer.from(JSON.stringify({source_identity:'a'.repeat(64),image:'sha256:'+'b'.repeat(64)})),preregRaw=Buffer.from(JSON.stringify({counts:{'m3-fairness':84000}})),reviewRaw=Buffer.from(JSON.stringify({status:'PASS_METHOD_ONLY'}));
fs.writeFileSync(path.join(producer,'binding.json'),bindingRaw);fs.writeFileSync(path.join(producer,'RANGE-PREREG.json'),preregRaw);fs.writeFileSync(path.join(producer,'range-worker.mjs'),'// explicit inert fixture\n');fs.mkdirSync(path.join(producer,'nested'));fs.writeFileSync(path.join(producer,'nested','helper.mjs'),'// fixture2\n');
const pins=producerPins(producer),ack={status:'ROOT_RUN_ACK',purpose:'PILOT_FIXED_RANGE_01',owner:'c'.repeat(32),no_actual_approval:false,host_runner_sha256:'d'.repeat(64),method_review_sha256:sha(reviewRaw),binding_sha256:sha(bindingRaw),prereg_sha256:sha(preregRaw),producer_pins:pins,source_identity:'a'.repeat(64),image_id:'sha256:'+'b'.repeat(64),range};
let checks=0;const test=(name,fn)=>{fn();checks++;console.log('PASS '+name);};
test('one exact range accepted',()=>assert.deepEqual(validateAuthority(ack,bindingRaw,preregRaw,reviewRaw,pins,'d'.repeat(64)),range));
for(const [key,value] of [['status','NOT_AUTHORIZED'],['purpose','wrong'],['no_actual_approval',true],['owner','foreign'],['host_runner_sha256','x'],['source_identity','e'.repeat(64)],['image_id','sha256:'+'e'.repeat(64)],['method_review_sha256','0'.repeat(64)],['binding_sha256','0'.repeat(64)],['prereg_sha256','0'.repeat(64)],['producer_pins',{}]])test('authority rejects '+key,()=>assert.throws(()=>validateAuthority({...ack,[key]:value},bindingRaw,preregRaw,reviewRaw,pins,'d'.repeat(64))));
for(const value of [{...range,start:-1},{...range,count:10001,end:10101},{...range,end:103},{...range,section:'unknown'},{...range,start:83999,end:84001}])test('range rejects '+JSON.stringify(value),()=>assert.throws(()=>validateAuthority({...ack,range:value},bindingRaw,preregRaw,reviewRaw,pins,'d'.repeat(64))));
test('nested dependency mutation changes exact inventory',()=>{fs.writeFileSync(path.join(producer,'nested/helper.mjs'),'// changed\n');assert.notDeepEqual(producerPins(producer),pins);});
const output=path.join(root,'export');fs.mkdirSync(output);
const summary={status:'RANGE_EXECUTION_COMPLETE_NOT_STATISTICAL_ACCEPTANCE',range,owner:ack.owner,source_identity:ack.source_identity,image:ack.image_id,binding_sha256:ack.binding_sha256,prereg_sha256:ack.prereg_sha256,method_review_sha256:ack.method_review_sha256,completed:2,typed_refusals:0,elapsed_ms:3,full_section_PASS:false,full_P05_PASS:false};
const sink=durableSink(path.join(output,'raw'),{guard:()=>{},owner:ack.owner,payloadLimit:65536});
for(let ordinal=range.start;ordinal<range.end;ordinal++)sink.append('corpus-case',{section:range.section,ordinal,result:{status:'COMPLETE'},elapsed_ms:1},{group:range.section,cell:String(ordinal)});
summary.raw=await sink.finish(summary);summary.elapsed_ms=4;const summaryFile=path.join(output,'summary.json');fs.writeFileSync(summaryFile,JSON.stringify(summary));
test('count+1 sealed chain verified without statistical acceptance',()=>assert.equal(verifyRangeExport(output,ack,range).records,3));
test('wrong owner rejects verified export',()=>assert.throws(()=>verifyRangeExport(output,{...ack,owner:'f'.repeat(32)},range)));
test('changed expected ordinal rejects export',()=>assert.throws(()=>verifyRangeExport(output,ack,{...range,start:99,end:101})));
const saved=fs.readFileSync(summaryFile);
test('sealed footer refuses unauthenticated summary substitution',()=>{fs.writeFileSync(summaryFile,JSON.stringify({...summary,source_identity:'0'.repeat(64)}));assert.throws(()=>verifyRangeExport(output,ack,range));fs.writeFileSync(summaryFile,saved);});
test('refusal counter mismatch rejected',()=>{fs.writeFileSync(summaryFile,JSON.stringify({...summary,typed_refusals:1}));assert.throws(()=>verifyRangeExport(output,ack,range));fs.writeFileSync(summaryFile,saved);});
const segment=path.join(output,'raw/payload/000000001.gz'),bytes=fs.readFileSync(segment);
test('raw segment alteration rejected',()=>{const altered=Buffer.from(bytes);altered[15]^=1;fs.writeFileSync(segment,altered);assert.throws(()=>verifyRangeExport(output,ack,range));fs.writeFileSync(segment,bytes);});
const source=fs.readFileSync(new URL('../p05-fixedrange-host03.mjs',import.meta.url),'utf8');
test('stop-before-export and verified-only cleanup carry',()=>{assert(source.includes("run(['start','--attach',name],1205000)"));assert(source.indexOf('report.writer_stopped=true;report.worker_exit')<source.indexOf("ok(['cp'"));assert(source.includes("if(report.export_verified)ok(['rm',name])"));assert(source.includes("if(report.export_verified)ok(['volume','rm',volume])"));assert(source.includes("'/run/consumer/range-worker.mjs','range',range.section,String(range.start),String(range.count)"));});
console.log(JSON.stringify({status:'PASS_FINITE_HOST_ONLY',checks,Docker_RUN:false,native_selector_cases:0,raw_fixture_cases:2}));
