import assert from 'node:assert/strict';
import fs from 'node:fs';
import {createHash} from 'node:crypto';
import {producerPins} from '../p05-fixedrange-host03.mjs';
import {validateMatchedAuthority} from '../p05-privacy-matched-host01.mjs';
import {executeMatched,validateAck} from './matched-worker.mjs';
import {caseAt} from './consumer.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),base=new URL('./',import.meta.url),file=n=>fs.readFileSync(new URL(n,base));
const bindingRaw=file('binding.json'),preregRaw=file('PREREG.json'),binding=JSON.parse(bindingRaw),reviewRaw=fs.readFileSync('.docs/implementation/reviews/p05/privacy-matched-independent-round01/INDEX.json'),pins=producerPins(new URL('./',import.meta.url).pathname.replace(/^\/(\w:)/,'$1')),parent=producerPins('.artifacts/p05-pilot-corpus-ranges02'),runnerHash=sha(fs.readFileSync('.artifacts/p05-privacy-matched-host01.mjs'));
const ack={status:'ROOT_RUN_ACK',purpose:'PILOT_PRIVACY_MATCHED_01',no_actual_approval:false,owner:'a'.repeat(32),range:{section:'privacy-matched',start:0,count:84,end:84},source_identity:binding.source_identity,image_id:binding.image,host_runner_sha256:runnerHash,shared_host_sha256:binding.shared_host_sha256,producer_pins:pins,range_producer_pins:parent,binding_sha256:sha(bindingRaw),prereg_sha256:sha(preregRaw),method_review_sha256:sha(reviewRaw)};
const checks=[];async function check(name,fn){await fn();checks.push(name);console.log('PASS '+name);}
const validate=a=>validateMatchedAuthority(a,bindingRaw,preregRaw,reviewRaw,pins,parent,runnerHash);
await check('cold exact ACK host+worker authority, not actualauthorization',()=>{validate(ack);validateAck(ack,bindingRaw,preregRaw,reviewRaw);});
for(const [key,value]of [['status','PENDING'],['purpose','PILOT_FIXED_RANGE_02'],['no_actual_approval',true],['owner','foreign'],['image_id','sha256:'+'0'.repeat(64)],['source_identity','0'.repeat(64)],['host_runner_sha256','0'.repeat(64)],['shared_host_sha256','0'.repeat(64)],['binding_sha256','0'.repeat(64)],['method_review_sha256','0'.repeat(64)]])await check('reject changed '+key,()=>assert.throws(()=>validate({...ack,[key]:value})));
await check('reject altered ordinal range and dependency pins',()=>{assert.throws(()=>validate({...ack,range:{...ack.range,count:83}}));assert.throws(()=>validate({...ack,range_producer_pins:{}}));assert.throws(()=>validate({...ack,producer_pins:{}}));});
await check('accepted consumer and model exact sourcebytes',()=>{for(const n of ['consumer.mjs','matched-model.mjs'])assert.equal(sha(file(n)),sha(fs.readFileSync('.artifacts/p05-privacy-matched01/'+n)));});
const fake=d=>({descriptor:d,comparisons:{exclusion:{status:'RETAINED_OUT_OF_SUPPORT_NOT_PRIVACY_PASS'},semantic:{status:'PASS_MATCHED_DOMAIN_ONLY'}}});
function runOptions(extra={}){const rows=[],calls=[];return {rows,calls,options:{append:(_kind,value)=>rows.push(JSON.parse(JSON.stringify(value))),replay:async function*(){yield* rows;},measure:(_env,d)=>{calls.push(d.ordinal);return fake(d);},reduce:records=>{assert.equal(records.length,84);for(const[i,row]of records.entries())assert.deepEqual(row.descriptor,caseAt(i));return {status:'NOT_COVERED',cases:84,comparisons:168,full_P05_PASS:false};},...extra}};}
await check('exact84 ordinals and canonical replay; NOT_COVERED neverconvertedPASS',async()=>{const f=runOptions(),result=await executeMatched({},f.options);assert.equal(result.status,'NOT_COVERED');assert.equal(result.full_P05_PASS,false);assert.deepEqual(f.calls,Array.from({length:84},(_,i)=>i));});
await check('first comparison FAIL retains row then stops before nextcase/replay',async()=>{let replayed=false;const f=runOptions({measure:(_env,d)=>({...fake(d),comparisons:{exclusion:{status:d.ordinal===3?'FAIL_SELECTOR_PUBLIC_SEQUENCE':'PASS_MATCHED_DOMAIN_ONLY'}}}),replay:async function*(){replayed=true;}});await assert.rejects(executeMatched({},f.options),/MATCHED_SELECTOR/);assert.equal(f.rows.length,4);assert.equal(replayed,false);});
await check('unknown measure failure no retries or later arms and exactprefix retained',async()=>{const error=Object.assign(Error('controlled'),{matched_prefix:{failed_arm_ordinal:2,completed_arms:['prior','E0']}}),f=runOptions({measure:(_env,d)=>{if(d.ordinal===2)throw error;return fake(d);}});await assert.rejects(executeMatched({},f.options),e=>e===error);assert.equal(f.rows.length,2);assert.deepEqual(error.matched_prefix.completed_arms,['prior','E0']);});
await check('missing replay row or altered outer ordinal rejects',async()=>{for(const missing of [true,false]){const f=runOptions();f.options.replay=async function*(){for(const [i,row]of f.rows.entries()){if(missing&&i===83)continue;yield !missing&&i===3?{...row,ordinal:4}:row;}};await assert.rejects(executeMatched({},f.options));}});
await check('fullnative reducer FAIL propagates, no falsecomplete',async()=>{const f=runOptions({reduce:()=>({status:'FAIL'})});await assert.rejects(executeMatched({},f.options),/MATCHED_REPLAY/);});
await check('guard failure halts fixed work without relaxation',async()=>{let guards=0;const f=runOptions({guard:()=>{if(++guards===6)throw Error('controlleddeadline');}});await assert.rejects(executeMatched({},f.options),/controlleddeadline/);assert.equal(f.rows.length,5);});
await check('unchangedresource profile plusoneparentreadonlymount andprospective60min',()=>{const host=fs.readFileSync('.artifacts/p05-privacy-matched-host01.mjs','utf8');for(const text of ["'--memory','1536m'","'--memory-swap','1536m'","'--cpus','1'","'--network','none'","'--read-only'","'--user','1000:1000'",'target=/run/p05-pilot-corpus-ranges02,readonly','],3605000)',"if(report.export_verified)ok(['rm',name])"])assert(host.includes(text),text);assert(!host.includes('1205000'));assert(!host.includes('PILOT_FIXED_RANGE_02'));assert.equal(JSON.parse(preregRaw).worker_ms,3600000);});
console.log(JSON.stringify({status:'PASS_FINITE_FAKE_OPERATIONAL_ONLY_NO_NATIVE_OR_DOCKER',checks:checks.length,checks_detail:checks,native_runs:0,Docker_runs:0,root_authorized:false}));
