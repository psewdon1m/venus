/** Bounded actual Windows job test: starts/stops only this test's owned tree. */
import assert from 'node:assert/strict';
import {mkdtempSync,writeFileSync,rmSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join,resolve,sep} from 'node:path';
import {randomBytes} from 'node:crypto';
import {setTimeout as delay} from 'node:timers/promises';
import {launchOwnedWorker,verifyOwnedJob} from './owned-worker.mjs';
assert.equal(process.platform,'win32');const directory=mkdtempSync(join(tmpdir(),'venus-stats03-owned-stop-')),target=join(directory,'owned-test-child.mjs'),python=resolve('.venv/Scripts/python.exe'),results=[];
writeFileSync(target,"import{spawn}from'node:child_process';export async function main(){const child=spawn(process.execPath,['-e','setInterval(()=>{},1000)'],{stdio:'ignore',windowsHide:true});console.log(JSON.stringify({kind:'OWNED_TEST_DESCENDANT',pid:child.pid}));setInterval(()=>{},1000);}\n",{flag:'wx'});
try{for(const mode of ['normal-tree-stop','manager-crash-job-close-fallback']){const owner=randomBytes(16).toString('hex'),logs=[];let controller=null,stopped=false;const started=Date.now();try{controller=launchOwnedWorker({python,node:process.execPath,owner,target,argument:'OWNED_SYNTHETIC_STOP_TEST',onStderr:b=>{logs.push(b.toString());assert(logs.join('').length<65536);}});const ready=await controller.started;let observed;const until=Date.now()+4000;while(Date.now()<until){observed=await verifyOwnedJob(python,owner);if(observed.active_processes>=2)break;await delay(50);}assert(observed.active_processes>=2,'ACTUAL_DESCENDANT_NOT_IN_OWNED_JOB');if(mode==='manager-crash-job-close-fallback')controller.manager.kill();const terminal=await controller.stop();stopped=true;assert.equal(terminal.active_processes,0);const final=await verifyOwnedJob(python,owner);assert.equal(final.active_processes,0);assert.equal(final.job_destroyed,true);if(mode==='manager-crash-job-close-fallback')assert.equal(terminal.status,'STOP_CONFIRMED_WITH_MANAGER_FAILURE');results.push({mode,owner,manager_pid:controller.manager.pid,worker_pid:ready.worker_pid,descendant_seen_in_job:observed.active_processes,terminal,final,elapsed_ms:Date.now()-started,logs:logs.join('')});}finally{if(controller&&!stopped)await controller.stop();}}}finally{assert(resolve(directory).startsWith(resolve(tmpdir())+sep));rmSync(directory,{recursive:true,force:true});}
console.log(JSON.stringify({status:'PASS_ACTUAL_OWNED_WINDOWS_JOB_STOP_ONLY',count:results.length,results,taskkill_calls:0,Docker_calls:0,actual_PG_sessions:0,statistics_RUN:false},null,2));
