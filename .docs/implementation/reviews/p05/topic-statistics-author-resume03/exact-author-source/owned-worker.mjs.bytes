/** Source-bound job controller. No arbitrary PID/taskkill API is exposed. */
import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {dirname,join,isAbsolute} from 'node:path';
import {fileURLToPath} from 'node:url';
import {setTimeout,clearTimeout} from 'node:timers';
const here=dirname(fileURLToPath(import.meta.url));
export const waitBounded=(promise,ms,label)=>new Promise((done,reject)=>{const timer=setTimeout(()=>reject(Error(label)),ms);promise.then(v=>{clearTimeout(timer);done(v);},e=>{clearTimeout(timer);reject(e);});});
export async function verifyOwnedJob(python,owner){assert(/^[a-f0-9]{32}$/.test(owner));const child=spawn(python,['-B',join(here,'owned-job.py'),'--owner',owner,'--verify'],{windowsHide:true}),chunks=[];let size=0;const result=new Promise((done,reject)=>{child.stdout.on('data',b=>{size+=b.length;if(size>4096){child.kill();reject(Error('JOB_VERIFY_CAPTURE_CAP'));}else chunks.push(b);});child.stderr.resume();child.on('error',reject);child.on('close',code=>{try{assert.equal(code,0);const row=JSON.parse(Buffer.concat(chunks));assert.equal(row.owner,owner);assert.equal(row.kind,'VERIFY');assert(Number.isSafeInteger(row.active_processes)&&row.active_processes>=0);done(row);}catch(e){reject(e);}});});try{return await waitBounded(result,2000,'JOB_VERIFY_TIMEOUT');}catch(e){child.kill();throw e;}}
export function launchOwnedWorker({python,node,owner,target,argument,onStderr=()=>{}}){
 assert.equal(process.platform,'win32','WINDOWS_OWNED_JOB_REQUIRED');assert(/^[a-f0-9]{32}$/.test(owner));for(const p of [python,node,target])assert(isAbsolute(p));
 const manager=spawn(python,['-B',join(here,'owned-job.py'),'--owner',owner,'--node',node,'--target',target,'--argument',argument],{windowsHide:true,stdio:['pipe','pipe','pipe']});let pending='',terminal=null,ready=null,stopSent=false,error=null;const errors=[];let readyDone,readyReject,finishDone;const started=new Promise((done,reject)=>{readyDone=done;readyReject=reject;}),finished=new Promise(done=>finishDone=done);
 manager.stdout.on('data',chunk=>{try{pending+=chunk.toString();assert(pending.length<=65536,'JOB_PROTOCOL_CAP');let i;while((i=pending.indexOf('\n'))>=0){const row=JSON.parse(pending.slice(0,i));pending=pending.slice(i+1);assert.equal(row.owner,owner);if(row.kind==='READY'){assert(!ready);assert(Number.isSafeInteger(row.worker_pid)&&row.worker_pid>0);assert.equal(row.job,'Local\\VenusStats32.'+owner);assert.equal(row.job_flags,0x2008);ready=row;readyDone(row);}else if(row.kind==='TERMINAL'){assert(!terminal);terminal=row;}else throw Error('JOB_PROTOCOL_KIND');}}catch(e){error??=e;errors.push(e.message);readyReject(e);manager.stdin.end();}});
 manager.stderr.on('data',onStderr);manager.on('error',e=>{error??=e;readyReject(e);});manager.on('close',code=>{if(!ready)readyReject(error??Error('JOB_MANAGER_CLOSED_BEFORE_READY'));finishDone({code,terminal,error,errors});});manager.stdin.on('error',e=>{errors.push(e.message);});
 let stopping=null;const controller={owner,manager,started:waitBounded(started,5000,'JOB_START_TIMEOUT'),finished,get ready(){return ready;},stop(){if(stopping)return stopping;stopping=(async()=>{if(!stopSent){stopSent=true;manager.stdin.end('STOP:'+owner+'\n');}try{return confirmStop(await waitBounded(finished,8000,'OWNED_STOP_TIMEOUT'),owner);}catch(first){errors.push(first.message);manager.kill();await waitBounded(finished,3000,'OWNED_MANAGER_CLOSE_TIMEOUT');assert(ready,'STOP_FAILED_BEFORE_OWNERSHIP_READY');const until=Date.now()+3000;while(Date.now()<until){const row=await verifyOwnedJob(python,owner);if(row.active_processes===0)return{kind:'TERMINAL',owner,status:'STOP_CONFIRMED_WITH_MANAGER_FAILURE',active_processes:0,errors:[...errors],first_stop_failure:first.message};await new Promise(r=>setTimeout(r,25));}throw new Error('STOP_FAILED_WORKER_UNCONFIRMED',{cause:first});}})().catch(error=>{manager.stdin.destroy();manager.stdout.destroy();manager.stderr.destroy();manager.unref();throw error;});return stopping;}};controller.started.catch(()=>{});return controller;
}
export function confirmStop(result,owner){assert(result&&result.code===0,'OWNED_MANAGER_NONZERO');assert.equal(result.error,null,'JOB_PROTOCOL_ERROR');const t=result.terminal;assert(t&&t.owner===owner,'OWNED_STOP_NO_TERMINAL');assert(['STOP_CONFIRMED','EXIT_CONFIRMED'].includes(t.status),'OWNED_STOP_FAILED');assert.equal(t.active_processes,0,'OWNED_DESCENDANTS_UNCONFIRMED');assert(!t.worker_unconfirmed);return t;}
