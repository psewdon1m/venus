/** Actual PG + HTTP mutations, paired with the reviewed memory mutators.
 * Caller owns isolated PG, app, actors, fixed fixture seed and real WS sockets.
 * No SQL INSERT/update grants and no replacement safety/authorization provider.
 */
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {DomainError} from '../../apps/api/dist/security.js';
import {MemorySession} from '../p05-topic-measurements-method06/memory-session.mjs';
import {pairNormalization} from './pair-normalization.mjs';
export async function actualSession(h,f,descriptor,{onRaw,guard}){
 assert.equal(typeof onRaw,'function');assert.equal(typeof guard,'function');const g=await h.current(f),snapshot=await h.topics.snapshot(h.pool,g,h.source.pack,h.source.map),history=await h.topics.history(h.pool,g,snapshot,h.source.pack,h.source.map),safety=await h.preferences.readForPlanner(h.pool,f.room,snapshot.baseline.players.map(p=>p.id));
 const members=(await h.pool.query('SELECT * FROM room_members WHERE room_id=$1 ORDER BY slot',[f.room])).rows,room=(await h.pool.query('SELECT * FROM rooms WHERE id=$1',[f.room])).rows[0],model=new MemorySession(h.source,descriptor,{snapshot,history:structuredClone(history),safety:structuredClone(safety),names:members,roomRevision:Number(room.rev)});
 // Actual history already includes the selected first round. Reconstruct its
 // exact preselection history by caller-provided captured start input, never
 // delete/update the actual PG history or infer it from selected outcomes.
 assert(f.preStartHistory,'ACTUAL_PRESTART_HISTORY_CAPTURE_REQUIRED');model.history=structuredClone(f.preStartHistory);model.now=h.time();await model.initialize();
 const ids=snapshot.baseline.players.map(p=>p.id),normal=pairNormalization(ids);let currentLabel='start';const actor=id=>{const a=f.members.find(x=>x.id===id);assert(a,'ACTOR_NOT_AUTHENTICATED');return a;};
 const session={f:h.source,descriptor,snapshot,history,g,room,now:h.time(),hostMemberId:f.host.id,model,normal,async refresh(){session.g=await h.current(f);session.room=(await h.pool.query('SELECT * FROM rooms WHERE id=$1',[f.room])).rows[0];session.history=await h.topics.history(h.pool,session.g,snapshot,h.source.pack,h.source.map);},async current(){await session.refresh();if(!f.plan)return null;const row=(await h.pool.query('SELECT * FROM game_rounds WHERE session_id=$1 AND round_index=$2',[f.game,session.g.current_round])).rows[0];normal.equal(f.data.plan,(await model.current()).data.plan);return{row,data:f.data};},async target(id){const r=await h.call(actor(id),h.round(f)+'/target');assert.equal(r.status,200);const v=await model.target(id);normal.equal(r.body,v);onRaw({kind:'actual-private-target',actor:id,label:currentLabel,status:r.status,raw:r.raw});return r.body;},async conversation(id){const r=await h.call(actor(id),h.round(f)+'/conversation');let value,error;try{value=await model.conversation(id);}catch(e){error=e;}onRaw({kind:'actual-private-conversation',actor:id,label:currentLabel,status:r.status,raw:r.raw});if(r.status>=400){assert(error instanceof DomainError);assert.equal(r.status,error.statusCode);assert.equal(r.body.code,error.code);throw error;}assert(!error);normal.equal(r.body,value);return r.body;},async conversationState(){const c=await h.pool.connect();try{const l=await h.topics.loaded(c,f.room,f.game),value=await h.topics.conversation(c,l);normal.equal(value,await model.conversationState());return value;}finally{c.release();}},async chat(id){const r=await h.call(actor(id),h.round(f)+'/conversation/chat');let value,error;try{value=await model.chat(id);}catch(e){error=e;}onRaw({kind:'actual-private-chat',actor:id,label:currentLabel,status:r.status,raw:r.raw});if(r.status>=400){assert(error instanceof DomainError);assert.equal(r.status,error.statusCode);assert.equal(r.body.code,error.code);throw error;}assert(!error);normal.equal(r.body,value);return r.body;},async mutate(kind,id,input){guard();const routes={conversationCommand:'conversation/commands',sendChat:'conversation/chat'},path=kind==='advance'?h.base(f)+`/${f.game}/round/advance`:h.round(f)+'/'+(routes[kind]??kind);let expected,error;try{expected=await model.mutate(kind,id,normal.translate(input));}catch(e){error=e;}const r=await h.call(actor(id),path,'POST',{request_id:randomUUID(),...input});onRaw({kind:'actual-HTTP-command',actor:id,operation:kind,status:r.status,raw:r.raw});if(error){assert(error instanceof DomainError);assert.equal(r.status,error.statusCode);assert.equal(r.body.code,error.code);throw error;}assert.equal(r.status,200,JSON.stringify({kind,code:r.body.code,status:r.status}));normal.equal(r.body,expected);await session.refresh();assert.equal(Number(session.g.rev),Number(model.g.rev));assert.equal(Number(session.room.rev),Number(model.room.rev));return r.body;},async stepClock(ms){guard();h.tick(ms);model.stepClock(ms);session.now=h.time();assert.equal(session.now,model.now);},setLabel(label){currentLabel=label;}};
 await session.current();return session;
}
