/** Explicit new32GiB adaptation, not a widened METHOD07/OCI consumer. */
import assert from 'node:assert/strict';
import {readFileSync,lstatSync} from 'node:fs';
import {performance} from 'node:perf_hooks';
export const limits=Object.freeze({global:32*1024**3,payload:15*1024**3,archive:15*1024**3,inputs:256*1024**2,control:64*1024**2,native:512*1024**2,active:32*1024**2,safety:1184*1024**2,reserve:10*1024**3});
assert.equal(limits.payload+limits.archive+limits.inputs+limits.control+limits.native+limits.active+limits.safety,limits.global);
export function validateResourcePlan(p){assert(p&&p.schema===1&&p.profile==='P05_STATS32_EXTERNAL_1');assert(/^[a-f0-9]{32}$/.test(p.owner));assert(/^venus-stats32-[a-f0-9]{12}$/.test(p.project));assert(/^sha256:[a-f0-9]{64}$/.test(p.image));assert.deepEqual(p.limits,limits);assert(Number.isSafeInteger(p.total_wall_ms)&&p.total_wall_ms>0);for(const k of ['C2','invariants','fairness','gf','social','exclusion','runtime_canary'])assert(Number.isSafeInteger(p.section_wall_ms[k])&&p.section_wall_ms[k]>0&&p.section_wall_ms[k]<=p.total_wall_ms);return true;}
export function resourceLease(file,owner){let last=0,received=0;return function guard(next=0){assert(Number.isSafeInteger(next)&&next>=0&&next<=32*1024**2);assert(lstatSync(file).isFile()&&!lstatSync(file).isSymbolicLink());const row=JSON.parse(readFileSync(file));assert.equal(row.owner,owner);assert.equal(row.stop_requested,false);assert(Number.isSafeInteger(row.counter)&&row.counter>=last);if(row.counter>last){last=row.counter;received=performance.now();}assert(received>0&&performance.now()-received<2000,'STATS32_EXTERNAL_GUARD_STALE');assert.equal(row.global_cap_bytes,limits.global);assert(BigInt(row.actual_host_free_bytes)>=BigInt(limits.reserve+limits.global));assert(BigInt(row.actual_native_free_bytes)>=BigInt(limits.reserve+limits.global));assert(Number.isSafeInteger(row.host_payload_allocated_bytes)&&row.host_payload_allocated_bytes>=0);assert(row.host_payload_allocated_bytes+next+1048576<limits.payload);return row;};}
