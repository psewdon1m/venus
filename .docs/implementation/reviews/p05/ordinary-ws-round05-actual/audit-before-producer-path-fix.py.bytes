from pathlib import Path
import json,hashlib,zipfile,subprocess,sys,datetime
sys.path.insert(0,'tools')
from stage_inventory import inventory,identity
root=Path.cwd();p=root/'.docs/implementation/evidence/p05/ordinary-ws-preflight-03';out=root/'.docs/implementation/reviews/p05/ordinary-ws-round05-actual'
expected='895fb30bb371397e7fbffa539ad1ae1c44c25630905bedb175867c3500a36a04';image='sha256:9c4ac16f7f68663f7e4851490641753f0abd9a102240f3ac302a132e94e8e38e'
def j(path):return json.loads(Path(path).read_text(encoding='utf-8'))
raw=(p/'index.json').read_bytes();assert hashlib.sha256(raw).hexdigest()=='080b2ea965985e26fc92bbca4c121bf4d49cc087d4cc9afb2705d90f8973aaad';idx=json.loads(raw);assert len(idx['files'])==38
for row in idx['files']:
 b=(p/row['path']).read_bytes();assert len(b)==row['bytes'] and hashlib.sha256(b).hexdigest()==row['sha256'],row['path']
assert idx['source_identity']==expected and idx['included_files']==1808 and idx['handle']==42386 and idx['exit_code']==0 and idx['checks_pass']==10 and idx['cleanup']=='completed'
before=j(p/'run/inputs-before.json');after=j(p/'run/inputs-after.json');current=inventory();assert before==after and before['files']==current and len(current)==1808 and identity(current)==before['identity']==expected
assert (p/'run/producer-pins-before.json').read_bytes()==(p/'run/producer-pins-after.json').read_bytes();pp=j(p/'run/producer-pins-before.json');producer={Path(k).name:v for k,v in pp.items()};assert producer=={n:hashlib.sha256((p/'producer'/n).read_bytes()).hexdigest() for n in ['integration.mjs','runner.mjs','observation.mjs']}
zpath=(p/idx['source_archive']).resolve();assert hashlib.sha256(zpath.read_bytes()).hexdigest()==idx['source_archive_sha256']=='9627fb299dbb42feae8955bb765140acdaf168054c159cae7c87a599f6a23a5b'
with zipfile.ZipFile(zpath) as z:
 assert len(z.namelist())==len(set(z.namelist()))==1808 and set(z.namelist())==set(current)
 for name,sha in current.items():assert hashlib.sha256(z.read(name)).hexdigest()==sha,name
 for name in ['apps/api/src/rooms.ts','apps/api/src/room-routes.ts','apps/api/src/topic-games.ts','apps/api/src/room-games.ts','apps/api/src/topic-content-availability.ts','tests/p05-topic-lifecycle/harness.mjs']:
  dest=out/'exact-source'/(name+'.bytes');dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(z.read(name))
report=j(p/'run/ordinary-ws-report.json');assert report['status']=='PASS' and len(report['checks'])==10;checks={c['id']:c for c in report['checks']};assert len(checks)==10 and set(checks)=={'P05-OWS-'+str(i).zfill(2) for i in range(1,11)} and all(c['status']=='PASS' for c in checks.values())
assert report['runtime_cleanup']=='completed' and report['actual_ordinary_registerRooms_ws'] and report['actual_postgresql_http_protected_lifecycle'] and report['synthetic_source_only'] and report['browser_cookie_jar_proof'] is False and report['production_server_cmd'] is False and report['full_p05_pass'] is False
for n in ['05','06','09']:
 d=checks['P05-OWS-'+n]['detail'];assert d['observation_started_before_transition'] and d['actual_enqueue_boundary_observed'] and d['full_payload_sha_and_exact_acl_headers'] and d['distinct_enqueue_per_received_frame'];assert d['raw_unknown_private_frames']==d['forbidden_post_boundary_private_callbacks']==0;assert d['baseline_private_frames_consumed']>0;assert d['received_full_window_private_frames']==d['received_known_pre_boundary_queued_frames']+d['received_fresh_pending_frames']
for n in ['05','06']:assert checks['P05-OWS-'+n]['detail']['post_boundary_private_callbacks']==0
nine=checks['P05-OWS-09']['detail'];assert nine['post_boundary_private_callbacks']==nine['received_full_window_private_frames']==nine['received_fresh_pending_frames']>0 and nine['received_known_pre_boundary_queued_frames']==0;assert nine['old_refs_enqueued']==0 and nine['successful_durable_narrow_observed'] and nine['epoch_revoked'] and nine['protected_ledger_exclusion'] and nine['grant_observed_from_actual_ws_pg_generation']
ten=checks['P05-OWS-10']['detail'];assert ten['matched'] and ten['actual_pg_lock_wait'] and ten['actual_ordinary_privateDelivery_selected'] and ten['source_outage_during_final_credential_await'] and ten['no_private_after_wait'] and ten['ordinary_room_ws_survived'];assert ten['specific_child_assertion_attribution'] is False and ten['direct_dispatch_race_adjunct'] is False
assert checks['P05-OWS-01']['detail']['explicit18_v2_http'] and checks['P05-OWS-01']['detail']['actual_members']==3 and checks['P05-OWS-01']['detail']['real_ws_admission_presence'];assert checks['P05-OWS-02']['detail']['spectator_private_frames']==0 and checks['P05-OWS-04']['detail']['spectator_private_frames']==0 and checks['P05-OWS-04']['detail']['shared_private_round_generic'];assert checks['P05-OWS-07']['detail']['ordinary_ws_close_code']==4401 and checks['P05-OWS-08']['detail']['ordinary_ws_closed']==4401
runner=j(p/'run/runner.json');assert runner['image']==idx['image']==image and runner['cleanup']=='completed' and runner['status']=='PASS';assert all(not v for v in j(p/'run/resources-after-cleanup.json').values());img=j(p/'run/image-inspect.json')[0];fresh=json.loads(subprocess.check_output(['docker','image','inspect',image],text=True))[0];assert img['Id']==fresh['Id']==image and img['Config']==fresh['Config']
compose=j(p/'run/compose.json');api=compose['services']['api'];assert api['image']==image and api['read_only'] and api['user']=='1000:1000' and api['mem_limit']=='768m' and api['cpus']==1 and compose['networks']['isolated']['internal'] and api['cap_drop']==['ALL'];assert 'NODE_OPTIONS' not in api['environment'];assert api['command']==['node','tests/p05-topic-lifecycle/ordinary-ws-integration.mjs'];assert {v['target'] for v in api['volumes']}=={'/artifacts','/app/tests/p05-topic-lifecycle/ordinary-ws-integration.mjs','/app/tests/p05-topic-lifecycle/ordinary-ws-observation.mjs'}
project=runner['project'];assert project=='venus-ordinary-ws-ec0002629d60';freshresources={}
for kind,args in [('containers',['ps','-aq']),('networks',['network','ls','-q']),('volumes',['volume','ls','-q'])]:
 for item in j(p/f'run/cleanup-{kind}-inspect.json'):assert (item.get('Config',{}).get('Labels') or item.get('Labels'))['com.docker.compose.project']==project
 resources=subprocess.check_output(['docker',*args,'--filter','label=com.docker.compose.project='+project],text=True).split();assert not resources;freshresources[kind]=resources
secrets={}
for name,v in compose['secrets'].items():
 path=Path(v['file']);assert not path.exists() and not path.parent.exists();secrets[name]={'file_exists':False,'parent_exists':False}
imageinputs={n:sha for n,sha in current.items() if n.startswith(('apps/','packages/','tests/')) or n in ['package.json','package-lock.json','.npmrc','tsconfig.json','tsconfig.base.json']};(out/'frozen-image-inputs.json').write_text(json.dumps(imageinputs,indent=2)+'\n',encoding='utf-8')
result={'schema_version':1,'status':'EVIDENCE_PIN_AND_WINDOW_AUDIT_PASS_OBSERVER_PROBES_PENDING','source_identity':expected,'included_inputs':1808,'index_sha256':hashlib.sha256(raw).hexdigest(),'indexed_artifacts_verified':38,'source_archive_sha256':idx['source_archive_sha256'],'image':image,'root_handle':42386,'root_exit_code':0,'producer_pins':producer,'same_before_after':True,'checks_pass':10,'window_metrics':{n:checks['P05-OWS-'+n]['detail'] for n in ['05','06','09','10']},'fresh_owned_cleanup':freshresources,'secret_temp_absent':secrets,'image_input_count':len(imageinputs),'functional_docker_reruns':0,'no_full_p05':True,'scope':'Fresh ordinary registerRooms WS/realPG/protected lifecycle with syntheticcontent; not productionCMD/browser/restore/chat12','postcleanup_diagnostic':'Root separate PG diagnostic saw servicealreadyremoved; no restart/no data proof claimed'}
(out/'evidence-audit.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8');(out/'current-inventory.json').write_text(json.dumps({'identity':expected,'files':current},indent=2)+'\n',encoding='utf-8');print(json.dumps({'indexed':38,'source_entries':1808,'cases':10,'image_inputs':len(imageinputs),'windows':{n:checks['P05-OWS-'+n]['detail']['post_boundary_private_callbacks'] for n in ['05','06','09']},'cleanup':freshresources}))
