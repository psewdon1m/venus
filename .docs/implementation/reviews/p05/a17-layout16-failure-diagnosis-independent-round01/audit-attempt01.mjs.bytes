import assert from 'node:assert/strict';
import {readFileSync,readdirSync,lstatSync,writeFileSync,existsSync} from 'node:fs';
import {join,dirname,relative} from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root='C:/.projects/venus',out=fileURLToPath(new URL('.',import.meta.url)),source=join(root,'.artifacts/p05-pilot-bundle-source14'),run=join(source,'.artifacts/p05/venus-v2-layout-2869c29ddbd2'),producer=join(source,'.artifacts/p05-v2-layout-producer-resume16'),pins={};
const hash=b=>createHash('sha256').update(b).digest('hex'),read=p=>JSON.parse(readFileSync(p,'utf8'));
function pin(p){const b=readFileSync(p),v={bytes:b.length,sha256:hash(b)};pins[relative(root,p).replaceAll('\\','/')]=v;return v;}
const canon=v=>v&&typeof v==='object'&&!Array.isArray(v)?Object.fromEntries(Object.entries(v).sort(([a],[b])=>a<b?-1:a>b?1:0).map(([k,x])=>[k,canon(x)])):Array.isArray(v)?v.map(canon):v,same=(a,b,label)=>assert.deepEqual(canon(a),canon(b),label);
for(const name of ['layout-report.json','runner.json','fixture-diff.json','browser-tests.txt','compose-cleanup.txt','inputs-before.json','inputs-after.json','producer-before.json','harness-original.mjs','harness-derivative.mjs','image-id.txt','remaining-containers.txt','remaining-networks.txt','remaining-volumes.txt','chromium-ru-entry-w320-entry.png'])pin(join(run,name));
const ackPath=join(root,'.artifacts/p05-layout16-a17-root-ack01.json');assert.equal(pin(ackPath).sha256,'defc6c4ffd38690473349b3501a2cf5f24f87bddb88c34fd8073f1203fb0c1a9');const ack=read(ackPath);assert.equal(ack.root_run_ack,true);same(read(join(producer,'ROOT_RUN_ACK.json')),ack);pin(join(producer,'ROOT_RUN_ACK.json'));
const reviewPath=join(source,ack.independent_review_path);assert.equal(pin(reviewPath).sha256,'aa4bcb3daa8e0430ca0a4fa1e02493a6c4a658a966b2b14a6d1c3484fcf4b77a');const review=read(reviewPath);assert.equal(review.source_identity,ack.source_identity);assert.equal(review.producer_runtime_digest,ack.producer_runtime_digest);assert(['PASS_METHOD_ONLY','PASS_LAYOUT_PRODUCER_METHOD_ONLY'].includes(review.status));
const oldMap=read(join(run,'producer-before.json')),currentMap={};for(const name of readdirSync(producer).sort()){const path=join(producer,name),s=lstatSync(path);assert(!s.isSymbolicLink());if(s.isFile())currentMap[name]={type:'file',sha256:pin(path).sha256,bytes:s.size};else currentMap[name]={type:'historical_or_extraction_directory'};}same(currentMap,oldMap,'producer top-level exact actual-before');
const runtime=Object.fromEntries(Object.entries(oldMap).filter(([name])=>name.endsWith('.mjs')||name==='binding.json'||name==='DESIGN.md'));assert.equal(hash(JSON.stringify(runtime)),ack.producer_runtime_digest);assert.equal(ack.producer_runtime_digest,'4a18ef21bef61e66765e998ca04eb46efff22083e22bc62efda684e08aee82c8');
let copied=0;for(const name of readdirSync(join(run,'producer'))){const path=join(run,'producer',name);if(lstatSync(path).isFile()&&oldMap[name]?.type==='file'){const actual=pin(path);assert.equal(actual.sha256,oldMap[name].sha256,name);assert.equal(actual.bytes,oldMap[name].bytes,name);copied++;}}
const before=read(join(run,'inputs-before.json')),after=read(join(run,'inputs-after.json'));same(before,after);assert.equal(before.source_identity,'93221ba482331e3916e56f2e1866b5c7743fa72ad29320f2819a7a6fd1a2951d');assert.equal(Object.keys(before.files).length,1871);
const freezePath=join(root,'.artifacts/p05-pilot-bundle-source-freeze14.json');pin(freezePath);const freeze=read(freezePath);same(before.files,freeze.files);for(const [name,h]of Object.entries(freeze.files))assert.equal(pin(join(source,name)).sha256,h,name);
const report=read(join(run,'layout-report.json')),runner=read(join(run,'runner.json')),exitPath=join(root,'.artifacts/p05-layout16-a17-chromium-ru01.exit.json'),stdoutPath=join(root,'.artifacts/p05-layout16-a17-chromium-ru01.txt');pin(exitPath);pin(stdoutPath);const exit=read(exitPath),stdout=read(stdoutPath);assert.equal(exit.exit_code,1);assert.equal(stdout.status,'FAIL');assert.equal(report.status,'FAIL');assert.equal(runner.status,'FAIL');for(const object of [stdout,report,runner])assert.equal(object.cleanup,'PASS');assert.equal(runner.source_identity,before.source_identity);assert.equal(runner.image,ack.image);assert.equal(runner.producer_runtime_digest,ack.producer_runtime_digest);
const counts={PASS:0,FAIL:0,NOT_RUN:0};for(const row of report.records)counts[row.status]++;same(counts,{PASS:0,FAIL:1,NOT_RUN:50});assert.equal(report.records.length,51);assert.equal(report.records[0].id,'chromium/ru/entry/w320');assert.equal(report.real_text_observations.length,1);assert.equal(report.page_errors.length,0);assert.equal(report.keyboard_actions.length,0);
const observation=report.real_text_observations[0],geometry=observation.geometry;assert.equal(observation.id,'Q-1168/ru/question');assert.equal(observation.card_revision,2);assert.equal(observation.surface,'private');assert.equal(observation.scope,'PRESENTATION_ONLY_OWNER_R4_NOT_AUTH_API_CONSENT');assert.equal(observation.status,'FAIL');assert.equal(observation.cleanup,'PASS');assert.equal(geometry.width,320);assert.equal(geometry.height,568);assert.equal(geometry.dpr,1);assert.equal(geometry.css_zoom,'1');assert.equal(geometry.bottom_reachable,false);assert.equal(geometry.last_line_bottom,2672.265625);assert.equal(geometry.scroll_top,20);assert.equal(geometry.clipped,false);assert.equal(geometry.document_scroll_width,geometry.document_client_width);assert.equal(observation.audit.horizontal_overflow,false);assert.equal(observation.audit.contrast_failures,0);assert.equal(observation.audit.contrast_unresolved,0);
const fixturePath=join(producer,'real-text-fixture.json');assert.equal(pin(fixturePath).sha256,observation.fixture_sha256);const row=read(fixturePath).rows.find(r=>r.id===observation.id);assert(row);assert.equal(row.card_id,observation.card_id);assert.equal(row.card_revision,2);assert.equal(row.field_sha256,observation.raw_sha256);same(row.rendered_parts_sha256,observation.rendered_parts_sha256);assert.equal(row.rendered_parts[0].length,275);
const text=readFileSync(join(producer,'real-text-probe.mjs'),'utf8'),needle='assert.equal(value.bottom_reachable,true)',index=text.indexOf(needle),prefix=text.slice(0,index).split('\n');assert.equal(prefix.length,29);assert.equal(prefix.at(-1).length+1,114);same(report.failure,{name:'AssertionError',code:'ASSERTION_OR_OPERATION_FAILED',source_module:'real-text-probe',source_line:29,source_column:114});
assert(text.includes("bottom_reachable:rect.bottom>0&&rect.bottom<=window.innerHeight+2"));assert(text.includes("await bounded(budget,'text-physical-scroll-end',()=>page.keyboard.press('Control+End'));"));assert(!text.includes('waitForFunction'));assert(!text.includes('requestAnimationFrame'));assert(!text.includes('scrollHeight'));assert(!text.includes('activeElement'));
const role=report.records[0].roles[0];assert.equal(role.contrast_failures,0);assert.equal(role.contrast_unresolved,0);assert.equal(role.keyboard_reached,true);assert.equal(role.focus_in_viewport,true);assert.equal(role.focus_visible,true);assert.equal(role.keyboard.controls.length,5);assert.equal(report.screenshots.count,1);assert.equal(report.screenshots.bytes,pin(join(run,role.evidence_file)).bytes);assert(!report.failure_screenshot);
const diff=read(join(run,'fixture-diff.json'));assert.equal(pin(join(run,'harness-original.mjs')).sha256,diff.original_sha256);assert.equal(pin(join(run,'harness-derivative.mjs')).sha256,diff.derivative_sha256);assert.equal(diff.exact_semantic_replacements.length,2);assert.equal(diff.synthetic_source_only,true);assert.equal(report.synthetic_fixture_only,true);
for(const name of ['remaining-containers.txt','remaining-networks.txt','remaining-volumes.txt'])assert.equal(readFileSync(join(run,name),'utf8').trim(),'');const cleanup=readFileSync(join(run,'compose-cleanup.txt'),'utf8');assert(cleanup.includes('db-1  Removed')&&cleanup.includes('_postgres-data  Removed')&&cleanup.includes('_isolated  Removed'));
const result={status:'ACTUAL_FAIL_RETAINED_FOCUSED_DIAGNOSIS_COMPLETE',source_identity:before.source_identity,image:ack.image,ACK_sha256:pin(ackPath).sha256,method_review_sha256:pin(reviewPath).sha256,producer_runtime_digest:ack.producer_runtime_digest,source_count:1871,copied_producer_files_checked:copied,counts,cleanup:'PASS_SAVED_OWNED_EMPTY',exact_failure:'real-text-probe.mjs:29:114 bottom_reachable current viewport assertion',typed_scope:observation.scope,observed_geometry:geometry,entry_control_checks:{contrast_failures:0,contrast_unresolved:0,keyboard_controls:5,focus_in_viewport:true},single_geometry_sample_without_settlement:true,APP_clipping_defect_established:false,browser_scroll_delivery_focus_or_settlement_mechanism:'UNKNOWN_NOT_RECORDED',native_operations:0};writeFileSync(join(out,'INPUT_PINS.json'),JSON.stringify(pins,null,2)+'\n');writeFileSync(join(out,'CHECKS.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
