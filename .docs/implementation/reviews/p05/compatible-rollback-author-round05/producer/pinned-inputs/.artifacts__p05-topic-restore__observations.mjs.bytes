/** AUTHOR read-only restore observations. Raw private rows stay only in API tmpfs. */
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {lstatSync,readdirSync,readFileSync} from 'node:fs';
import {join} from 'node:path';
import {timers} from '../../apps/api/dist/rooms.js';
import {topicAad,loadTopicObject} from '../../apps/api/dist/topic-game-model.js';
export const rootNames=['birthDirectory','personalChainDirectory','personalWitnessDirectory','lifecycleChainDirectory','lifecycleWitnessDirectory'];
export const canonical=value=>JSON.stringify(value,(_key,item)=>item&&typeof item==='object'&&!Array.isArray(item)?Object.fromEntries(Object.entries(item).sort(([a],[b])=>a.localeCompare(b))):item);
export const sha=value=>createHash('sha256').update(typeof value==='string'||Buffer.isBuffer(value)?value:canonical(value)).digest('hex');
export function authorityMap(directory){
 const map={};function walk(relative){const path=join(directory,relative),s=lstatSync(path);assert(!s.isSymbolicLink(),'Authority inventory refuses symlinks');assert(s.isDirectory()||s.isFile());map[relative]={kind:s.isDirectory()?'directory':'file',mode:s.mode&0o777,device:s.dev,inode:s.ino,...(s.isFile()?{bytes:s.size,sha256:sha(readFileSync(path))}:{})};if(s.isDirectory())for(const child of readdirSync(path).sort())walk(relative+'/'+child);}
 for(const name of [...rootNames,'deletions'])walk(name);return map;
}
export function roomAuthority(map,room){return Object.fromEntries(Object.entries(map).filter(([name])=>name.split('/')[1]===room));}
const quote=name=>'"'+name.replaceAll('"','""')+'"';
export async function rawDatabase(pool){
 const tables=(await pool.query("SELECT schemaname,tablename FROM pg_tables WHERE schemaname NOT IN ('pg_catalog','information_schema') ORDER BY schemaname,tablename")).rows,rows={},summary=[];
 for(const table of tables){const name=table.schemaname+'.'+table.tablename,values=(await pool.query('SELECT to_jsonb(t) AS row FROM '+quote(table.schemaname)+'.'+quote(table.tablename)+' t')).rows.map(v=>canonical(v.row)).sort();rows[name]=values;summary.push({table:name,count:values.length,sha256:sha(values)});}
 const definitions=(await pool.query("SELECT schemaname,sequencename,sequenceowner,data_type::text AS data_type,start_value,min_value,max_value,increment_by,cycle,cache_size,last_value AS catalog_last_value FROM pg_sequences WHERE schemaname NOT IN ('pg_catalog','information_schema') ORDER BY schemaname,sequencename")).rows,sequences=[];
 for(const definition of definitions){const result=await pool.query('SELECT last_value,is_called FROM '+quote(definition.schemaname)+'.'+quote(definition.sequencename));assert.equal(result.rows.length,1);const state=result.rows[0];assert(typeof state.is_called==='boolean');assert(typeof state.last_value==='string'&&/^-?\d+$/.test(state.last_value)||Number.isSafeInteger(state.last_value));sequences.push({definition,relation_state:{last_value:state.last_value,is_called:state.is_called}});}
 return {privateRows:rows,privateSequences:sequences,summary,sequences_sha256:sha(sequences),comparison_scope:'Every ordinary user table row plus full pg_sequences definition/catalog values and direct relation last_value/is_called; excludes global role objects/OIDs/physical system metadata'};
}
export function assertRestored(before,after){assert.deepEqual(after.privateRows,before.privateRows,'Every original raw user row must really be restored');assert.deepEqual(after.privateSequences,before.privateSequences);return {all_user_rows_equal:true,all_sequences_equal:true,tables:after.summary,scope:after.comparison_scope};}
export async function storedGame(pool,keys,f){const g=(await pool.query('SELECT id,room_id,state,rev,current_round,snapshot_cipher FROM game_sessions WHERE room_id=$1 AND id=$2',[f.room,f.game])).rows[0];assert(g);const r=(await pool.query('SELECT id,state,cipher FROM game_rounds WHERE room_id=$1 AND session_id=$2 AND round_index=$3',[f.room,f.game,g.current_round])).rows[0];assert(r);return {game:g,round:r,data:keys.decrypt(r.cipher,topicAad.round(f.room,f.game,r.id)),history:await loadTopicObject(pool,keys,{room:f.room,session:f.game,id:f.game,kind:'history'})};}
export async function liveUntouched(pool,keys,f,now){
 const stored=await storedGame(pool,keys,f),d=stored.data,actors=d.plan.actors;assert.equal(stored.game.state,'active');assert(['pending','active'].includes(d.state));assert.equal(d.plan.interaction,'pair_private');assert.equal(actors.length,2);assert.equal(d.invitation.state,'active');assert.equal(d.action.state,'active');assert(actors.every(id=>d.invitation.acks.includes(id)&&d.action.acks.includes(id)));
 const scope={room:f.room,session:f.game,id:d.conversation_id},conversation=await loadTopicObject(pool,keys,{...scope,kind:'conversation'}),chat=await loadTopicObject(pool,keys,{...scope,kind:'chat'});assert(conversation&&chat);const c=conversation.state;assert.equal(c.state,'open');assert.equal(c.offer.state,'active');assert(actors.every(id=>c.offer.acks.includes(id)));assert(chat.messages.length>0);assert.equal(chat.epoch,c.epoch);const advice=c.advice.filter(v=>v.state==='accepted'&&v.text!==null);assert(advice.length>0);
 const sessions=(await pool.query('SELECT s.member_id,s.expires_at,s.revoked_at,m.removed_at,m.presence,m.slot,m.heartbeat_at,m.reserved_until FROM room_sessions s JOIN room_members m ON m.room_id=s.room_id AND m.id=s.member_id WHERE s.room_id=$1',[f.room])).rows.filter(v=>actors.includes(v.member_id));assert.equal(sessions.length,2);assert(sessions.every(v=>v.revoked_at===null&&v.removed_at===null&&v.presence==='online'&&v.slot!==null));
 const projections=[];for(const actor of actors){const p=await loadTopicObject(pool,keys,{room:f.room,session:f.game,id:actor,kind:'projection'});assert(p&&p.schema_version===2&&p.boot_id===d.boot_id&&p.round_id===d.plan.round_id&&p.game_rev===Number(stored.game.rev)&&p.conversation_revision===c.revision&&p.epoch===c.epoch&&p.view.prompt&&p.view.offer.own_accepted);projections.push(p);}
 const expiries={invitation:d.invitation.active_until,action:d.action.active_until,parent:c.parent_expires_at,topic:c.offer.expires_at,...Object.fromEntries(advice.map((v,i)=>['advice'+i,v.expires_at])),...Object.fromEntries(sessions.flatMap((v,i)=>[['session'+i,v.expires_at.getTime()],['presence'+i,v.heartbeat_at.getTime()+timers.presence],['reservation'+i,v.reserved_until.getTime()]])),...Object.fromEntries(projections.map((v,i)=>['projection'+i,v.expires_at]))};assert(now>=d.clock_floor&&now>=c.clock_floor);for(const expiry of Object.values(expiries))assert(Number.isSafeInteger(expiry)&&now<expiry,'Untouched restored grant must still be naturally unexpired');const refs=Number((await pool.query('SELECT count(*) AS n FROM topic_game_private_refs WHERE room_id=$1 AND session_id=$2',[f.room,f.game])).rows[0].n);assert(refs>0);
 return {server_time_ms:now,round_clock_floor_ms:d.clock_floor,conversation_clock_floor_ms:c.clock_floor,expiries_ms:expiries,remaining_ms:Object.fromEntries(Object.entries(expiries).map(([name,expiry])=>[name,expiry-now])),live_invitation_action_topic_advice_chat:true,live_projection_count:projections.length,private_ref_count:refs,snapshot_sha256:sha(stored.game.snapshot_cipher),history_sha256:sha(stored.history),boot_id_sha256:sha(d.boot_id)};
}
export async function revokedUntouched(pool,keys,f,before){
 const stored=await storedGame(pool,keys,f),d=stored.data;assert.equal(d.state,'stopped');for(const name of ['invitation','action']){assert.equal(d[name].state,'stopped');assert.equal(d[name].acks.length,0);}const objects=Number((await pool.query("SELECT count(*) AS n FROM topic_game_objects WHERE room_id=$1 AND session_id=$2 AND kind IN ('conversation','chat','projection')",[f.room,f.game])).rows[0].n),refs=Number((await pool.query('SELECT count(*) AS n FROM topic_game_private_refs WHERE room_id=$1 AND session_id=$2',[f.room,f.game])).rows[0].n);assert.equal(objects,0);assert.equal(refs,0);assert.equal(sha(stored.game.snapshot_cipher),before.snapshot_sha256);assert.equal(sha(stored.history),before.history_sha256);return {raw_round_stopped:true,invitation_action_acks_cleared:true,private_objects:objects,private_refs:refs,snapshot_history_unchanged:true,observed_before_legacy_maintain_listen_or_private_http:true};
}
