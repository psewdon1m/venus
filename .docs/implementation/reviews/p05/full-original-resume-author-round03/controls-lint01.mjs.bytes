import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import * as old from '../p05-full-original-lanes02.mjs';
import {carryShape,remainingPlan,verifyCarry,validateResumeActivation,fixedLanes,validatePlan,plannedAck,strictSectionRefusal} from '../p05-full-original-lanes03.mjs';
const root='C:/.projects/venus',base=root+'/.docs/implementation/evidence/p05/full-original-operator-drain01',read=n=>JSON.parse(fs.readFileSync(path.join(base,n))),plan=JSON.parse(fs.readFileSync(root+'/.artifacts/p05-full-original-ranges02/MANIFEST.json')),carry=JSON.parse(fs.readFileSync(root+'/.artifacts/p05-full-original-resume03/CARRY.json')),terminal=read('BATCH_TERMINAL.json'),stop=read('STOP.json'),summary=read('SUMMARY.json'),locations=read('RAW-LOCATIONS.json'),clone=v=>structuredClone(v),checks=[];
async function check(name,f){await f();checks.push(name);console.log('PASS '+name);}
const shape=(t=terminal,s=stop,u=summary,l=locations)=>carryShape(plan,t,s,u,l);
await check('original_plan2609_and_four_original_functions_exact02',()=>{validatePlan(plan);for(const [a,b]of [[plannedAck,old.plannedAck],[strictSectionRefusal,old.strictSectionRefusal],[validatePlan,old.validatePlan],[fixedLanes,old.fixedLanes]])assert.equal(a.toString(),b.toString());});
await check('actual_operator_drain_metadata_carries62_only',()=>{assert.deepEqual(shape(),carry.carried_ordinals);});
await check('duplicate_ordinal_or_owner_or_wrong_lane_rejects',()=>{for(const change of [t=>{t.records[1]=t.records[0];},t=>{t.records[1].owner=t.records[0].owner;},t=>{t.records[0].lane=7;}]){const t=clone(terminal);change(t);assert.throws(()=>shape(t));}});
await check('failed_started_or_notok_record_never_resumes',()=>{for(const [key,value]of [['ok',false],['native_range_execution_ok',false],['exit_code',1],['overflow',true],['signal','SIGTERM'],['strict_section_refusal_blocks_acceptance',true],['code','FAILED']]){const t=clone(terminal);t.records[0][key]=value;assert.throws(()=>shape(t));}});
await check('STOP_must_be_explicit_operator_not_nativefailure',()=>{for(const s of [{...stop,kind:'NATIVE_FAILURE'},{...stop,not_native_case_failure:false},{...stop,first_observed_failure:{}}])assert.throws(()=>shape(terminal,s));});
await check('missing_receipt_location_or_foreign_range_rejects',()=>{assert.throws(()=>shape(terminal,stop,summary,locations.slice(1)));const l=clone(locations);l[0].range.start++;assert.throws(()=>shape(terminal,stop,summary,l));});
await check('summary_count_or_nativefailure_cannot_be_waived',()=>{for(const u of [{...summary,native_case_failure:true},{...summary,completed_jobs:61},{...summary,remaining_NOT_RUN:2548}])assert.throws(()=>shape(terminal,stop,u));});
await check('remaining_exact2547_sameowners_lanes_originalackhashes',()=>{const q=remainingPlan(plan,shape(),carry.new_run_root);assert.equal(q.jobs,plan.jobs);assert.equal(q.prefixes,plan.prefixes);assert.equal(q.ack_base,plan.ack_base);assert.equal(q.worker_profile.worker_ms,1200000);const ids=q.lane_jobs.flat();assert.equal(ids.length,2547);assert.equal(new Set(ids).size,2547);assert.deepEqual([...ids].sort((a,b)=>a-b),plan.jobs.filter(j=>!carry.carried_ordinals.includes(j.ordinal)).map(j=>j.ordinal));for(const [lane,values]of q.lane_jobs.entries())for(const id of values){assert.equal(plan.jobs[id].lane,lane);assert(!carry.carried_ordinals.includes(id));}});
await check('cold_scheduling_exact_remaining_once_without_native_or_prefix_replay',async()=>{const q=remainingPlan(plan,shape(),carry.new_run_root),ids=[];const records=await fixedLanes(q,async(j,l)=>{assert.equal(j.lane,l);ids.push(j.ordinal);return {ok:true};},()=>false,()=>{throw Error('SHOULD_NOT_FAIL');});assert.equal(records.length,2547);assert.equal(new Set(ids).size,2547);assert.deepEqual(records.map(r=>r.ordinal),plan.jobs.filter(j=>!carry.carried_ordinals.includes(j.ordinal)).map(j=>j.ordinal));});
await check('original_first_failure_STOP_does_not_retry_remaining',async()=>{const q=remainingPlan(plan,shape(),carry.new_run_root);let stopped=false;const ids=[];await fixedLanes(q,async j=>{ids.push(j.ordinal);return {ok:false};},()=>stopped,()=>{stopped=true;});assert(ids.length<=8);assert.equal(new Set(ids).size,ids.length);});
await check('pending_rootactivation_denies_before_witness_or_native_work',()=>{const raw=fs.readFileSync(root+'/.artifacts/p05-full-original-ranges02/MANIFEST.json'),craw=fs.readFileSync(root+'/.artifacts/p05-full-original-resume03/CARRY.json'),template=JSON.parse(fs.readFileSync(root+'/.artifacts/p05-full-original-resume03/ROOT-ACTIVATION.template.json'));assert.throws(()=>validateResumeActivation(plan,carry,raw,craw,template,template.oneoff_sha256));});
if(process.argv.includes('--verify-actual-carry')){const verified=verifyCarry(plan,carry);fs.writeFileSync(root+'/.artifacts/p05-full-original-resume03/ACTUAL-CARRY-VERIFIED.json',JSON.stringify(verified,null,2)+'\n',{flag:'wx'});checks.push('actual62_host_receipts_all_raw_hashchains_sealed_exports_verified_readonly');console.log('PASS actual62_host_receipts_all_raw_hashchains_sealed_exports_verified_readonly');}
console.log(JSON.stringify({status:'AUTHOR_FINITE_CARRY_AND_FAKE_SCHEDULE_ONLY_NOT_RUN',checks:checks.length,checks_detail:checks,native_runs:0,Docker_runs:0,actual_carry_readonly_verified:process.argv.includes('--verify-actual-carry')}));
