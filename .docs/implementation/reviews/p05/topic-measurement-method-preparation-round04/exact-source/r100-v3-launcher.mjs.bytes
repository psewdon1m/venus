/** Single bounded diagnostic. Cold default; --prepare copies bytes, never runs Node engine. */
import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,renameSync,existsSync,mkdirSync,lstatSync,statfsSync,unlinkSync} from 'node:fs';
import {resolve,join} from 'node:path';
import {spawn} from 'node:child_process';
import {createHash,randomBytes} from 'node:crypto';
import {performance} from 'node:perf_hooks';
import {fileURLToPath} from 'node:url';
import {ArtifactStore} from './artifact-store-v2.mjs';
const base='.artifacts/p05-topic-measurements-next',sha=b=>createHash('sha256').update(b).digest('hex'),json=p=>JSON.parse(readFileSync(p)),sleep=ms=>new Promise(r=>setTimeout(r,ms)),MiB=1024**2,CAP=128*MiB,RESERVE=10*1024**3;
const next=['r100-v3-launcher.mjs','r100-v3-child.mjs','r100-v3-volume.mjs','r100-v3-watchdog.mjs','r100-v3-inspect.mjs','r100-v3-package.py','allocated-tree.py','r100-v3-timing.mjs','r100-v3-chunks.mjs','artifact-store-v2.mjs','artifact-store-v3.mjs','memory-session.mjs','lifecycle.mjs','consume-session.mjs','diagnostics.mjs','invariants.mjs','observations.mjs','public-transcript.mjs','wire-renderers.mjs','wire-source.json'];
const old=['fixture.mjs','profiles.mjs','support.mjs','private-transcript.mjs','contracts/public-features.json',...['cards','manifest','map','semantic','taxonomy'].map(n=>'fixture-checkpoint02/'+n+'.json')];
function execute(exe,args,{timeout=30000,cap=65536}={}){return new Promise((done,reject)=>{const child=spawn(exe,args,{windowsHide:true}),out=[],err=[];let bytes=0,settled=false;const finish=(e,v)=>{if(settled)return;settled=true;clearTimeout(timer);e?reject(e):done(v);},timer=setTimeout(()=>{child.kill('SIGKILL');finish(Error('BOUNDED_COMMAND_TIMEOUT:'+exe));},timeout);for(const[s,target]of[[child.stdout,out],[child.stderr,err]])s.on('data',b=>{bytes+=b.length;if(bytes>cap){child.kill('SIGKILL');finish(Error('BOUNDED_CAPTURE_CAP:'+exe));}else target.push(b);});child.on('error',e=>finish(e));child.on('close',(code,signal)=>finish(null,{code,signal,stdout:Buffer.concat(out),stderr:Buffer.concat(err)}));});}
const python=()=>resolve('.venv/Scripts/python.exe');
async function inventory(){const r=await execute(python(),['-B','-c','import sys,json;sys.path.insert(0,"tools");from stage_inventory import inventory,identity;f=inventory();print(json.dumps({"identity":identity(f),"files":f}))'],{cap:2*MiB});assert.equal(r.code,0);return JSON.parse(r.stdout);}
function hostSpace(path){const s=statfsSync(path,{bigint:true}),available=s.bavail*s.bsize;assert(available>=BigInt(RESERVE+CAP),'ACTUAL_HOST_C_RESERVE_PLUS_CAP');return available.toString();}
export async function prepare(receiptPath){
 const receipt=json(receiptPath),before=await inventory();assert.equal(before.identity,receipt.source_identity);assert.equal(Object.keys(receipt.host_compiled_files_sha256).length,64);hostSpace(resolve('.artifacts/p05'));const id=randomBytes(6).toString('hex'),owner=randomBytes(16).toString('hex'),root=resolve('.artifacts/p05/r100-v3-'+id),store=new ArtifactStore(root,{limit:CAP});for(const n of ['inputs','control','archive'])mkdirSync(join(root,n),{mode:0o700});for(const n of ['live','receipts'])mkdirSync(join(root,'control',n),{mode:0o700});const input=new ArtifactStore(join(root,'inputs'),{limit:16*MiB}),producer={},mapping=[];
 const copy=(original,target,expected)=>{const bytes=readFileSync(original),hash=sha(bytes);if(expected)assert.equal(hash,expected,original);input.write(target,bytes);mapping.push({original,snapshot:target,sha256:hash,bytes:bytes.length});return hash;};
 for(const n of next)producer[base+'/'+n]=copy(base+'/'+n,'next/'+n);for(const n of old)producer['.artifacts/p05-topic-measurements/'+n]=copy('.artifacts/p05-topic-measurements/'+n,'old/'+n);
 const compiled=receipt.host_compiled_files_sha256;for(const[p,h]of Object.entries(compiled))copy(p,'compiled/'+p,h);const image_source=Object.fromEntries(Object.entries(receipt.image_files_sha256).filter(([p])=>!p.includes('/dist/')));for(const p of ['packages/relationship-engine/src/policy.json','package-lock.json'])image_source[p]=sha(readFileSync(p));for(const[p,h]of Object.entries(image_source))copy(p,'source/'+p,h);
 input.write('input-pins.json',JSON.stringify({producer,compiled,image_source,mapping},null,2)+'\n');input.write('source-before.json',JSON.stringify(before,null,2)+'\n');input.write('build-receipt.json',readFileSync(receiptPath));input.write('design-proposal.json',readFileSync(base+'/r100-v3-design-proposal.json'));
 const preparation={status:'PREPARED_NOT_AUTHORIZED',root,id,owner,container:'venus-r100-v3-'+id,volume:'venus-r100-v3-'+id+'-output',source_identity:before.identity,image:receipt.image,receipt_path:receiptPath,receipt_sha256:sha(readFileSync(receiptPath)),metadata_pins:Object.fromEntries(['source-before.json','build-receipt.json','design-proposal.json'].map(n=>[n,sha(readFileSync(join(root,'inputs',n)))])),input_pin_sha256:sha(readFileSync(join(root,'inputs/input-pins.json'))),input_logical_bytes:input.check(),global_owned_cap_bytes:CAP,statistics_RUN:false};store.write('preparation.json',JSON.stringify(preparation,null,2)+'\n');console.log(JSON.stringify(preparation));return preparation;
}
export async function run(root,ackPath){
 root=resolve(root);const prep=json(join(root,'preparation.json')),ack=json(ackPath),pins=json(join(root,'inputs/input-pins.json'));assert.equal(ack.kind,'ROOT_R100_V3_OPERATIONAL_DIAGNOSTIC_ACK');assert.equal(ack.status,'AUTHORIZED');assert.equal(ack.independent_method_and_producer_review,'PASS');assert.equal(ack.preparation_sha256,sha(readFileSync(join(root,'preparation.json'))));assert.equal(ack.source_identity,prep.source_identity);assert.equal(ack.image,prep.image);assert.equal(ack.attempts,1);assert.equal(ack.global_owned_cap_bytes,CAP);assert.equal(ack.reserve_bytes,RESERVE);assert.equal(sha(readFileSync(join(root,'inputs/input-pins.json'))),prep.input_pin_sha256);assert(!existsSync(join(root,'control/receipts/execution-start.json')),'NO_IMPLICIT_RERUN');
 for(const[n,h]of Object.entries(prep.metadata_pins))assert.equal(sha(readFileSync(join(root,'inputs',n))),h,'EXACT_PREPARED_METADATA');for(const row of pins.mapping){assert.equal(sha(readFileSync(join(root,'inputs',row.snapshot))),row.sha256);assert.equal(sha(readFileSync(row.original)),row.sha256);}assert.deepEqual(await inventory(),json(join(root,'inputs/source-before.json')));hostSpace(root);
 const control=new ArtifactStore(join(root,'control/receipts'),{limit:8*MiB}),input=new ArtifactStore(join(root,'inputs'),{limit:16*MiB}),write=(name,value)=>control.write(name,JSON.stringify(value,null,2)+'\n'),auditFailures=[],safe=(name,value)=>{try{write(name,value);}catch(e){auditFailures.push({path:name,error:e.message});}};
 const config={...ack,owner:prep.owner,container:prep.container,volume:prep.volume,control_directory:join(root,'control/live'),host_output_path:root,counter_freshness_ms:2000},design={...json(join(root,'inputs/design-proposal.json')),status:'FIXED_REVIEWED_ROOT_ACK_NON_GATING',source_identity:prep.source_identity,image:prep.image};input.write('root-ack.json',JSON.stringify(config,null,2)+'\n');input.write('design.json',JSON.stringify(design,null,2)+'\n');write('execution-start.json',{at:new Date().toISOString(),attempt:1});
 let phase='BOOTSTRAP',counter=0,phaseExtra={},heartbeat,watchdog,watchdogResult,status='NOT_ACCEPTED',error,exportVerified=false,cleanup='retained',workerStopped=false,nativeInventory;const started=performance.now(),controlPath=join(root,'control/live');
 const publish=()=>{const temporary=join(controlPath,'phase-next.json');assert(!existsSync(temporary));if(existsSync(join(controlPath,'phase.json')))assert(!lstatSync(join(controlPath,'phase.json')).isSymbolicLink());writeFileSync(temporary,JSON.stringify({owner:prep.owner,counter:++counter,phase,...phaseExtra})+'\n',{flag:'wx',mode:0o600});renameSync(temporary,join(controlPath,'phase.json'));};
 async function setPhase(next,extra={}){phase=next;phaseExtra=extra;publish();const start=performance.now();while(performance.now()-start<2000){if(existsSync(join(controlPath,'supervisor-ack.json'))&&json(join(controlPath,'supervisor-ack.json')).phase===phase)return;await sleep(25);}throw Error('EXTERNAL_PHASE_ACK_MISSING:'+phase);}
 const docker=async(args,options={})=>{const r=await execute('docker',args,options);if(r.code!==0)throw Error('DOCKER_COMMAND_FAILED:'+args[0]+':'+r.code+':'+r.stderr.toString('utf8').slice(0,256));return r;};
 const label=['--label','com.venus.measurement.owner='+prep.owner,'--label','com.venus.measurement.purpose=R100v3-non-gating'],volumeMount='type=volume,source='+prep.volume+',target=/venus-output,volume-nocopy',snapshotMount=['--mount','type=bind,source='+join(root,'inputs/next')+',target=/app/'+base+',readonly'];
 const helperArgs=(role,{uid='1000:1000',capChown=false,readonly=false}={})=>['run','--name',prep.container+'-'+role,...label,'--network','none','--read-only','--user',uid,'--cap-drop','ALL',...(capChown?['--cap-add','CHOWN']:[]),'--security-opt','no-new-privileges:true','--memory','128m','--cpus','1','--pids-limit','48','--log-driver','none','--mount',volumeMount+(readonly?',readonly':''),...snapshotMount,prep.image];
 async function hostAllocation(path){const r=await execute(python(),['-B',join(root,'inputs/next/allocated-tree.py'),'--root='+path],{timeout:30000,cap:MiB});assert.equal(r.code,0);return JSON.parse(r.stdout);}
 async function footprint(){hostSpace(root);const parts={};for(const[n,limit]of Object.entries({inputs:16,export:20,archive:20})){if(!existsSync(join(root,n)))continue;const measured=await hostAllocation(join(root,n));assert(Math.max(measured.logical_bytes,measured.allocated_bytes)<=limit*MiB,'FOOTPRINT_PARTITION:'+n);parts[n]=measured;}parts.control_fully_reserved={logical_bytes:16*MiB,allocated_bytes:16*MiB,scope:'8MiB immutable receipts +8MiB fixed-name bounded live controls; charged in full to avoid racing live heartbeat scans'};const total=Object.values(parts).reduce((s,r)=>s+Math.max(r.logical_bytes,r.allocated_bytes),0)+(nativeInventory?Math.max(nativeInventory.logical_bytes,nativeInventory.allocated_bytes):20*MiB)+36*MiB;assert(total<=CAP,'GLOBAL_OWNED_ALLOCATED_CAP');return{parts,native_reserved_or_observed:nativeInventory??20*MiB,safety_bytes:36*MiB,total_conservative_bytes:total,cap_bytes:CAP,scope:'Owned artifacts, excludes Docker/VHD extent growth; actual host/native free guards separate'};}
 async function resources(){const containers=(await docker(['ps','-aq','--filter','label=com.venus.measurement.owner='+prep.owner])).stdout.toString().trim().split(/\s+/).filter(Boolean),volumes=(await docker(['volume','ls','-q','--filter','label=com.venus.measurement.owner='+prep.owner])).stdout.toString().trim().split(/\s+/).filter(Boolean);return{containers,volumes};}
 async function ownedContainers(){const ids=(await resources()).containers;if(!ids.length)return[];const details=JSON.parse((await docker(['inspect',...ids])).stdout);for(const r of details){assert.equal(r.Config?.Labels?.['com.venus.measurement.owner'],prep.owner);assert.equal(r.Image,prep.image);assert(['','-bootstrap','-probe','-volume-inspect','-export'].some(role=>r.Name==='/'+prep.container+role),'EXACT_OWNED_CONTAINER_ROLE');}return details;}
 async function inspectNative(){const r=await docker([...helperArgs('volume-inspect',{readonly:true}),'node',base+'/r100-v3-inspect.mjs','--inspect']);nativeInventory=JSON.parse(r.stdout);safe('native-inventory.json',nativeInventory);assert.equal(nativeInventory.status,'READONLY_NATIVE_INVENTORY');return nativeInventory;}
 try{
  write('footprint-before.json',await footprint());assert.deepEqual(await resources(),{containers:[],volumes:[]});publish();heartbeat=setInterval(()=>{try{publish();}catch(e){error=e.message;}},250);
  const configPath=join(root,'inputs/root-ack.json');watchdog=spawn(process.execPath,[join(root,'inputs/next/r100-v3-watchdog.mjs'),'--config='+configPath,'--sha='+sha(readFileSync(configPath))],{windowsHide:true,stdio:['ignore','ignore','ignore']});watchdogResult=new Promise(resolveDone=>watchdog.on('close',code=>resolveDone(code)));await setPhase('BOOTSTRAP');
  const created=await docker(['volume','create','--driver','local',...label,prep.volume]);write('volume-create.json',{stdout:created.stdout.toString()});const [v]=JSON.parse((await docker(['volume','inspect',prep.volume])).stdout);assert.equal(v.Name,prep.volume);assert.equal(v.Driver,'local');assert.equal(v.Labels?.['com.venus.measurement.owner'],prep.owner);assert(!v.Options||!Object.keys(v.Options).length);write('volume-inspect-before.json',v);
  const bootstrap=await docker([...helperArgs('bootstrap',{uid:'0:0',capChown:true}),'node',base+'/r100-v3-volume.mjs','--bootstrap','--owner='+prep.owner,'--volume='+prep.volume,'--image='+prep.image],{timeout:30000});write('bootstrap.json',JSON.parse(bootstrap.stdout));write('bootstrap-container-inspect.json',JSON.parse((await docker(['inspect',prep.container+'-bootstrap'])).stdout)[0]);await setPhase('PROBE');const probe=await docker([...helperArgs('probe'),'node',base+'/r100-v3-volume.mjs','--probe','--owner='+prep.owner,'--volume='+prep.volume,'--image='+prep.image],{timeout:10000});write('native-write-probe.json',JSON.parse(probe.stdout));write('probe-container-inspect.json',JSON.parse((await docker(['inspect',prep.container+'-probe'])).stdout)[0]);assert(probe.stdout.length<=65536);writeFileSync(join(controlPath,'native-write-probe.json'),probe.stdout,{flag:'wx',mode:0o600});
  const createArgs=['create','--name',prep.container,...label,'--network','none','--read-only','--user','1000:1000','--cap-drop','ALL','--security-opt','no-new-privileges:true','--memory','1536m','--cpus','1','--pids-limit','96','--log-driver','none','--tmpfs','/tmp:size=32m,mode=1777','--mount',volumeMount,...snapshotMount,'--mount','type=bind,source='+join(root,'inputs/old')+',target=/app/.artifacts/p05-topic-measurements,readonly','--mount','type=bind,source='+join(root,'inputs')+',target=/inputs,readonly','--mount','type=bind,source='+controlPath+',target=/hostguard,readonly',prep.image,'node','--max-old-space-size=1200',base+'/r100-v3-child.mjs'];write('create-arguments.json',createArgs);await docker(createArgs);write('worker-created-inspect.json',JSON.parse((await docker(['inspect',prep.container])).stdout)[0]);await setPhase('RUN');const terminal=await execute('docker',['start','-a',prep.container],{timeout:335000,cap:65536});write('worker-terminal.json',{code:terminal.code,signal:terminal.signal,stdout:terminal.stdout.toString(),stderr:terminal.stderr.toString()});const [stopped]=JSON.parse((await docker(['inspect',prep.container])).stdout);assert.equal(stopped.State.Running,false);workerStopped=true;write('worker-terminal-inspect.json',stopped);
  await setPhase('STOP');await inspectNative();write('footprint-after-native.json',await footprint());await setPhase('EXPORT');const exported=await docker([...helperArgs('export',{readonly:true}),'tar','-C','/venus-output','-cf','-','.'],{timeout:60000,cap:20*MiB-65536});const tarPath=join(root,'archive/native-prefix.tar');writeFileSync(tarPath,exported.stdout,{flag:'wx',mode:0o600});const extraction=await execute(python(),['-B',join(root,'inputs/next/r100-v3-package.py'),'--extract='+tarPath,'--destination='+join(root,'export')],{timeout:60000,cap:MiB});assert.equal(extraction.code,0);const manifest=JSON.parse(extraction.stdout);assert.deepEqual(manifest.files.slice().sort((a,b)=>a.path.localeCompare(b.path)),nativeInventory.files.slice().sort((a,b)=>a.path.localeCompare(b.path)),'EXACT_EXPORTED_NATIVE_FILE_HASHES');exportVerified=true;write('export-verification.json',manifest);unlinkSync(tarPath);write('footprint-after-export.json',await footprint());
  await setPhase('ARCHIVE');assert.deepEqual(await inventory(),json(join(root,'inputs/source-before.json')));for(const row of pins.mapping)assert.equal(sha(readFileSync(row.original)),row.sha256,'SOURCE_OR_PRODUCER_DRIFT');write('source-after.json',await inventory());const packaged=await execute(python(),['-B',join(root,'inputs/next/r100-v3-package.py'),'--archive='+root,'--target='+join(root,'archive/exact-diagnostic.zip')],{timeout:30000,cap:MiB});assert.equal(packaged.code,0);write('archive-verification.json',JSON.parse(packaged.stdout));write('footprint-after-archive.json',await footprint());
  const report=json(join(root,'export/report.json'));assert.equal(report.status,'NON_GATING_FIXED_R100_DIAGNOSTIC_COMPLETE');assert.equal(report.rounds_completed,100);assert.equal(terminal.code,0);assert(!existsSync(join(controlPath,'watchdog-state.json')),'WATCHDOG_FAILURE_LATCHED');status='COMPLETE_NON_GATING';
 }catch(e){error=e.message;process.exitCode=1;}
 finally{
  try{try{await setPhase('CLEANUP');}catch(e){safe('cleanup-phase-ack-failure.json',{error:e.message});}const details=await ownedContainers();for(const r of details)if(r.State.Running)await docker(['kill',r.Id],{timeout:30000});const ids=details.map(r=>r.Id);if(ids.length)await docker(['rm','-f',...ids],{timeout:30000});workerStopped=true;const owned=await resources();if(exportVerified)for(const volume of owned.volumes){const[v]=JSON.parse((await docker(['volume','inspect',volume])).stdout);assert.equal(v.Name,prep.volume);assert.equal(v.Labels?.['com.venus.measurement.owner'],prep.owner);await docker(['volume','rm',volume],{timeout:30000});}const remaining=await resources();cleanup=remaining.containers.length===0&&remaining.volumes.length===0?'completed':'retained';safe('owned-after-cleanup.json',remaining);if(cleanup==='completed'&&exportVerified){assert.deepEqual(await inventory(),json(join(root,'inputs/source-before.json')));for(const row of pins.mapping){assert.equal(sha(readFileSync(row.original)),row.sha256);assert.equal(sha(readFileSync(join(root,'inputs',row.snapshot))),row.sha256);}safe('source-after-finally.json',await inventory());phase='DONE';phaseExtra={worker_stopped:workerStopped,owned_cleanup:cleanup,export_verified:true};publish();const supervisorCode=await Promise.race([watchdogResult??Promise.resolve(),sleep(3000)]);assert.equal(supervisorCode,0,'SUPERVISOR_DID_NOT_FINISH_CLEANLY');assert.equal(json(join(controlPath,'watchdog-terminal.json')).status,'SUPERVISOR_COMPLETE_NON_GATING','EXTERNAL_SUPERVISOR_NOT_ACCEPTED');}else error=(error??'')+' retained owned volume/prefix or unverified export';}catch(e){error=(error??'')+' cleanup/finalize:'+e.message;if(cleanup!=='completed')cleanup='retained';}
  clearInterval(heartbeat);if(watchdog&&watchdog.exitCode===null){watchdog.kill('SIGKILL');error=(error??'')+' supervisor unfinished';}if(error||cleanup!=='completed'||auditFailures.length)status='NOT_ACCEPTED';safe('launcher-terminal.json',{status,error,cleanup,exportVerified,workerStopped,auditFailures,owner:prep.owner,container:prep.container,volume:prep.volume,source_identity:prep.source_identity,image:prep.image,elapsed_ms:performance.now()-started,statistics_RUN:false,full_matrix_feasibility:false});console.log(JSON.stringify({status,error,cleanup,root,statistics_RUN:false}));
 }
 if(status!=='COMPLETE_NON_GATING')process.exitCode=1;return{status,error,cleanup};
}
if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){
 const receipt=process.argv.find(a=>a.startsWith('--prepare='))?.slice(10),root=process.argv.find(a=>a.startsWith('--run='))?.slice(6),ack=process.argv.find(a=>a.startsWith('--root-ack='))?.slice(11);if(receipt)await prepare(receipt);else if(root){assert(ack);await run(root,ack);}else console.log(JSON.stringify({status:'NOT_RUN',usage:'--prepare=<exact-root-build-receipt> or --run=<prepared-path> --root-ack=<reviewed-root-authority>',statistics_RUN:false,Docker_calls:0}));
}
