/** One root-authorized native-output diagnostic; importing this file is execution. */
import assert from 'node:assert/strict';
import {readFileSync,statfsSync,readdirSync,lstatSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {performance} from 'node:perf_hooks';
import {ArtifactStore as NativeStore} from './artifact-store-v3.mjs';
import {ArtifactStore as TreeStore} from './artifact-store-v2.mjs';
import {ChunkWriter} from './r100-v3-chunks.mjs';
import {diagnosticTimings as timing} from './r100-v3-timing.mjs';
import {MemorySession} from './memory-session.mjs';
import {consumeSession} from './consume-session.mjs';
import {loadFixture} from '../p05-topic-measurements/fixture.mjs';
import {FrozenTopicMap} from '../../packages/relationship-engine/dist/index.js';
import {Keyring} from '../../apps/api/dist/security.js';
const start=performance.now(),cpu=process.cpuUsage(),load=p=>JSON.parse(readFileSync(p)),hash=b=>createHash('sha256').update(b).digest('hex'),config=load('/inputs/root-ack.json'),design=load('/inputs/design.json'),pins=load('/inputs/input-pins.json');
assert.equal(config.kind,'ROOT_R100_V3_OPERATIONAL_DIAGNOSTIC_ACK');assert.equal(config.status,'AUTHORIZED');assert.equal(config.independent_method_and_producer_review,'PASS');assert.equal(design.status,'FIXED_REVIEWED_ROOT_ACK_NON_GATING');assert.equal(design.attempts,1);assert.equal(config.global_owned_cap_bytes,128*1024**2);assert.equal(design.descriptor.seed_literal,'venus:P05-AUTHOR-FULL-CYCLE-CPU-1:N8:online:CHAT_ON:T6:TD:R100');assert.equal(design.descriptor.rounds,100);assert.deepEqual(design.descriptor,{size:8,mode:'truth_or_dare',context:'online',capability:'CHAT_ON',regime:'T6_TARGETED_CHANGES',rounds:100,comfort:4,class_profile:'F',seed_literal:'venus:P05-AUTHOR-FULL-CYCLE-CPU-1:N8:online:CHAT_ON:T6:TD:R100'});assert.equal(config.source_identity,design.source_identity);assert.equal(config.image,design.image);
timing.sync('input_pin_verify',()=>{for(const kind of ['producer','compiled','image_source'])for(const[p,h]of Object.entries(pins[kind]))assert.equal(hash(readFileSync(p)),h,kind+':'+p);assert.equal(Object.keys(pins.compiled).length,64);});
let lastCounter=null,lastAdvance=null;
function hostGuard(){const row=load('/hostguard/host-space.json'),now=performance.now();assert.equal(row.owner,config.owner);assert.equal(row.stop_requested===true,false,'EXTERNAL_STOP_LATCHED');assert(Number.isSafeInteger(row.counter)&&row.counter>0);if(lastCounter!==null)assert(row.counter>=lastCounter,'HOST_COUNTER_REORDER');if(row.counter!==lastCounter){lastCounter=row.counter;lastAdvance=now;}assert(now-lastAdvance<=2000,'HOST_COUNTER_STALE');assert(BigInt(row.available_bytes)>=BigInt(config.reserve_bytes+config.global_owned_cap_bytes),'HOST_ACTUAL_SPACE_STOP');return row;}
hostGuard();const initialCounter=lastCounter;while(lastCounter===initialCounter){assert(performance.now()-lastAdvance<=2000,'INITIAL_HOST_COUNTER_DID_NOT_ADVANCE');await new Promise(r=>setTimeout(r,25));hostGuard();}
function nativeGuard(){const s=statfsSync('/venus-output',{bigint:true}),available=s.bavail*s.bsize;assert(available>=BigInt(config.reserve_bytes+config.global_owned_cap_bytes),'NATIVE_ACTUAL_SPACE_STOP');return available.toString();}
function nativeBudget(next){return timing.sync('native_allocated_budget_scan',()=>{let logical=0n,allocated=0n,objects=0;function visit(path){const s=lstatSync(path,{bigint:true});assert(!s.isSymbolicLink()&&(s.isDirectory()||s.isFile()));assert(++objects<=1024);logical+=s.isFile()?s.size:0n;allocated+=s.blocks*512n;if(s.isDirectory())for(const n of readdirSync(path))visit(path+'/'+n);}visit('/venus-output');const size=BigInt(next),block=statfsSync('/venus-output',{bigint:true}).bsize;assert(block>0n&&block<=1024n**2n);const reserved=(size+block-1n)/block*block+1024n**2n;assert((logical>allocated?logical:allocated)+reserved<=20n*1024n**2n,'NATIVE_ALLOCATED_CAP_WITH_METADATA_MARGIN');return{logical:logical.toString(),allocated:allocated.toString(),next_reserved:reserved.toString()};});}
for(const name of ['entry','allowed'])timing.wrap(FrozenTopicMap.prototype,name,'actual_map_'+name);
for(const name of ['encrypt','decrypt'])timing.wrap(Keyring.prototype,name,'actual_AEAD_'+name);
for(const name of ['initialize','query','mutate','gameView','roomView','target','conversation','current','loaded','chat'])timing.wrap(MemorySession.prototype,name,'memory_actual_'+name,{async:true});
timing.wrap(TreeStore.prototype,'check','artifact_tree_scan');timing.wrap(TreeStore.prototype,'write','artifact_checked_write');
const checked=new NativeStore('/venus-output',{limit:20*1024**2,reserve:BigInt(config.reserve_bytes)}),store={write:(name,value)=>{hostGuard();nativeGuard();nativeBudget(Buffer.byteLength(value));return checked.write(name,value);}},pub=new ChunkWriter(store,'public'),priv=new ChunkWriter(store,'synthetic-private'),counts=()=>({records:0,bytes:0,payload_utf8_bytes:0,histogram:Array(256).fill(0)}),publicCounts=counts(),privateCounts=counts();
const context={section:'AUTHOR_R100_V3_NON_GATING',profile_key:'8/truth_or_dare/online/CHAT_ON/T6_TARGETED_CHANGES',seed_literal:design.descriptor.seed_literal,split:null,class_label_separate_from_features:'F'};
function append(writer,c,row){timing.sync('NDJSON_encode_entropy',()=>{const record={...context,...row},b=Buffer.from(JSON.stringify(record)+'\n');c.records++;c.bytes+=b.length;c.payload_utf8_bytes+=typeof record.raw_serialized_UTF8==='string'?Buffer.byteLength(record.raw_serialized_UTF8):typeof record.raw==='string'?Buffer.byteLength(record.raw):0;for(const byte of b)c.histogram[byte]++;writer.append(record);});}
const cgroup=()=>Object.fromEntries(readFileSync('/sys/fs/cgroup/cpu.stat','utf8').trim().split('\n').map(l=>l.split(/\s+/)));
let result,error,rounds=0,currentRound=0,peak=process.memoryUsage().rss,lastReceipt=start;
try{
 const f=timing.sync('fixture_verify',()=>loadFixture('.artifacts/p05-topic-measurements/fixture-checkpoint02'));
 result=await consumeSession(f,design.descriptor,{onPublic:r=>append(pub,publicCounts,r),onPrivate:r=>append(priv,privateCounts,r),shouldStop:()=>performance.now()-start>=300000,onRound:e=>{
  currentRound=e.current.data.plan.round_index;peak=Math.max(peak,process.memoryUsage().rss);if(e.phase==='terminal')rounds++;
  const now=performance.now();if(e.phase==='terminal'||now-lastReceipt>=10000){const u=process.cpuUsage(cpu);store.write('progress/'+String(rounds).padStart(3,'0')+'-'+String(currentRound).padStart(3,'0')+'-'+Math.floor(now-start)+'.json',JSON.stringify({rounds_completed:rounds,current_round:currentRound,wall_ms:now-start,cpu_ms:{user:u.user/1000,system:u.system/1000},cgroup_cpu_stat:cgroup(),rss_bytes:process.memoryUsage().rss,peak_observed_rss_bytes:peak,public_records_total:publicCounts.records,public_records_durable:pub.chunks.reduce((s,c)=>s+c.records,0),private_records_total:privateCounts.records,private_records_durable:priv.chunks.reduce((s,c)=>s+c.records,0),pending_raw_bytes:pub.pendingBytes+priv.pendingBytes,native_available_bytes:nativeGuard(),timing:timing.snapshot(),raw_pending_is_not_durable_prefix:true})+'\n');lastReceipt=now;}
 }});
 assert.equal(result.summary.completed_rounds,100);assert.equal(result.summary.status,'COMPLETE');assert.equal(result.features.raw.length,1075);assert.equal(result.diagnostics.status,'PASS');assert.equal(result.invariants.status,'PASS_PURE_COMPONENT_ONLY');
}catch(e){error={name:e.name,code:e.code??null,message:e.message,stack:e.stack};process.exitCode=1;}
finally{
 let manifests;try{manifests={public:pub.finish(),synthetic_private:priv.finish()};}catch(e){error??={message:e.message};process.exitCode=1;}
 const finish=(c,m)=>({...c,Shannon_bits_per_byte:-c.histogram.filter(n=>n).reduce((s,n)=>s+n/Math.max(1,c.bytes)*Math.log2(n/Math.max(1,c.bytes)),0),gzip_bytes:m?.chunks.reduce((s,r)=>s+r.bytes,0),raw_manifest:m});const u=process.cpuUsage(cpu),report={status:error?'DIAGNOSTIC_NOT_ACCEPTED':'NON_GATING_FIXED_R100_DIAGNOSTIC_COMPLETE',source_identity:design.source_identity,image:design.image,descriptor:design.descriptor,rounds_completed:rounds,current_round:currentRound,elapsed_wall_ms:performance.now()-start,cpu_ms:{user:u.user/1000,system:u.system/1000},cgroup_cpu_stat:cgroup(),peak_observed_rss_bytes:peak,max_RSS_kib:process.resourceUsage().maxRSS,accounting:{public:finish(publicCounts,manifests?.public),synthetic_private:finish(privateCounts,manifests?.synthetic_private)},timing:timing.snapshot(),summary:result?.summary,features:result?.features,diagnostics:result?.diagnostics,invariants:result?.invariants,history:result?.history,error,actual_PG_HTTP_WS:false,statistics_RUN:false,full_matrix_feasibility:false,human450_approved:false};
 try{store.write('report.json',JSON.stringify(report,null,2)+'\n');}finally{timing.restore();}console.log(JSON.stringify({status:report.status,rounds,wall_ms:report.elapsed_wall_ms,error:error?.message??null}));
}
