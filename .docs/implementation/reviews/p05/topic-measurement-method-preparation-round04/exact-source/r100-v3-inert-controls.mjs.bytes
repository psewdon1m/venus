await check('second attempt forbidden before any Docker call',()=>assert.throws(()=>validateConfig({...configBase,attempts:2})));
await check('global budget increase forbidden before any Docker call',()=>assert.throws(()=>validateConfig({...configBase,global_owned_cap_bytes:129*1024**2})));
