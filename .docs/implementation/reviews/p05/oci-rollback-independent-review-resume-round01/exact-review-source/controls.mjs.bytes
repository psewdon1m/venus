import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createRequire} from 'node:module';
import {resolve,join} from 'node:path';
import {planFor} from '../p05-oci-rollback-producer-resume01/host-runner.mjs';
import {policy,validatePlan,checkSample,validateVolumes} from '../p05-oci-rollback-producer-resume01/oci-resource-policy.mjs';
import {validateFinalGuardReceipt} from '../p05-oci-rollback-producer-resume01/contract.mjs';
const source=readFileSync('.artifacts/p05-oci-rollback-producer-resume01/host-runner.mjs','utf8'),require=createRequire(resolve('package.json')),ts=require('typescript'),ast=ts.createSourceFile('host.mjs',source,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS),binding=JSON.parse(readFileSync('.artifacts/p05-oci-rollback-producer-resume01/BINDING.json')),owner='a'.repeat(32),id='b'.repeat(12),plan=planFor(binding,owner,id,resolve('.artifacts/p05/venus-p05-oci-'+id)),rows=[];
function nestedFunction(name){let node;function walk(n){if(ts.isFunctionDeclaration(n)&&n.name?.text===name)node=n;ts.forEachChild(n,walk);}walk(ast);assert(node);return node.getText(ast);}
async function check(name,work){try{const details=await work();rows.push({name,status:'PASS',details});}catch(e){rows.push({name,status:'FAIL',error:e.message});}}
await check('fixed512/900 hard-ledger arithmetic itself is exact',()=>{assert(validatePlan(plan));assert.equal(policy.nativeReserved+policy.hostLimit+policy.burstSafety,policy.total);});
for(const[field,value]of [['total_cap_bytes',128*1024**2],['deadline_ms',300000],['no_global_cleanup',false],['protected_roots_rollback',true]])await check('wrong '+field+' denied',()=>assert.throws(()=>validatePlan({...plan,[field]:value})));
await check('sample refuses low host/native/cap exhaustion',()=>{const s={stop_requested:false,host_allocated_bytes:0,actual_host_free_bytes:String(12*1024**3),actual_native_free_bytes:String(12*1024**3)};assert(checkSample(s));for(const delta of [{actual_host_free_bytes:'0'},{actual_native_free_bytes:'UNKNOWN'},{host_allocated_bytes:160*1024**2},{stop_requested:true}])assert.throws(()=>checkSample({...s,...delta}));});
await check('exact create function permits Docker default shm outside claimed native ledger',async()=>{
 const calls=[],names=new Map(),label=['--label','com.venus.oci.owner='+owner],output=plan.output_root,command=async args=>{calls.push(args);return{};},inspect=async role=>({role});
 const create=new Function('assert','plan','names','label','join','output','command','inspect',nestedFunction('create')+';return create;')(assert,plan,names,label,join,output,command,inspect);
 await create('A1',['--tmpfs','/tmp:size=4m,mode=1777','--entrypoint','node',plan.images.A,'fixture']);
 assert.equal(calls.length,1);const args=calls[0];assert(!args.some(x=>x==='--ipc'||x.startsWith('--ipc=')||x==='--shm-size'||x.startsWith('--shm-size=')),'COUNTEREXAMPLE_WAS_FIXED');
 assert.equal(args.includes('--read-only'),true);return{exact_create_args:args,unaccounted_default_SHM:true,read_only_root_is_not_no_shm:true,declared_native_reserved_bytes:policy.nativeReserved,default_64MiB_hypothetical_extra_at_six_live_containers:6*64*1024**2,actual_Docker_created:false};
});
await check('probe and special PG create constructors also omit explicit IPC/shm fences',()=>{const supervisor=readFileSync('.artifacts/p05-oci-rollback-producer-resume01/oci-resource-supervisor.mjs','utf8');assert(!source.includes('--shm-size')&&!source.includes("'--ipc'")&&!supervisor.includes('--shm-size')&&!supervisor.includes("'--ipc'"));return{scope:'exact complete host/supervisor sources, no API creation'};});
await check('final receipt denies pending owner/failure/missing persistence/deadline',()=>{const r={owner,status:'PASS_OWNED_RESOURCE_GUARD_FINAL',external_native_probe_cleanup:'completed',failure:null,elapsed_ms:100};assert(validateFinalGuardReceipt(r,{owner}));for(const delta of [{owner:'b'.repeat(32)},{status:'PASS_OWNED_RESOURCE_GUARD'},{external_native_probe_cleanup:'PENDING'},{failure:'CAPACITY'},{receipt_persisted:false},{elapsed_ms:900001}])assert.throws(()=>validateFinalGuardReceipt({...r,...delta},{owner}));});
await check('wrong volume driver/owner/options denied',()=>{const v=Object.entries(plan.volumes).map(([key,Name])=>({Name,Driver:'local',Labels:{'com.venus.oci.owner':owner,'com.venus.oci.project':plan.project},Options:{type:'tmpfs',device:'tmpfs',o:{db:'size=256m,mode=0700',authority:'size=32m,mode=0700',private:'size=8m,mode=0700,uid=0,gid=0'}[key]}}));assert(validateVolumes(v,plan));assert.throws(()=>validateVolumes([{...v[0],Driver:'remote'}],plan));assert.throws(()=>validateVolumes([{...v[0],Labels:{'com.venus.oci.owner':'other'}}],plan));assert.throws(()=>validateVolumes([{...v[0],Options:{}}],plan));});
console.log(JSON.stringify({status:rows.every(x=>x.status==='PASS')?'PASS_INDEPENDENT_COUNTEREXAMPLES_CONFIRM_RESOURCE_FINDING':'FAIL',controls:rows,count:rows.length,confirmed_findings:['OCI-RESOURCE-RESUME01-001'],Docker_calls:0,OCI_switches:0,statistics_RUN:false},null,2));if(rows.some(r=>r.status!=='PASS'))process.exitCode=1;
