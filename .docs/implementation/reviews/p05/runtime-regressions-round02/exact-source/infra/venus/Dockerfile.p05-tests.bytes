FROM node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS dependencies
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/i18n/package.json packages/i18n/
COPY packages/relationship-engine/package.json packages/relationship-engine/
COPY packages/card-catalog/package.json packages/card-catalog/
RUN npm ci && node node_modules/playwright/cli.js install --with-deps chromium firefox webkit
RUN apt-get update && apt-get install -y --no-install-recommends xdotool ffmpeg && rm -rf /var/lib/apt/lists/*
COPY tests/p05/probe.mjs tests/p05/probe.mjs
USER 1000:1000
CMD ["node", "tests/p05/probe.mjs"]

FROM dependencies AS runtime
USER root
COPY tsconfig*.json ./
COPY apps apps
COPY packages packages
COPY tests tests
RUN npm run build && mkdir /artifacts && chown node:node /artifacts
USER 1000:1000
CMD ["node", "tests/p05/browser.mjs"]
