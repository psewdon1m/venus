import {beforeEach,describe,it,expect,vi} from 'vitest';
import type {TopicRoundView} from '@venus/contracts';
import {proposeConsent,consentResponse} from '@venus/relationship-engine';
import {TopicGames} from './topic-games.js';
import {DomainError} from './security.js';
import {gameDeliveryFence,type Rooms} from './rooms.js';

const storage=vi.hoisted(()=>({values:new Map<string,unknown>()}));
vi.mock('./topic-game-model.js',async original=>({...await original<typeof import('./topic-game-model.js')>(),loadTopicObject:async(_c:unknown,_k:unknown,s:{id:string;kind:string})=>structuredClone(storage.values.get(s.kind+':'+s.id)??null)}));
beforeEach(()=>storage.values.clear());
/** Real bundle, own-permission builder, prepared delivery and chat fences.
 * SQL/auth/source and materialization are explicit doubles, not PG proof. */
function fixture(){
 let now=1000,transactions=0,committed=0,authValid=true,accepted=true,sourceValid=true,safetyValid=true,present=true,late=()=>{};
 const member={id:'alice',role:'member',locale:'en'},auth={member,room:{id:'room',rev:'1',host_member_id:'host',meeting_context:'online'}};
 const actors=['alice','bob'];let invitation=proposeConsent('invitation',actors,'invitation',now);for(const actor of actors)invitation=consentResponse(invitation,actor,'accept',now,{offer_id:invitation.offer_id,scope:'invitation',proposal_revision:1});
 const action=proposeConsent('action',actors,'action',now,invitation.active_until),names=[{id:'alice',display_name:'Alice'},{id:'bob',display_name:'Bob'}];
 const game={id:'session',room_id:'room',rev:'3',state:'active',mode:'truth_or_dare'},data={schema_version:2,state:'active',boot_id:'',clock_floor:1000,conversation_id:'conversation',content_revision:1,choice:'dare',condition:null,invitation,action,plan:{actors,primary_member_id:'alice',interaction:'pair_private',requires_action_consent:true}};
 const safety={room_id:'room',revision:1,members:actors.map(member_id=>({member_id,revision:1,allow_topic_ids:['creative'],excluded_topic_ids:[]}))};
 const conv={state:{state:'open',revision:4,epoch:2,clock_floor:1000,parent_expires_at:181000,offer:{state:'active',expires_at:181000,acks:[...actors]},scope:{actors},preferences:Object.fromEntries(actors.map(id=>[id,{revision:1,allow:['creative'],excluded:[]}]))}};
 const loaded={game,data,row:{id:'round'},snapshot:{baseline:{context:'online',capabilities:['private_text_chat'],players:actors.map(id=>({id}))}},safety,map:{pins:{}}};
 const queries:{phase:number;sql:string}[]=[],query=async(sql:string,args:unknown[])=>{queries.push({phase:transactions,sql});if(sql.startsWith('SELECT private_protocol'))return {rows:[{private_protocol:2}],rowCount:1};if(sql.startsWith('SELECT 1 FROM game_participants'))return {rows:actors.includes(member.id)?[{}]:[],rowCount:actors.includes(member.id)?1:0};if(sql.startsWith('SELECT role'))return {rows:actors.includes(member.id)?[{role:member.id==='alice'?'primary':'secondary'}]:[]};if(sql.startsWith('SELECT id,display_name'))return {rows:names};if(sql.startsWith('SELECT m.presence'))return {rows:actors.map((_,slot)=>({presence:present?'online':'offline',slot,removed_at:null,heartbeat_at:new Date(now),reserved_until:new Date(181000)}))};throw Error('Unexpected SQL '+sql+' '+args);};
 const c={query},rooms={now:()=>now,options:{keys:{}},transaction:async(fn:(c:unknown)=>Promise<unknown>)=>{transactions++;const value=await fn(c);committed++;return value;},access:async()=>{if(!authValid)throw new DomainError('AUTH_REQUIRED',401);return auth;},finalAccessFence:async(_c:unknown,_a:unknown,isSafety=false)=>{if(!isSafety)late();return()=>{if(!authValid)throw new DomainError('AUTH_REQUIRED',401);if(!isSafety&&!accepted)throw new DomainError('ENTRY_REACCEPT_REQUIRED',403);};}} as unknown as Rooms;
 const games=new TopicGames(rooms,{enabled:true,privateTextChat:true,source:{active:async()=>null,pinned:async()=>{throw Error('unused');},assertCurrent:()=>{if(!sourceValid)throw new DomainError('SOURCE_UNAVAILABLE',503);}},safety:{read:async()=>safety,excludeLocked:async()=>{throw Error('unused');},assertCurrent:()=>{if(!safetyValid)throw new DomainError('TOPIC_SAFETY_CHANGED',409);}}});data.boot_id=games.bootId;
 const parent=()=>{if(!sourceValid)throw new DomainError('SOURCE_UNAVAILABLE',503);if(now<1000||now>=Math.min(invitation.active_until!,action.deadline))throw new DomainError('CONSENT_EXPIRED',409);};
 const prepared={schema_version:2,member_id:'alice',locale:'en',names_digest:Reflect.get(games,'namesDigest').call(games,names),boot_id:games.bootId,game_rev:3,round_id:'round',conversation_revision:4,epoch:2,safety,expires_at:6000,view:{schema_version:2,room_id:'room',session_id:'session',round_id:'round',game_rev:3,conversation_id:'conversation',revision:4,epoch:2,state:'active',server_time:new Date(1000).toISOString(),expires_at:new Date(181000).toISOString(),prompt:{text:'PRIVATE PROMPT',condition:null,choice:'dare'},advice:[]}};
 storage.values.set('projection:alice',prepared);storage.values.set('chat:conversation',{epoch:2,revision:1,messages:[{id:'message',sequence:1,sender:'bob',text:'PRIVATE CHAT'}]});
 const materialize=vi.fn(async()=>null);
 Object.assign(games,{row:async()=>game,current:async()=>({row:{id:'round'},data}),loaded:async()=>{games.options.source.assertCurrent({} as never);Object.defineProperty(game,gameDeliveryFence,{configurable:true,value:parent});return loaded;},actor:async(_c:unknown,_g:unknown,_r:unknown,id:string)=>{if(!actors.includes(id))throw new DomainError('ROUND_ACTOR_REQUIRED');},conversation:async()=>conv,prepareProjection:materialize,selectedFence:async()=>Object.assign(()=>{if(!present)throw new DomainError('ACTORS_UNAVAILABLE',409);},{deadline:451000})});
 let packet:TopicRoundView|undefined,atCommit=0;return {games,auth,data,game,conv,names,prepared,materialize,queries,late:(fn:()=>void)=>late=fn,setNow:(n:number)=>now=n,withdrawSource:()=>sourceValid=false,withdrawSafety:()=>safetyValid=false,revoke:()=>authValid=false,reaccept:()=>accepted=false,offline:()=>present=false,transactions:()=>transactions,get packet(){return packet;},get atCommit(){return atCommit;},run:()=>games.dispatchRoundView('room','credential','session','round',v=>{atCommit=committed;packet=v;})};
}
describe('coherent private round view final transaction',()=>{
 it('commits preparation then assembles the four parts in one readonly delivery context',async()=>{const f=fixture();f.setNow(2000);await f.run();expect(f.transactions()).toBe(2);expect(f.atCommit).toBe(1);expect(f.materialize).toHaveBeenCalledTimes(1);expect(f.queries.filter(v=>v.phase===2).every(v=>v.sql.startsWith('SELECT '))).toBe(true);expect(f.packet).toMatchObject({schema_version:2,own:{game_rev:3,server_time:new Date(2000).toISOString(),expires_at:new Date(7000).toISOString(),round_actions:{accept_action:true}},target:{game_rev:3,choice:'dare'},conversation:{game_rev:3,epoch:2,server_time:new Date(2000).toISOString(),prompt:{text:'PRIVATE PROMPT'}},chat:{epoch:2,messages:[{direction:'received',text:'PRIVATE CHAT'}]}});expect(f.prepared.expires_at).toBe(6000);});
 it('outsider or room host never receives target, topic or chat despite a live private round',async()=>{const f=fixture();f.auth.member.id='host';f.auth.member.role='host';await f.run();expect(f.materialize).not.toHaveBeenCalled();expect(f.packet).toMatchObject({target:null,conversation:null,chat:null,own:{session_actions:{abort:true},conversation_actions:{chat:false,respond_topic:false}}});expect(JSON.stringify(f.packet)).not.toMatch(/PRIVATE|actors|topic|epoch/);});
 it('denies every enqueue when credential is revoked during the final awaited auth read',async()=>{const f=fixture();f.late(f.revoke);await expect(f.run()).rejects.toMatchObject({code:'AUTH_REQUIRED'});expect(f.packet).toBeUndefined();});
 for(const fault of ['source','safety','flag','entry','expiry','presence'] as const)it('withdraws private values but preserves independently authorized Stop/Pause after final '+fault,async()=>{const f=fixture();f.late(()=>{if(fault==='source')f.withdrawSource();if(fault==='safety')f.withdrawSafety();if(fault==='flag')f.games.options.privateTextChat=false;if(fault==='entry')f.reaccept();if(fault==='expiry')f.setNow(31000);if(fault==='presence')f.offline();});await f.run();expect(f.packet).toMatchObject({target:null,conversation:null,chat:null,own:{session_actions:{stop:true,pause:true},round_actions:{accept_action:false},conversation_actions:{chat:false,offer_advice:false}}});expect(JSON.stringify(f.packet)).not.toContain('PRIVATE');});
 it('source outage before materialization still yields only safe own controls',async()=>{const f=fixture();f.withdrawSource();await f.run();expect(f.packet).toMatchObject({target:null,conversation:null,chat:null,own:{session_actions:{stop:true,pause:true},round_actions:{finish:false,accept_action:false}}});});
 it('refuses stale names or legacy projection metadata without relaxing safety',async()=>{for(const fault of ['names','metadata']){const f=fixture();if(fault==='names')f.names[0]!.display_name='Renamed';else Reflect.deleteProperty(f.prepared,'member_id');storage.values.set('projection:alice',f.prepared);await f.run();expect(f.packet).toMatchObject({conversation:null,chat:null,own:{session_actions:{stop:true},round_actions:{accept_action:false}}});}});
 it('propagates unexpected SQL/materialization errors rather than fabricating an empty success',async()=>{const f=fixture();f.materialize.mockRejectedValue(Error('SQL failure'));await expect(f.run()).rejects.toThrow('SQL failure');expect(f.packet).toBeUndefined();});
 it('checks the returned fence again without renewing its5s display authority',async()=>{const f=fixture();await f.run();f.setNow(6000);expect(()=>Reflect.get(f.packet!,gameDeliveryFence)()).toThrowError(expect.objectContaining({code:'TOPIC_DELIVERY_EXPIRED'}));});
});
