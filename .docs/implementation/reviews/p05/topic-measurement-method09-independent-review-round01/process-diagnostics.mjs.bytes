/** Bounded infrastructure diagnostics only. No disk writes or command retries. */
import assert from 'node:assert/strict';
export function infrastructureError(error){return{name:['Error','AssertionError','TypeError','RangeError'].includes(error?.name)?error.name:'OTHER',code:['EPERM','EACCES','EBUSY','ENOSPC','ENOENT','EEXIST','EIO','ERR_ASSERTION','ENOMEM'].includes(error?.code)?error.code:'UNLISTED',errno:Number.isSafeInteger(error?.errno)?error.errno:null,syscall:['rename','open','write','fsync','statfs'].includes(error?.syscall)?error.syscall:null};}
export function captureProcess(child,{onFault=()=>{}}={}){
 const state={stdout:'',stderr:'',stdout_truncated:false,stderr_truncated:false,spawn_error:null},chunks={stdout:[],stderr:[]},counts={stdout:0,stderr:0};
 for(const [name,limit] of [['stdout',16384],['stderr',8192]])child[name].on('data',value=>{const b=Buffer.from(value),left=Math.max(0,limit-counts[name]);if(left)chunks[name].push(b.subarray(0,left));counts[name]+=b.length;state[name]=Buffer.concat(chunks[name]).toString('utf8');if(counts[name]>limit){state[name+'_truncated']=true;onFault('SUPERVISOR_DIAGNOSTIC_CAPTURE_OVERFLOW');}});
 child.on('error',error=>{state.spawn_error=['ENOENT','EACCES','EPERM','ENOMEM'].includes(error.code)?error.code:'UNLISTED_SPAWN_ERROR';onFault('SUPERVISOR_SPAWN_ERROR');});return state;
}
export function snapshotDiagnostics(state){return state?{...state}:{stdout:'',stderr:'',stdout_truncated:false,stderr_truncated:false,spawn_error:'SUPERVISOR_NOT_STARTED'};}
const packageReasons=new Set(["ACTUAL_HOST_SPACE_LOW_OR_INVALID", "ALLOCATION_QUANTUM_UNKNOWN", "ALLOCATION_QUANTUM_UNSUPPORTED", "ARCHIVE_BUFFER_CAP", "ARCHIVE_FINAL_CAP", "EXPORT_DUPLICATE_MEMBER", "EXPORT_FILE_COUNT_CAP", "EXPORT_MEMBER_CAP", "EXPORT_NONREGULAR_MEMBER", "EXPORT_PATH_GRAMMAR", "EXPORT_TAR_CAP", "EXPORT_TOTAL_CAP", "EXPORT_TRUNCATED_MEMBER", "FIXED_HOST_BUDGET_REQUIRED", "HOST_PARENT_REPARSE_OR_NON_DIRECTORY", "HOST_WRITE_AUTHORITY_REQUIRED", "HOST_WRITE_PARTITION_SCOPE", "LIVE_OWNER_GUARD_CONFIG_REQUIRED", "METHOD05_WRITE_AUTHORITY_REQUIRED", "PACKAGE_ALLOCATED_CAP", "PACKAGE_PARENT_LINK_OR_NON_DIRECTORY", "PARTITION_LIMIT_INVALID", "PROSPECTIVE_WRITE_SIZE_INVALID", "STAGE_INPUT_CAP", "STAGE_PARTITION_REQUIRED", "SUPERVISOR_CAPACITY_FAULT_LATCHED", "SUPERVISOR_COUNTER_INVALID", "SUPERVISOR_COUNTER_REORDERED", "SUPERVISOR_INITIAL_ADVANCE_MISSING", "SUPERVISOR_OWNER_MISMATCH", "SUPERVISOR_SAMPLE_STALE", "SUPERVISOR_SPACE_INVALID", "SUPERVISOR_SPACE_LOW"]);
export function packageFailure(stderr,stage){
 try{assert(Buffer.byteLength(stderr)<=4096);const x=JSON.parse(stderr.trim());assert.deepEqual(Object.keys(x).sort(),['transport','status','stage','exception_class','reason','os_errno','winerror','primary'].sort());assert.equal(x.transport,'PYTHON_PACKAGE_FAILURE_V1');assert.equal(x.status,'NOT_ACCEPTED');assert.equal(x.stage,stage);assert.equal(x.primary,true);assert(['OutputStopped','OSError','PermissionError','ValueError','AssertionError','FileNotFoundError','OTHER'].includes(x.exception_class));assert(x.reason===null||packageReasons.has(x.reason));for(const n of ['os_errno','winerror'])assert(x[n]===null||Number.isSafeInteger(x[n]));return x;}catch{return{transport:'PYTHON_PACKAGE_FAILURE_UNAVAILABLE',status:'NOT_ACCEPTED',stage};}
}
