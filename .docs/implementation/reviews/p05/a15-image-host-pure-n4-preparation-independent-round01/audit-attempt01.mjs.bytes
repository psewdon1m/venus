const read=p=>fs.readFileSync(p),sha=b=>createHash('sha256').update(b).digest('hex'),pins={};function pin(p,h){const b=read(p);if(h)assert.equal(sha(b),h,p);pins[p]={sha256:sha(b),bytes:b.length};return p.endsWith('.json')?JSON.parse(b):b;}function packet(p,h){const ix=pin(p,h);for(const f of Array.isArray(ix.files)?ix.files:Object.entries(ix.files).map(([p,v])=>({path:p,...v})))assert.equal(pin(path.join(path.dirname(p),f.path),f.sha256) instanceof Buffer?pins[path.join(path.dirname(p),f.path)].bytes:f.bytes,f.bytes);return ix;}
