/** Recompute retained measurement arithmetic; never generates a statistical sample. */
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {trainLDA,aucCI} from '../p05-topic-measurements/statistics.mjs';
const hash=b=>createHash('sha256').update(b).digest('hex');
export function auditFairnessSession(cells,session){
 const d=session.descriptor,key=[d.size,d.mode,d.context,d.capability,d.regime].join('/');
 assert(!session.summary.refusal,'FAIRNESS_UNEXPECTED_REFUSAL');
 let c=cells.get(key);if(!c){c={sessions:0,K:0,K_private:0,counts:Array(d.size).fill(0),max_individual_session_share:0,zero_pair_sessions:0};cells.set(key,c);}c.sessions++;
 const own=Array(d.size).fill(0),players=Array.from({length:d.size},(_,i)=>'00000000-0000-4000-8000-'+String(i+1).padStart(12,'0'));let K=0;
 for(const p of session.planner_audit)if(p.interaction==='pair_public'||p.interaction==='pair_private'){
  assert.equal(p.actors.length,2);assert.equal(new Set(p.actors).size,2);K++;c.K++;if(p.interaction==='pair_private')c.K_private++;
  for(const actor of p.actors){const index=players.indexOf(actor);assert(index>=0,'UNKNOWN_FAIRNESS_ACTOR');own[index]++;c.counts[index]++;}
 }
 if(K)c.max_individual_session_share=Math.max(c.max_individual_session_share,...own.map(n=>n/(2*K)));else c.zero_pair_sessions++;
}
export function compareFairness(cells,reported){
 assert.equal(cells.size,588);assert.equal(reported.length,588);const seen=new Set();
 for(const row of reported){assert(!seen.has(row.cell));seen.add(row.cell);const c=cells.get(row.cell);assert(c);assert.equal(c.sessions,2000);for(const key of ['sessions','K','K_private','counts','max_individual_session_share','zero_pair_sessions'])assert.deepEqual(row[key],c[key],'RECOMPUTED_FAIRNESS_'+key);
  const D=2*c.K;assert(D>0);const shares=c.counts.map(n=>n/D),gap=Math.max(...shares)-Math.min(...shares);assert.deepEqual(row.shares,shares);assert.equal(row.D,D);assert.equal(row.aggregate_player_share_gap,gap);assert(c.max_individual_session_share<=.5&&gap<=.02);
 }
}
function decodeCandidates(training){
 const dimension=training[0][0].length,sets=[[],[]],indices=[];
 for(let i=0;i<dimension;i++){sets[0][i]=new Set(training[0].map(r=>r[i]));sets[1][i]=new Set(training[1].map(r=>r[i]));if(![...sets[0][i]].some(v=>sets[1][i].has(v)))indices.push(i);}
 return{sets,valid:new Set(indices)};
}
export function recomputeInference({rows,scoreRows,reported,names,expectedFeatureDigest}){
 assert.equal(names.length,1075);const classes=[reported.negative,reported.positive],cells=new Map(),pooledTrain=[[],[]],digest=createHash('sha256');let records=0;
 const get=cell=>{if(!cells.has(cell))cells.set(cell,{train:[[],[]],scores:[[],[]]});return cells.get(cell);};
 for(const row of rows()){
  digest.update(JSON.stringify(row)+'\n');records++;assert.equal(row.raw.length,1075);assert(row.raw.every(Number.isFinite));assert(Number.isSafeInteger(row.completed_rounds)&&row.completed_rounds>=0&&row.completed_rounds<=100);
  assert(['train','holdout'].includes(row.split));const ci=classes.indexOf(row.class_label);assert(ci>=0);if(row.split!=='train')continue;
  const feature=Float64Array.from(row.raw,x=>x/Math.max(1,row.completed_rounds)),c=get(row.cell);c.train[ci].push(feature);pooledTrain[ci].push(feature);
 }
 assert.equal(digest.digest('hex'),expectedFeatureDigest,'FEATURES_MUST_MATCH_REPLAYED_SESSION_ROWS');assert.equal(records,42000);assert.equal(cells.size,42);
 for(const c of cells.values()){assert.equal(c.train[0].length,100);assert.equal(c.train[1].length,100);c.model=trainLDA(...c.train);c.decoder=decodeCandidates(c.train);}
 const pooledModel=trainLDA(...pooledTrain),pooledDecoder=decodeCandidates(pooledTrain),pooledScores=[[],[]],scores=scoreRows();let held=0;
 for(const row of rows()){
  if(row.split!=='holdout')continue;held++;const ci=classes.indexOf(row.class_label),c=cells.get(row.cell);assert(c&&ci>=0);const feature=Float64Array.from(row.raw,x=>x/Math.max(1,row.completed_rounds)),score=c.model.score(feature),pooledScore=pooledModel.score(feature);c.scores[ci].push(score);pooledScores[ci].push(pooledScore);
  const stored=scores.next();assert(!stored.done,'MISSING_HELDOUT_SCORE');assert.deepEqual(stored.value,{cell:row.cell,split:row.split,class_label:row.class_label,index:row.index,seed_literal:row.seed_literal,score,pooled_score:pooledScore},'RECOMPUTED_HELDOUT_SCORE');
  for(const i of c.decoder.valid)if(!c.decoder.sets[ci][i].has(feature[i]))c.decoder.valid.delete(i);for(const i of pooledDecoder.valid)if(!pooledDecoder.sets[ci][i].has(feature[i]))pooledDecoder.valid.delete(i);
 }
 assert(scores.next().done,'EXTRA_HELDOUT_SCORE');assert.equal(held,33600);assert.equal(reported.training_rows,8400);assert.equal(reported.holdout_rows,33600);
 const compare=(reportedRow,c,model,decoder)=>{
  const metric=aucCI(...c.scores);for(const key of ['n_negative','n_positive','auc','se','ci95'])assert.deepEqual(reportedRow[key],metric[key],'RECOMPUTED_'+key);
  assert.equal(reportedRow.coefficient_sha256,hash(Buffer.from(model.weights.buffer)));assert(reportedRow.intercept===model.intercept,'RECOMPUTED_INTERCEPT_JSON_ZERO_EQUIVALENCE');const decoders=[...decoder.valid].map(i=>names[i]);assert.deepEqual(reportedRow.structural_deterministic_decoders,decoders);assert.equal(metric.status,'PASS');assert.equal(decoders.length,0);assert.equal(reportedRow.status,'PASS');
 };
 assert.equal(reported.strata.length,42);const seen=new Set();for(const row of reported.strata){assert(!seen.has(row.cell));seen.add(row.cell);const c=cells.get(row.cell);assert(c);assert.equal(c.scores[0].length,400);assert.equal(c.scores[1].length,400);compare(row,c,c.model,c.decoder);}
 compare(reported.pooled,{scores:pooledScores},pooledModel,pooledDecoder);assert.equal(reported.status,'PASS');return{records,heldout:held,models:43,status:'RECOMPUTED_FROM_RETAINED_FEATURES'};
}
