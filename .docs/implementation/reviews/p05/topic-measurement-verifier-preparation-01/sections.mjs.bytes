import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
import {descriptors,counts,modes,contexts,caps,regimes} from './workload.mjs';
import {consumeSession} from './consume-session.mjs';
import {ChunkWriter} from './chunks.mjs';
import {comparisonMetric} from './streaming-inference.mjs';
import {pairedRatioCI} from '../p05-topic-measurements/statistics.mjs';
import {makeSnapshot,makeHistory,makeSafety,playerId} from '../p05-topic-measurements/profiles.mjs';
import {certificate,hardEligible} from '../p05-topic-measurements/support.mjs';
import {selectNextTopicRound,digest,FrozenPack} from '../../packages/relationship-engine/dist/index.js';
const key=d=>[d.size,d.mode,d.context,d.capability,d.regime].join('/');
function featureRecord(r){const d=r.descriptor;return{cell:[d.size,d.mode,d.context].join('/'),capability:d.capability,regime:d.regime,prior:d.prior??null,comparison:d.comparison,split:d.split,class_label:d.exclusionClass??d.class_profile,index:d.index,seed_literal:d.seed_literal,raw:r.features.raw,completed_rounds:r.summary.completed_rounds,requested_rounds:d.rounds,refused:Boolean(r.summary.refusal),unavailable_branches:r.summary.unavailable_branches};}
export async function runSection(name,{f,store,directory,deadline,progress=()=>{}}){
 const stop=()=>Date.now()>=deadline,raw=new ChunkWriter(store,name+'/public-raw'),privateRaw=new ChunkWriter(store,name+'/synthetic-private-raw'),sessions=new ChunkWriter(store,name+'/sessions'),failures=new ChunkWriter(store,name+'/failures');let attempted=0,completed=0,safeRefusals=0,rounds=0;
 const execute=async d=>{
  assert(!stop(),'SECTION_WALL_STOP');attempted++;const context={section:name,profile_key:key(d),seed_literal:d.seed_literal,split:d.split??null,class_label_separate_from_features:d.exclusionClass??d.class_profile??null};
  let r;try{r=await consumeSession(f,d,{onPublic:event=>raw.append({...context,...event}),onPrivate:event=>privateRaw.append({...context,...event}),shouldStop:stop,onRound:event=>{if(event.phase==='terminal')progress({section:name,attempted,completed,safeRefusals,completed_rounds:rounds,current_session_round:event.current.data.plan.round_index,rss_bytes:process.memoryUsage().rss});}});}catch(e){failures.append({descriptor:d,error_name:e.name,error_code:e.code??null,error_message:e.message,completed_prefix_retained:true});throw e;}
  const record=featureRecord(r);sessions.append({...record,descriptor:d,planner_audit:r.history.rounds,summary:r.summary,diagnostics:r.diagnostics,invariants:r.invariants,modeled_public_frames:r.features.modeled_public_frames,actual_WS_frames:r.features.actual_WS_frames});rounds+=r.summary.completed_rounds;if(r.summary.refusal){safeRefusals++;failures.append({descriptor:d,refusal:r.summary.refusal,completed_prefix:r.summary.completed_rounds});}else completed++;
  assert.equal(r.diagnostics.status,'PASS','INVARIANT_VIOLATION');if(attempted%10===0)progress({section:name,attempted,completed,safeRefusals,rounds});return r;
 };
 let result;
 try{
  if(name==='invariants'){
   let rejected=false;try{FrozenPack.load(f.cards,f.manifest);}catch(error){assert.equal(error.code,'PACK_NOT_REVIEWED','PRODUCTION_LOADER_MUST_REJECT_FOR_REVIEW_STATUS');rejected=true;}assert(rejected,'DRAFT_ACCEPTED_BY_PRODUCTION_LOADER');const invariantRows=new Map();const diagnostics={hard_card_checks:0,private_rounds:0,empty_private:0,strict_anti_repeat_checks:0,strict_anti_repeat_violations:0,no_effective_alternative_exceptions:0,prior_content_diagnostic_checks:0};
   for(const d of descriptors('invariants')){const r=await execute(d);for(const[k,v]of Object.entries(r.diagnostics.counters))diagnostics[k]+=v;for(const row of r.invariants.rows){if(!invariantRows.has(row.id))invariantRows.set(row.id,{...row,checks:0,violations:0});const sum=invariantRows.get(row.id);sum.checks+=row.checks;sum.violations+=row.violations;}}
   assert.equal(attempted,counts.invariants);assert.equal(diagnostics.strict_anti_repeat_violations,0);invariantRows.get('I12').checks++;assert.equal(invariantRows.size,15);assert([...invariantRows.values()].every(r=>r.violations===0));result={status:'PASS',invariants:[...invariantRows.values()],diagnostics,runtime_evidence_required:true,I14_pure_close_testable:false,refusals_retained_not_complete:true};
  }else if(name==='fairness'){
   const cells=new Map();for(const d of descriptors('fairness')){const r=await execute(d),cellKey=key(d);let cell=cells.get(cellKey);if(!cell){cell={size:d.size,mode:d.mode,context:d.context,capability:d.capability,regime:d.regime,sessions:0,counts:Array(d.size).fill(0),K:0,K_private:0,zero_pair_sessions:0,max_individual_session_share:0,stages:{}};cells.set(cellKey,cell);}cell.sessions++;assert(!r.summary.refusal,'COMPATIBLE_FAIRNESS_SUPPORT_REFUSAL');let own=Array(d.size).fill(0),K=0;
    for(const round of r.history.rounds)if(round.interaction.startsWith('pair_')){K++;cell.K++;if(round.interaction==='pair_private')cell.K_private++;for(const id of round.actors){const i=Array.from({length:d.size},(_,j)=>playerId(j)).indexOf(id);assert(i>=0);own[i]++;cell.counts[i]++;}}
    if(!K)cell.zero_pair_sessions++;else cell.max_individual_session_share=Math.max(cell.max_individual_session_share,...own.map(n=>n/(2*K)));
    for(const[stage,row]of Object.entries(r.diagnostics.stages)){cell.stages[stage]??={rounds:0,private_eligible_after_cap:0,private_selected:0,empty_selected:0};for(const[k,v]of Object.entries(row))cell.stages[stage][k]+=v;}
   }
   assert.equal(attempted,counts.fairness);assert.equal(cells.size,588);const rows=[];for(const[cellKey,c]of cells){assert.equal(c.sessions,2000);const D=2*c.K,shares=c.counts.map(n=>D?n/D:null),gap=D?Math.max(...shares)-Math.min(...shares):null,privateNA=c.context==='online'&&c.capability==='DEFAULT_OFF';let good=D>0&&c.max_individual_session_share<=.5&&gap<=.02;
    if(!privateNA)for(const stage of ['3','4'])if(!(c.stages[stage]?.private_eligible_after_cap>0&&c.stages[stage]?.private_selected>0))good=false;
    rows.push({cell:cellKey,...c,D,shares,aggregate_player_share_gap:gap,private_scope:privateNA?'NA_PRIVATE_CAPABILITY':'CHECKED',status:good?'PASS':'FAIL'});
   }result={status:rows.every(r=>r.status==='PASS')?'PASS':'FAIL',cells:rows,denominator:'K_public+K_private incl empty opportunities; D=2K',stage_rows:2352};
  }else if(name==='gf'){
   const paired={both:0,g_only:0,f_only:0,neither:0},pairs=new ChunkWriter(store,name+'/paired-outcomes');for(const d of descriptors('gf')){assert(!stop(),'SECTION_WALL_STOP');const hits=[];for(const class_profile of ['G','F']){const s=makeSnapshot(f,{...d,class_profile}),h=makeHistory(f,s,d.regime),r=selectNextTopicRound(s,h,f.pack,f.map,makeSafety(s,d.regime)).round;hits.push(r.interaction==='pair_public'&&r.actors.slice().sort().join(':')===[playerId(0),playerId(1)].join(':'));}paired[hits[0]?(hits[1]?'both':'g_only'):(hits[1]?'f_only':'neither')]++;attempted++;pairs.append({index:d.index,seed_literal:d.seed_literal,G:hits[0],F:hits[1]});if(attempted%1000===0)progress({section:name,attempted});}
   assert.equal(attempted,1000000);result={...pairedRatioCI(paired),outcomes:pairs.finish(),paired_identical_seed:true};
  }else if(name==='social'||name==='exclusion'){
   const groups=new Map();for(const d of descriptors(name)){const r=await execute(d);assert(!r.summary.refusal,'COMPATIBLE_INFERENCE_SUPPORT_REFUSAL');const group=[d.capability,d.prior??d.regime,d.comparison].join('/');let writer=groups.get(group);if(!writer){writer=new ChunkWriter(store,name+'/features/'+group,{maxBytes:512*1024});groups.set(group,writer);}writer.append(featureRecord(r));}
   assert.equal(attempted,counts[name]);const metrics=[];for(const[group,writer]of groups){assert(!stop(),'SECTION_WALL_STOP');const manifest=writer.finish(),comparison=group.split('/').at(-1),classes=name==='social'?[...comparison]:comparison.match(/E\d/g);metrics.push({group,features:manifest,...comparisonMetric(directory,manifest,{negative:classes[0],positive:classes[1],store,prefix:name+'/metrics/'+group})});}
   assert.equal(groups.size,name==='social'?42:12);result={status:metrics.every(m=>m.status==='PASS')?'PASS':'FAIL',comparisons:metrics,max_CI95_upper:.65,fixed_orientation_train_only:true};
  }else if(name==='C2'){
   const supportRows=new ChunkWriter(store,name+'/eligibility'),dictionary=new Map();let logical=0;
   for(const capability of caps)for(const regime of regimes)for(const mode of modes)for(const context of contexts)for(let comfort=0;comfort<=4;comfort++)for(const class_profile of ['X','J','F','G','M','S','R'])for(let stage=1;stage<=4;stage++){
    assert(!stop(),'SECTION_WALL_STOP');const s=makeSnapshot(f,{size:2,mode,context,comfort,class_profile,capability,regime,rounds:100,seed_literal:'venus:P05-C2-CORPUS-CERTIFICATE-NO_SAMPLE_SEED'}),h=makeHistory(f,s,regime),state=makeSafety(s,regime),actors=s.baseline.players.map(p=>p.id),cert=certificate(f,s,h,state,actors,stage),ids={};
    for(const interaction of ['group','solo','pair_public']){const scope=interaction==='group'?[]:interaction==='solo'?[actors[0]]:actors;ids[interaction]=f.pack.cards.filter(c=>c.interaction===interaction&&!f.map.excluded_card_ids.includes(c.id)&&hardEligible(c,s,scope,stage)&&f.map.entry(c.id).semantic_family_ids.every(id=>!h.public_history.some(r=>f.map.entry(r.card_id).semantic_family_ids.includes(id)))).map(c=>c.id);}
    const lists={...ids,private_baseline:cert.after_context_class_comfort_capability,private_effective:cert.after_same_pair_private_semantic_history},refs={};for(const[k,list]of Object.entries(lists)){const hash=digest(list);dictionary.set(hash,list);refs[k]={hash,count:list.length};}
    const reachable=Array.from({length:100},(_,i)=>Array.from({length:i+1},(_,r)=>Math.min(4,1+Math.floor(4*r/Math.max(1,i)))).includes(stage)),capable=context!=='online'||capability==='CHAT_ON',privateSupported=capable&&stage>=3&&comfort>=1&&!['X','J'].includes(class_profile);assert(privateSupported?cert.baseline_common>=25:cert.after_context_class_comfort_capability.length===0,'C2_EXACT_PRIVATE_HARD_GUARD_STATUS');if(privateSupported){if(regime==='T1_EMPTY')assert.equal(cert.after_full_union_allow_exclude.length,0,'C2_EMPTY_TOPIC_REGIME');else assert(cert.distinct_residual_family_ids.length>=75,'C2_RESIDUAL_SUPPORT_MINIMUM');if(regime==='T6_TARGETED_CHANGES')assert(certificate(f,s,h,state,actors,stage,['creative']).distinct_residual_family_ids.length>=75,'C2_REQUESTED_FULL_UNION_SUPPORT');}const expected_status_per_R=reachable.map(active=>!active?'NA_STAGE_UNREACHABLE':!capable?'NA_PRIVATE_CAPABILITY':!privateSupported?'EXPECTED_PRIVATE_ZERO':regime==='T1_EMPTY'?'SAFE_EMPTY_GENERIC_EXPECTED':'SUPPORTED_PRIVATE');supportRows.append({capability,regime,mode,context,comfort,class_profile,stage,N_interval:[2,8],R_interval:[1,100],stage_reachable_per_R:reachable,expected_status_per_R,logical_rows:700,distinct_card_sets:refs,card_counts_not_multiplied_by_actor_permutations:true,source_support_kind:'INITIAL_CORPUS_AFTER_PRIOR_AND_TOPIC_FILTERS; budget/consumption in sessions'});logical+=700;
   }
   assert.equal(logical,8232000);store.write(name+'/card-set-dictionary.json',JSON.stringify(Object.fromEntries(dictionary))+'\n');const eligibility=supportRows.finish(),subcounts={},privateCells=new Map();for(const section of ['C2_neutral','C2_negative','C2_private']){const before=attempted;for(const d of descriptors(section)){const r=await execute(d),expected=d.mode==='yes_but'&&d.class_profile==='X';assert(expected?Boolean(r.summary.refusal):!r.summary.refusal,'UNEXPECTED_C2_SUPPORT_RESULT');if(section==='C2_private'){const cellKey=[key(d),d.comfort,d.class_profile].join('/');let cell=privateCells.get(cellKey);if(!cell){cell={capability:d.capability,context:d.context,regime:d.regime,stages:{},sessions:0};privateCells.set(cellKey,cell);}cell.sessions++;for(const[stage,row]of Object.entries(r.diagnostics.stages)){const sum=cell.stages[stage]??={private_eligible_after_cap:0,private_selected:0,empty_selected:0};for(const k of Object.keys(sum))sum[k]+=row[k];}}}subcounts[section]=attempted-before;}
   assert.equal(privateCells.size,5880);for(const cell of privateCells.values()){assert.equal(cell.sessions,100);for(const stage of ['3','4']){const row=cell.stages[stage];if(cell.context==='online'&&cell.capability==='DEFAULT_OFF'){assert.equal(row?.private_selected??0,0);}else{assert(row?.private_eligible_after_cap>0&&row.private_selected>0,'C2_REACHABLE_PRIVATE_AGGREGATE_REQUIRED');if(cell.regime==='T1_EMPTY')assert.equal(row.private_selected,row.empty_selected,'C2_EMPTY_GENERIC_ALL_OPPORTUNITIES');}}}store.write(name+'/private-aggregate-cells.json',JSON.stringify([...privateCells].map(([cell,value])=>({cell,...value})))+'\n');assert.equal(subcounts.C2_neutral,58800);assert.equal(subcounts.C2_negative,196);assert.equal(subcounts.C2_private,588000);result={status:'PASS',eligibility,logical_eligibility_rows:logical,session_subcounts:subcounts,all_zero_cells_retained:true};
  }else throw Error('UNKNOWN_SECTION');
 }finally{raw.flush();privateRaw.flush();sessions.flush();failures.flush();}
 return{schema_version:1,...result,section:name,attempted,completed,safe_refusals:safeRefusals,completed_rounds:rounds,raw:raw.finish(),synthetic_private_raw:privateRaw.finish(),sessions:sessions.finish(),failures:failures.finish(),full_P05_PASS:false,actual_transport_inferred:false};
}
