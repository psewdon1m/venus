/** Mechanical verifier. No statistical producer or mutator is launched here. */
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
import {counts,descriptors} from './workload.mjs';
import {auditFairnessSession,compareFairness,recomputeInference} from './verifier-metrics.mjs';
const hash=b=>createHash('sha256').update(b).digest('hex');
export function assertCount(report){const expected={C2:58800+196+588000,invariants:980000,fairness:1176000,gf:1000000,social:1764000,exclusion:504000}[report.section];assert.equal(report.attempted,expected,'EXACT_REGISTERED_COUNT');assert.equal(report.status,'PASS');if(report.section==='C2'){assert.equal(report.logical_eligibility_rows,8232000);assert.deepEqual(report.session_subcounts,{C2_neutral:58800,C2_negative:196,C2_private:588000});}if(report.section==='invariants'){assert.equal(report.invariants.length,15);assert.equal(new Set(report.invariants.map(r=>r.id)).size,15);assert(report.invariants.every(r=>r.violations===0));assert.equal(report.invariants.find(r=>r.id==='I14').checks,0);assert(report.runtime_evidence_required);}if(report.section==='fairness'){assert.equal(report.cells.length,588);assert.equal(new Set(report.cells.map(r=>r.cell)).size,588);assert(report.cells.every(r=>r.sessions===2000&&r.max_individual_session_share<=.5&&r.aggregate_player_share_gap<=.02&&r.K>0));}if(['social','exclusion'].includes(report.section)){assert.equal(report.comparisons.length,report.section==='social'?42:12);for(const group of report.comparisons){assert.equal(group.strata.length,42);for(const row of [...group.strata,group.pooled])assert(row.ci95[1]<=.65&&row.status==='PASS'&&row.structural_deterministic_decoders.length===0);}}if(report.section==='gf')assert(report.ci95[0]>1);return true;}
function* expectedDescriptors(section){if(section==='C2'){for(const name of ['C2_neutral','C2_negative','C2_private'])yield*descriptors(name);}else yield*descriptors(section);}
function rawKey(r){return r.profile_key+'|'+r.seed_literal+'|'+(r.split??'')+'|'+(r.class_label_separate_from_features??'');}
function sessionKey(r){const d=r.descriptor;return[d.size,d.mode,d.context,d.capability,d.regime].join('/')+'|'+d.seed_literal+'|'+(d.split??'')+'|'+(d.exclusionClass??d.class_profile??'');}
export async function verifyRun(directory,{writeReceipt=false}={}){
 const {ArtifactStore,portableArtifactName}=await import('./artifact-store-v2.mjs'),store=new ArtifactStore(directory,{limit:32*1024**3});store.check();const {decodeChunk}=await import('./chunks.mjs'),{transcriptAccumulator}=await import('./public-transcript.mjs'),{loadFixture}=await import('../p05-topic-measurements/fixture.mjs'),{makeSnapshot}=await import('../p05-topic-measurements/profiles.mjs'),f=loadFixture('.artifacts/p05-topic-measurements/fixture-checkpoint02');
 const read=name=>{portableArtifactName(name);return readFileSync(resolve(directory,name));},coordinator=JSON.parse(read('coordinator-complete.json'));assert.equal(coordinator.status,'STATISTICAL_SECTIONS_COMPLETE_REQUIRES_INDEPENDENT_VERIFIER');assert.equal(coordinator.results.length,6);assert.equal(new Set(coordinator.results.map(r=>r.section)).size,6);
 function* rows(manifest){let n=0;for(const chunk of manifest.chunks){for(const row of decodeChunk(read(chunk.path),chunk)){n++;yield row;}}assert.equal(n,manifest.records,'MANIFEST_RECORD_COUNT');}
 const reports=[];for(const ref of coordinator.results){const bytes=read(ref.path);assert.equal(hash(bytes),ref.sha256);const report=JSON.parse(bytes);assert.equal(report.section,ref.section);assertCount(report);let checked=0;const fairness=new Map(),featureDigests=new Map();
 if(report.section!=='gf'){
  const raw=rows(report.raw),expected=expectedDescriptors(report.section);let next=raw.next();
  for(const session of rows(report.sessions)){const want=expected.next();assert(!want.done,'EXTRA_SESSION');assert.deepEqual(session.descriptor,want.value,'FIXED_DESCRIPTOR_SEED_ORDER');assert.equal(session.raw.length,1075);assert(session.raw.every(Number.isFinite));assert.equal(session.actual_WS_frames,0,'MODELED_STATS_NOT_ACTUAL_WS');assert(session.planner_audit.length>=session.summary.completed_rounds&&session.planner_audit.length<=session.summary.completed_rounds+Number(Boolean(session.summary.refusal)),'PLANNED_COMPLETED_PREFIX');const snapshot=makeSnapshot(f,session.descriptor),acc=transcriptAccumulator(f.pack,snapshot.baseline.players),key=sessionKey(session);
   while(!next.done&&rawKey(next.value)===key){const row=next.value;if(row.event_kind==='CLOCK_TICK'){acc.clockTick(row.clock);}else{assert.equal(hash(Buffer.from(row.raw_serialized_UTF8)),row.raw_sha256);assert.equal(Buffer.byteLength(row.raw_serialized_UTF8),row.byte_length);assert(!row.emitted_frame&&['MODELED_HTTP','MODELED_PUBLIC'].includes(row.transport),'NO_ACTUAL_TRANSPORT_INFERENCE');const meta=acc.observe({raw:row.raw_serialized_UTF8,channel:row.channel,transport:row.transport,observed_at_ms:row.observed_at_ms,emitted_frame:false,modeled_frame:row.modeled_frame,http_status:row.http_status,operation_kind_diagnostic_only:row.operation_kind_diagnostic_only});assert.equal(meta.event_index,row.event_index);}next=raw.next();}
   const derived=acc.finish({committed_round_count:session.summary.completed_rounds,requested_rounds:session.descriptor.rounds,refused:Boolean(session.summary.refusal),unavailable_branches:session.summary.unavailable_branches});assert.deepEqual(derived.raw,session.raw,'RAW_PUBLIC_FEATURE_REPLAY');if(report.section==='fairness')auditFairnessSession(fairness,session);
   if(['social','exclusion'].includes(report.section)){const d=session.descriptor,group=[d.capability,d.prior??d.regime,d.comparison].join('/'),record={cell:[d.size,d.mode,d.context].join('/'),capability:d.capability,regime:d.regime,prior:d.prior??null,comparison:d.comparison,split:d.split,class_label:d.exclusionClass??d.class_profile,index:d.index,seed_literal:d.seed_literal,raw:session.raw,completed_rounds:session.summary.completed_rounds,requested_rounds:d.rounds,refused:Boolean(session.summary.refusal),unavailable_branches:session.summary.unavailable_branches};if(!featureDigests.has(group))featureDigests.set(group,createHash('sha256'));featureDigests.get(group).update(JSON.stringify(record)+'\n');}
   checked++;
  }assert(expected.next().done,'MISSING_FIXED_SESSIONS');assert(next.done,'EXTRA_RAW_SESSION_OR_WRONG_ORDER');assert.equal(checked,report.attempted);
 }else{const outcomes={both:0,g_only:0,f_only:0,neither:0};let i=0;for(const row of rows(report.outcomes)){assert.equal(row.index,i);assert.equal(row.seed_literal,'venus:P03-M1:gf:'+i);assert(typeof row.G==='boolean'&&typeof row.F==='boolean');outcomes[row.G?(row.F?'both':'g_only'):(row.F?'f_only':'neither')]++;i++;}assert.equal(i,1000000);const {pairedRatioCI}=await import('../p05-topic-measurements/statistics.mjs');const metric=pairedRatioCI(outcomes);assert.equal(metric.status,'PASS');assert.deepEqual(report.ci95,metric.ci95);checked=i;}
 if(report.section==='fairness')compareFairness(fairness,report.cells);
 if(['social','exclusion'].includes(report.section)){assert.equal(featureDigests.size,report.comparisons.length);const {dictionary}=await import('./public-transcript.mjs'),seen=new Set();for(const metric of report.comparisons){assert(!seen.has(metric.group));seen.add(metric.group);const expected=featureDigests.get(metric.group);assert(expected,'UNKNOWN_FEATURE_GROUP');const comparison=metric.group.split('/').at(-1),classes=report.section==='social'?[...comparison]:comparison.match(/E\d/g);assert.equal(metric.negative,classes[0]);assert.equal(metric.positive,classes[1]);assert.equal(metric.feature_count,1075);assert.equal(metric.feature_name_hash,dictionary.names_sha256_canonical_json);recomputeInference({rows:()=>rows(metric.features),scoreRows:()=>rows(metric.scores),reported:metric,names:dictionary.names,expectedFeatureDigest:expected.digest('hex')});}}
 reports.push({section:report.section,checked_fixed_rows:checked,sha256:ref.sha256,status:'MECHANICAL_VERIFICATION_PASS'});
 }
 const result={status:'MECHANICAL_VERIFICATION_PASS_REQUIRES_INDEPENDENT_ACCEPTANCE',reports,exact_counts:counts,source_identity:coordinator.source_identity,statistical_producer_executed_by_verifier:false,modeled_transcript_replay_only:true,actual_runtime_evidence_not_inferred:true,full_P05_PASS:false,human450_approval:false};if(writeReceipt)store.write('mechanical-verifier.json',JSON.stringify(result,null,2)+'\n');return result;
}
if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){const dir=process.argv.find(a=>a.startsWith('--dir='))?.slice(6);if(!dir)console.log(JSON.stringify({status:'NOT_RUN',usage:'--dir=<complete-owned-statistical-output> [--write-receipt]',mutator_or_sample_execution:false}));else console.log(JSON.stringify(await verifyRun(dir,{writeReceipt:process.argv.includes('--write-receipt')})));}
