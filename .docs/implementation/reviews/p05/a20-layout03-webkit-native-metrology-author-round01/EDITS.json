      "after": "const engine=page.context().browser().browserType().name(),browser_version=page.context().browser().version();const result={window_id:id,engine,browser_version,nominal_zoom_percent:200,measured_zoom_percent:after.dpr/before.dpr*100,native_zoom_metrology:engine==='webkit'?'WEBKIT_27_2_FIRST_SUPPORTED_207_36':'EXACT_200_ORIGINAL_TOLERANCE',before_width:before.inner_width,after_width:after.inner_width,before_dpr:before.dpr,after_dpr:after.dpr,scroll_width:after.scroll_width,css_zoom:after.css_zoom,x11_keyboard:true,isolated_browser:true,reset_verified:false,steps};"
