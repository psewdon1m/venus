  "probe-policy.mjs": [
    {
      "before": "export function assertNativeZoom(m){assert.equal(m.css_zoom,'1');assert.equal(m.before_dpr,1);assert(Math.abs(m.after_dpr/m.before_dpr-2)<=0.02,'NATIVE_200_NOT_MEASURED');assert(m.after_width<=m.before_width/1.9);assert.equal(m.scroll_width<=m.after_width+2,true);}",
      "after": "/** Nominal200 reflow: pinned WebKit27.2 first physical step is207.36%, explicitly reported. */\nexport function assertNativeScale(m,engine=m.engine){\n if(engine==='webkit'){\n  assert.equal(m.engine,engine);assert.equal(m.browser_version,'27.2');assert.equal(m.nominal_zoom_percent,200);assert.equal(m.native_zoom_metrology,'WEBKIT_27_2_FIRST_SUPPORTED_207_36');assert.equal(m.before_dpr,1);\n  assert.equal(m.measured_zoom_percent,m.after_dpr/m.before_dpr*100);assert(Math.abs(m.after_dpr/m.before_dpr-2.0736)<=0.000001,'NATIVE_200_NOT_MEASURED');\n }else assert(Math.abs(m.after_dpr/m.before_dpr-2)<=0.02,'NATIVE_200_NOT_MEASURED');\n}\nexport function assertNativeZoom(m){assert.equal(m.css_zoom,'1');assert.equal(m.before_dpr,1);assertNativeScale(m);assert(m.after_width<=m.before_width/1.9);assert.equal(m.scroll_width<=m.after_width+2,true);}"
    }
  ],
