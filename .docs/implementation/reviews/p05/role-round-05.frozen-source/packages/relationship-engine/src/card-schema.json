{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venus.example.invalid/schemas/card.v1.json",
  "title": "Venus Card v1 (DRAFT: agent-safe, 3 languages, no runtime LLM)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "pack_id",
    "mode",
    "status",
    "category",
    "interaction",
    "participants_required",
    "meeting_contexts",
    "relationship_scope",
    "min_comfort",
    "min_progression_stage",
    "consent",
    "requires_physical_contact",
    "requires_going_away",
    "required_capabilities",
    "safety_tags",
    "expected_duration_seconds",
    "text",
    "authoring"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(Q|TD|YB)-[0-9]{4}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "mode": {
      "enum": [
        "questions",
        "truth_or_dare",
        "yes_but"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "rejected"
      ]
    },
    "category": {
      "enum": [
        "icebreaker",
        "memory",
        "music",
        "friendship",
        "self_discovery",
        "affection",
        "romance",
        "together",
        "boundaries",
        "humor"
      ]
    },
    "interaction": {
      "enum": [
        "group",
        "solo",
        "pair_public",
        "pair_private"
      ]
    },
    "participants_required": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ]
    },
    "meeting_contexts": {
      "type": "array",
      "items": {
        "enum": [
          "online",
          "in_person"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "relationship_scope": {
      "enum": [
        "none",
        "acquaintance",
        "friend_or_more",
        "gentle_initiative",
        "mutual_romantic",
        "established_couple"
      ]
    },
    "min_comfort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "min_progression_stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "consent": {
      "enum": [
        "none",
        "individual",
        "bilateral"
      ]
    },
    "requires_physical_contact": {
      "type": "boolean"
    },
    "requires_going_away": {
      "type": "boolean"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "private_text_chat",
          "music_control",
          "calls"
        ]
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "safety_tags": {
      "type": "array",
      "items": {
        "enum": [
          "neutral",
          "personal",
          "romantic",
          "affection",
          "music",
          "private",
          "physical_contact"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 7
    },
    "expected_duration_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    },
    "text": {
      "type": "object",
      "required": [
        "ru",
        "en",
        "tr"
      ],
      "properties": {
        "ru": {
          "$ref": "#/$defs/localizedFields"
        },
        "en": {
          "$ref": "#/$defs/localizedFields"
        },
        "tr": {
          "$ref": "#/$defs/localizedFields"
        }
      },
      "additionalProperties": false
    },
    "authoring": {
      "$ref": "#/$defs/authoring"
    }
  },
  "$defs": {
    "cardText": {
      "type": "string",
      "minLength": 16,
      "maxLength": 350,
      "pattern": "^[^<>]*$"
    },
    "localizedFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/cardText"
        },
        "truth": {
          "$ref": "#/$defs/cardText"
        },
        "dare": {
          "$ref": "#/$defs/cardText"
        },
        "proposal": {
          "$ref": "#/$defs/cardText"
        },
        "responder": {
          "$ref": "#/$defs/cardText"
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "batch_id",
        "created_at",
        "reviewed_by",
        "reviewed_at",
        "rights_status",
        "policy_revision",
        "instruction_revision",
        "source_notes"
      ],
      "properties": {
        "origin": {
          "enum": [
            "example",
            "human",
            "agent"
          ]
        },
        "batch_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rights_status": {
          "enum": [
            "needs_review",
            "original_verified"
          ]
        },
        "policy_revision": {
          "const": "RE-1"
        },
        "instruction_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "questions"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^Q-[0-9]{4}$"
          },
          "text": {
            "type": "object",
            "required": [
              "ru",
              "en",
              "tr"
            ],
            "additionalProperties": false,
            "properties": {
              "ru": {
                "type": "object",
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "en": {
                "type": "object",
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "tr": {
                "type": "object",
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "truth_or_dare"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^TD-[0-9]{4}$"
          },
          "text": {
            "type": "object",
            "required": [
              "ru",
              "en",
              "tr"
            ],
            "additionalProperties": false,
            "properties": {
              "ru": {
                "type": "object",
                "required": [
                  "truth",
                  "dare"
                ],
                "properties": {
                  "truth": {
                    "$ref": "#/$defs/cardText"
                  },
                  "dare": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "en": {
                "type": "object",
                "required": [
                  "truth",
                  "dare"
                ],
                "properties": {
                  "truth": {
                    "$ref": "#/$defs/cardText"
                  },
                  "dare": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "tr": {
                "type": "object",
                "required": [
                  "truth",
                  "dare"
                ],
                "properties": {
                  "truth": {
                    "$ref": "#/$defs/cardText"
                  },
                  "dare": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "yes_but"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^YB-[0-9]{4}$"
          },
          "text": {
            "type": "object",
            "required": [
              "ru",
              "en",
              "tr"
            ],
            "additionalProperties": false,
            "properties": {
              "ru": {
                "type": "object",
                "required": [
                  "proposal",
                  "responder"
                ],
                "properties": {
                  "proposal": {
                    "$ref": "#/$defs/cardText"
                  },
                  "responder": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "en": {
                "type": "object",
                "required": [
                  "proposal",
                  "responder"
                ],
                "properties": {
                  "proposal": {
                    "$ref": "#/$defs/cardText"
                  },
                  "responder": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              },
              "tr": {
                "type": "object",
                "required": [
                  "proposal",
                  "responder"
                ],
                "properties": {
                  "proposal": {
                    "$ref": "#/$defs/cardText"
                  },
                  "responder": {
                    "$ref": "#/$defs/cardText"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "interaction": {
            "enum": [
              "pair_public",
              "pair_private"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interaction": {
            "const": "group"
          }
        },
        "required": [
          "interaction"
        ]
      },
      "then": {
        "properties": {
          "participants_required": {
            "const": 0
          },
          "consent": {
            "enum": [
              "none",
              "individual"
            ]
          },
          "relationship_scope": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interaction": {
            "const": "solo"
          }
        },
        "required": [
          "interaction"
        ]
      },
      "then": {
        "properties": {
          "participants_required": {
            "const": 1
          },
          "consent": {
            "enum": [
              "none",
              "individual"
            ]
          },
          "relationship_scope": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interaction": {
            "const": "pair_public"
          }
        },
        "required": [
          "interaction"
        ]
      },
      "then": {
        "properties": {
          "participants_required": {
            "const": 2
          },
          "consent": {
            "enum": [
              "bilateral"
            ]
          },
          "relationship_scope": {
            "not": {
              "const": "none"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "interaction": {
            "const": "pair_private"
          }
        },
        "required": [
          "interaction"
        ]
      },
      "then": {
        "properties": {
          "participants_required": {
            "const": 2
          },
          "consent": {
            "enum": [
              "bilateral"
            ]
          },
          "relationship_scope": {
            "not": {
              "const": "none"
            }
          }
        }
      }
    }
  ]
}
