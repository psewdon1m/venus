        "properties": {
          "round_id": {
            "type": "string",
            "format": "uuid"
          },
          "round_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "state": {
            "enum": [
              "pending",
              "active",
              "completed",
              "skipped",
              "stopped"
            ]
          },
          "kind": {
            "const": "public"
          },
          "card_id": {
            "type": "string",
            "pattern": "^TD-[0-9]{4}$"
          },
          "card_revision": {
            "type": "integer",
            "minimum": 1
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 2,
            "uniqueItems": true
          },
          "response_state": {
            "enum": [
              "pending",
              "accepted",
              "condition_proposed",
              "completed",
              "skipped"
            ]
          },
          "proposal_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mode": {
            "const": "truth_or_dare"
          },
          "text": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "prompt"
                ]
              }
            ]
          },
          "choice": {
            "enum": [
              null,
              "truth",
              "dare"
            ]
          }
        },
        "required": [
          "round_id",
          "round_index",
          "state",
          "kind",
          "card_id",
          "card_revision",
          "actors",
          "response_state",
          "proposal_revision",
          "mode",
          "text",
          "choice"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "choice": {
                  "const": null
                }
              }
            },
            "then": {
              "properties": {
                "text": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "text": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "prompt"
                  ]
                }
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "round_id": {
            "type": "string",
            "format": "uuid"
          },
          "round_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "state": {
            "enum": [
              "pending",
              "active",
              "completed",
              "skipped",
              "stopped"
            ]
          },
          "kind": {
            "const": "public"
          },
          "card_id": {
            "type": "string",
            "pattern": "^YB-[0-9]{4}$"
          },
          "card_revision": {
            "type": "integer",
            "minimum": 1
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 2,
            "uniqueItems": true
          },
          "response_state": {
            "enum": [
              "pending",
              "accepted",
              "condition_proposed",
              "completed",
              "skipped"
            ]
          },
          "proposal_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mode": {
            "const": "yes_but"
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proposal": {
                "type": "string",
