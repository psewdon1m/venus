            "enum": [
              "pending",
              "accepted",
              "condition_proposed",
              "completed",
              "skipped"
            ]
          },
          "proposal_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mode": {
            "const": "questions"
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "question"
            ]
          },
          "choice": {
            "const": null
          }
        },
        "required": [
          "round_id",
          "round_index",
          "state",
          "kind",
          "card_id",
          "card_revision",
          "actors",
          "response_state",
          "proposal_revision",
          "mode",
          "text",
          "choice"
        ]
      },
      {
        "type": "object",
