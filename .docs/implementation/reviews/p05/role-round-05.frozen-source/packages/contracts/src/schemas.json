              "responder"
            ]
          },
          "choice": {
            "const": null
          }
        },
        "required": [
          "round_id",
          "round_index",
          "state",
          "kind",
          "card_id",
          "card_revision",
          "actors",
          "response_state",
          "proposal_revision",
          "mode",
          "text",
          "choice"
        ]
      }
