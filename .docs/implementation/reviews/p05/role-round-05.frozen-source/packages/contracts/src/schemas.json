      "session_id",
      "game_rev",
      "state",
      "mode",
      "total_rounds",
      "current_round",
      "pause_reason"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "paused"
            }
          }
        },
        "then": {
          "properties": {
            "pause_reason": {
              "enum": [
                "transport",
                "safety"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "pause_reason": {
              "const": null
            }
          }
        }
