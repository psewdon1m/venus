{
  "Error": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "message": {
        "type": "string",
        "maxLength": 240
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "code",
      "message",
      "request_id"
    ]
  },
  "Member": {
