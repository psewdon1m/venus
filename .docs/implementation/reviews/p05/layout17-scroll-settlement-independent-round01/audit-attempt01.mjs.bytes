const before=readFileSync(join(parent,'real-text-probe.mjs'),'utf8'),after=readFileSync(join(producer,'real-text-probe.mjs'),'utf8'),start=after.indexOf('/** Observe keyboard-scroll settlement without scrolling or extending the cell budget. */'),end=after.indexOf('export async function measureOwnerText(');assert(start>0&&end>start);const helper=after.slice(start,end);let inverse=after.slice(0,start)+after.slice(end);inverse=inverse.replace('   await awaitTextBottom(page,budget);\n','');assert.equal(inverse,before,'literal inverse text helper');assert(!/scrollTo|scrollIntoView|keyboard\.press|setTimeout|new.*Budget|\.focus\(/.test(helper));assert.equal((after.match(/keyboard\.press\('Control\+End'\)/g)||[]).length,1);assert.equal(readFileSync(join(producer,'run.mjs'),'utf8').replace('p05-v2-layout-producer-resume17','p05-v2-layout-producer-resume16'),readFileSync(join(parent,'run.mjs'),'utf8'));
