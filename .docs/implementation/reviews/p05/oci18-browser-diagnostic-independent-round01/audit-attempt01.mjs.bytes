import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{pathToFileURL}from'node:url';import{spawnSync}from'node:child_process';import{EventEmitter}from'node:events';import vm from'node:vm';
const sha=b=>createHash('sha256').update(b).digest('hex'),read=p=>fs.readFileSync(p),pins={};function pin(p,h,parse=true){const b=read(p);if(h)assert.equal(sha(b),h,p);pins[p]={bytes:b.length,sha256:sha(b)};return parse&&p.endsWith('.json')?JSON.parse(b):b;}function packet(p,h){const ix=pin(p,h);for(const[n,v]of Array.isArray(ix.files)?ix.files.map(v=>[v.path,v]):Object.entries(ix.files))assert.equal(pin(path.join(path.dirname(p),n),v.sha256,false).length,v.bytes);return ix;}
const author='.docs/implementation/reviews/p05/compatible-rollback-author-round18',producer='.artifacts/p05-pilot-bundle-source12/.artifacts/p05-compatible-rollback-producer18',old=producer.replace('producer18','producer17'),ai=packet(author+'/INDEX.json','4cd50acedd546c93f04805e9ec30db3d8c9d441437c5372aff30037174c01519'),ix=packet(producer+'/INDEX.json','6523ff7c9a87f47c461f8047563dee11973479684f4f834f160d1f8599c24aba'),parent=packet(old+'/INDEX.json','f1fe8ccf5d12f0cc1c39f6523e0c834deb493c740697642f25cc5ae0769729e4');assert.equal(Object.keys(ai.files).length,18);assert.equal(Object.keys(ix.files).length,367);const delta=Object.keys(parent.files).filter(p=>ix.files[p]?.sha256!==parent.files[p].sha256).sort();assert.deepEqual(delta,['BINDING.json','bound-profile.mjs','browser-child.mjs']);for(const p of ['browser-child.mjs','bound-profile.mjs','BINDING.json'])assert.deepEqual(read(author+'/'+p),read(producer+'/'+p));
const source=read(producer+'/browser-child.mjs').toString(),before=read(old+'/browser-child.mjs').toString(),catchBody=source.match(/\}catch\(error\)\{(report\.error=safeError[\s\S]*?)\}\s*finally\{/)[1];let inverse=source.replace("import {safeError} from './bound-profile.mjs';\r\n",'').replace("let runtime,diagnosticStep='CHROMIUM_LAUNCH',diagnosticPhase='A1';",'let runtime;').replace(/^  diagnostic\(\)\{[^\r\n]+\r\n/m,'').replace(/diagnosticStep='[A-Z0-9_]+';/g,'').replace(/diagnosticPhase='(?:A1|B2|A3)';/g,'').replace("freshB=await (diagnosticStep='B2_FRESH_PAGE_OPEN',page(e,eActor,1001000))",'freshB=await page(e,eActor,1001000)').replace(catchBody,"report.error_name=error.name;report.status='FAIL';");assert.equal(inverse,before);assert.equal(read(producer+'/bound-profile.mjs').toString().replace("'source-proof','ipc-policy','browser-child'];","'source-proof','ipc-policy'];"),read(old+'/bound-profile.mjs').toString());
const binding=pin(producer+'/BINDING.json'),prior=pin(old+'/BINDING.json');const bd=Object.keys(binding).filter(k=>JSON.stringify(binding[k])!==JSON.stringify(prior[k]));assert.deepEqual(bd,['revision']);assert.equal(binding.source_identity,'658b710bdca35b678421a51c1c276028305f28362901b2c065a3867aa754f4de');for(const p of Object.keys(parent.files).filter(p=>p.endsWith('.mjs')&&!['bound-profile.mjs','browser-child.mjs'].includes(p)))assert.deepEqual(ix.files[p],parent.files[p]);
const{installApiQuiescence}=await import(pathToFileURL(path.resolve(producer+'/browser-child.mjs'))),{safeError}=await import(pathToFileURL(path.resolve(producer+'/bound-profile.mjs')));class Context extends EventEmitter{async route(match,cb){this.http=cb;}async routeWebSocket(match,cb){this.ws=cb;}}let leaseCalls=0,assertReject=false;const context=new Context(),gate=await installApiQuiescence(context,'SYNTHETIC_ROOM',{assert(){leaseCalls++;if(assertReject)throw Error('PRIVATE_CANARY');}});await context.http({request(){return{};},continue:async()=>{throw Error('PRIVATE_CANARY');}});const state=gate.diagnostic();assert.equal(state.failure_latched,true);assert.equal(state.held,false);assertReject=true;leaseCalls=0;assert.deepEqual(gate.diagnostic(),state);assert.equal(leaseCalls,0);assert.throws(()=>gate.release());assert.equal(gate.diagnostic().failure_latched,true);assert.equal(gate.diagnostic().held,false);
const capture=vm.compileFunction(catchBody,['error','report','safeError','diagnosticPhase','diagnosticStep','gates']);let hooks=0;const error=Object.assign(new Error('PRIVATE_CANARY'),{code:'PRIVATE_CANARY'});for(const n of ['name','message','stack'])Object.defineProperty(error,n,{configurable:true,get(){hooks++;throw Error('PRIVATE_CANARY');}});error.toJSON=()=>{hooks++;throw Error('PRIVATE_CANARY');};const report={};capture(error,report,safeError,'B2','B2_RELEASE',[gate]);assert.equal(hooks,0);assert.equal(report.error.name,'Error');assert.equal(report.error.code,null);assert.equal(report.failed_step,'B2_RELEASE');assert.equal(report.API_quiescence[0].failure_latched,true);assert(!JSON.stringify(report).includes('PRIVATE_CANARY'));assert.equal(hooks,0);
const steps=pin(author+'/controls/steps.json');assert.equal(steps.length,36);assert.deepEqual([...new Set([...source.matchAll(/diagnosticStep='([A-Z0-9_]+)'/g)].map(m=>m[1]))].sort(),[...steps].sort());assert(steps.every(s=>/^[A-Z0-9_]{1,40}$/.test(s)));const controls=[];for(const f of ['controls.mjs','prior-quiescence-controls.mjs']){const r=spawnSync(process.execPath,[author+'/controls/'+f],{encoding:'utf8'});assert.equal(r.status,0,r.stderr);controls.push({file:f,result:JSON.parse(r.stdout),exit:r.status});}assert(controls.every(c=>c.result.checks===16));
const proof=await import(pathToFileURL(path.resolve(producer+'/source-proof.mjs')));assert.deepEqual(proof.producerMap(),ix.files);const verified=await proof.verifyIncluded();assert.equal(verified.identity,binding.source_identity);assert.equal(Object.keys(verified.files).length,1869);const{validateAuthority}=await import(pathToFileURL(path.resolve(producer+'/contract.mjs')));const pending=pin(producer+'/ROOT_RUN_ACK_TEMPLATE.json');assert.equal(pending.root_run_ack,false);assert.throws(()=>validateAuthority(binding,pending,sha(read(producer+'/INDEX.json'))));assert.throws(()=>validateAuthority(binding,{},sha(read(producer+'/INDEX.json'))));for(const[p,v]of Object.entries(pins))assert.equal(sha(read(p)),v.sha256,p+' finalpin');console.log(JSON.stringify({status:'PASS_OCI18_BROWSER_DIAGNOSTIC_METHOD_ONLY_NATIVE_PENDING',at_utc:new Date().toISOString(),author_children:18,producer_children:367,changed_shared:delta,exact_functional_browser_inverse:true,boundprofile_only_static_whitelist_literal:true,other_MJS_exact:true,source_identity:verified.identity,included_files:1869,fixed_steps:36,gate_diagnostics_readonly_no_health_or_grant:true,private_hooks_not_invoked:true,pending_missing_authority_denied:true,controls,independent_adversarial_checks:2,Docker_or_browser_APP_RUN:false,OCI17_cause:'UNKNOWN',full_stage_PASS:false,pins},null,2));
