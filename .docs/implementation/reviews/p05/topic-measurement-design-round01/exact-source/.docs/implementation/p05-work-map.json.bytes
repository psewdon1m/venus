  "requirements": [
    {
      "id": "P04-UX-SKIP",
      "source_kind": "MOVED_CARD_UX",
      "requirement": "В каждом раунде и приватном предложении доступны равноправные действия «Ответить/принять» и «Пропустить/отказаться». Отказ и пропуск не требуют причины, публичного ответа, штрафа или придумывания специальной фразы; можно пропустить несколько следующих раундов.",
      "expected": null,
      "source_card_ids": [
        "Q-1017",
        "Q-1086",
        "Q-1099",
        "Q-1146",
        "TD-1019",
        "TD-1093",
