from pathlib import Path
import hashlib,json,shutil,ast,subprocess,sys,datetime
workspace=Path.cwd();historical=workspace/'.artifacts/p05-recovery-source1274-01';target=historical/'.artifacts/p05-oci-resource-feasibility-rebind01';out=workspace/'.docs/implementation/reviews/p05/oci-resource-feasibility-rebind-preparation-round01';out.mkdir(parents=True,exist_ok=True);sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
