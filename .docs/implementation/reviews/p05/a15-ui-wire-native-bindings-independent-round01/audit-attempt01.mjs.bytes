import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';import{pathToFileURL}from'node:url';import{spawnSync}from'node:child_process';const root='C:/.projects/venus',out=path.dirname(new URL(import.meta.url).pathname.replace(/^\/(\w:)/,'$1')),read=p=>fs.readFileSync(path.resolve(root,p)),sha=b=>createHash('sha256').update(b).digest('hex'),pins={};function pin(p,h,parse=true){const b=read(p);if(h)assert.equal(sha(b),h,p);pins[p]={bytes:b.length,sha256:sha(b)};return parse&&p.endsWith('.json')?JSON.parse(b):b;}
function packet(p,h){const ix=pin(p,h),rows=Array.isArray(ix.files)?ix.files.map(f=>[f.path,f]):Object.entries(ix.files);for(const[n,f]of rows){const q=path.join(path.dirname(p),n);pin(q,f.sha256,false);assert.equal(pins[q].bytes,f.bytes);}return ix;}
const author='.docs/implementation/reviews/p05/a15-ui-wire-native-bindings-author-round01',ai=packet(author+'/INDEX.json','70663e0895440fa6b0e40251b14a6fb88f6020ad295fdb61d544b544ecb7bd89'),b=pin(author+'/BINDINGS.json'),working=pin(author+'/WORKING-PINS.json');for(const key of ['browser','layout','wire'])for(const[n,f]of Object.entries(working[key].files)){const p=path.join(working[key].root,n);pin(p,f.sha256,false);assert.equal(pins[p].bytes,f.bytes);}for(const key of ['browser_wrapper','browser_pending_ACK'])pin(working[key].path,working[key].sha256,false);
const freeze=pin(b.freeze_path,b.freeze_sha256),image=pin(b.test_receipt_path,b.test_receipt_sha256),prod=pin(b.production_receipt_path,b.production_receipt_sha256);assert.equal(b.source_identity,'658b710bdca35b678421a51c1c276028305f28362901b2c065a3867aa754f4de');assert.equal(freeze.identity,b.source_identity);assert.equal(Object.keys(freeze.files).length,1869);for(const[p,h]of Object.entries(freeze.files))assert.equal(sha(read(path.join(b.source_root,p))),h,p);assert.equal(b.test_image,image.image);assert.equal(b.production_image,prod.image);for(const r of Object.values(b.reviews))packet(r.path,r.sha256);packet('.docs/implementation/reviews/p05/a15-image-host-pure-n4-preparation-independent-round01/INDEX.json','129465903374b210d6e93e29ed0898dac761424b7259de6581f8d2f34784e582');
const browser=pin(b.browser.runner).toString(),parentBrowser=pin(b.browser.parent).toString();let expected=parentBrowser;for(const[a,z]of [['sha256:d3e515f5729af2306e5e62e9b92a50fe9dbf574e8a3451f8d22031bad519ac30',b.test_image],['c481761fbecfadf77883c5ab4c8a851ab201c092b57e6994ced431dccefd4193',b.source_identity],['1865,','1869,'],['p05-browser23-a14-root-ack01.json','p05-browser23-a15-root-ack01.json']]){assert(expected.includes(a));expected=expected.replaceAll(a,z);}assert.equal(browser,expected);const browserAck=pin(b.browser.pending_ACK);assert.equal(browserAck.status,'NOT_AUTHORIZED');assert.equal(browserAck.image,b.test_image);assert.equal(browserAck.source_identity,b.source_identity);assert.equal(browserAck.runner_sha256,sha(read(b.browser.runner)));assert.equal(Object.keys(browserAck.runtime_pins).length,9);const oldBrowserAck=pin('.docs/implementation/reviews/p05/a14-ui-wire-native-bindings-author-round01/browser-pending-ACK.json');assert.deepEqual(browserAck.runtime_pins,oldBrowserAck.runtime_pins);for(const[n,h]of Object.entries(browserAck.runtime_pins))assert.equal(sha(read(path.join(b.browser.runtime_producer,n))),h,n);
const layout=b.layout.producer,oldLayout=b.layout.parent,binding=pin(path.join(layout,'binding.json')),layoutAck=pin(path.join(layout,'ROOT_RUN_ACK.json'));assert.equal(binding.source_identity,b.source_identity);assert.equal(binding.image,b.test_image);assert.equal(binding.included_files,1869);assert.equal(binding.root_build_receipt_sha256,b.test_receipt_sha256);assert.equal(binding.source_snapshot_sha256,b.freeze_sha256);assert.equal(layoutAck.root_run_ack,false);assert.equal(layoutAck.browser23_actual_PASS_prerequisite,'PENDING_ROOT_MUST_VERIFY_ON_FINAL_A15_APP');const mjs=fs.readdirSync(oldLayout).filter(n=>n.endsWith('.mjs'));assert.equal(mjs.length,27);for(const n of mjs){const prior=pin(path.join(oldLayout,n),null,false).toString(),now=pin(path.join(layout,n),null,false).toString();assert.equal(now,n==='run.mjs'?prior.replaceAll('resume10','resume11').replaceAll('FINAL_A14','FINAL_A15'):n==='runner-policy.mjs'?prior.replace('binding.included_files,1865','binding.included_files,1869'):prior,n);}for(const n of ['DESIGN.md','expected-cells.json','real-text-fixture.json'])assert(read(path.join(layout,n)).equals(pin(path.join(oldLayout,n),null,false)));
const{assertBinding,captureProducer,runtimeDigest}=await import(pathToFileURL(path.join(layout,'runner-policy.mjs')).href);const digest=runtimeDigest(captureProducer(layout));assert.equal(digest,'7e3f9d97cfde447dc0dac434cde78af55f94618abbe4e4f50bbedf79ec7e945f');assert.throws(()=>assertBinding(binding,layoutAck));const accepted={...layoutAck,root_run_ack:true,independent_producer_review:'PASS',independent_review_index_sha256:'a'.repeat(64),producer_runtime_digest:digest};assertBinding(binding,accepted);for(const x of [{included_files:1863},{source_identity:'b'.repeat(64)},{image:'sha256:'+'c'.repeat(64)}])assert.throws(()=>assertBinding({...binding,...x},accepted));
for(const n of ['runner.mjs','integration.mjs','ordinary-observation.mjs','public-wire-observer.mjs','positive.mjs','DESCRIPTOR.json'])assert(pin(path.join(b.wire.producer,n),null,false).equals(pin(path.join(b.wire.parent,n),null,false)));const wireAck=pin(path.join(b.wire.producer,'ROOT-ACK.template.json'));assert.equal(wireAck.status,'NOT_AUTHORIZED');assert.equal(wireAck.source_identity,b.source_identity);assert.equal(wireAck.image_id,b.test_image);assert.equal(wireAck.source_freeze_sha256,b.freeze_sha256);assert.deepEqual(wireAck.runtime_files,image.image_files_sha256);for(const[n,h]of Object.entries(wireAck.producer_files))assert.equal(sha(read(path.join(b.wire.producer,n))),h,n);
for(const[name,runner]of [['browser',b.browser.runner],['layout',path.join(layout,'run.mjs')],['wire',path.join(b.wire.producer,'runner.mjs')]]){const v=spawnSync(process.execPath,[runner],{cwd:b.source_root,encoding:'utf8',timeout:10000,env:{...process.env,PYTHON:root+'/.venv/Scripts/python.exe'}});assert.equal(v.error,undefined);assert.equal(v.status,1);assert.match(v.stderr,/ROOT_RUN_ACK/);fs.writeFileSync(path.join(out,name+'-pending-authority.txt'),v.stdout+v.stderr);}assert.equal(runtimeDigest(captureProducer(layout)),digest);for(const[p,d]of Object.entries(pins))assert.equal(sha(read(p)),d.sha256,p);
console.log(JSON.stringify({status:'PASS_LAYOUT_PRODUCER_METHOD_ONLY',scope:'A15_BROWSER23_LAYOUT11_WIRE05_BINDINGS_ONLY_NOT_ACTUAL',at_utc:new Date().toISOString(),source_identity:b.source_identity,image:b.test_image,producer_runtime_digest:digest,author_children:Object.keys(ai.files).length,browser_wrapper_sha256:sha(read(b.browser.runner)),browser_runtime:9,layout_other_MJS_exact:25,layout_cases:459,text_stress_receipts:324,wire_runtime_exact:5,wire_checkpoints:23,pending_authorities_denied:3,actual_RUN:false,backend_cause_or_cohort_PASS:false,APP_writes:false,pins},null,2));
