from pathlib import Path
import hashlib,json,shutil
from datetime import datetime,timezone
out=Path('.docs/implementation/reviews/p05/topic-measurement-method07-independent-review-round01');work=Path('.artifacts/p05-method07-independent-review-round01')
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
load=lambda n:json.loads((out/n).read_text('utf-8-sig'))
controls=load('native-controls.json');assert controls['status']=='PASS_INDEPENDENT_FINITE_ONLY' and controls['count']==31
win=load('windows27-author-logic-rerun.stdout.json');assert win['count']==27 and all(r['status']=='PASS' for r in win['checks'])
ack=load('ack-controls.stdout.json');assert ack['count']==4
for p in work.glob('*'):
 if p.is_file():dst=out/'exact-review-source'/(p.name+'.bytes');dst.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,dst)
report={'created_at':datetime.now(timezone.utc).isoformat(),'status':'PASS_METHOD_ONLY','new_confirmed_P1_P2':[],'inputs':load('hash-verification.json'),'own_native_controls':31,'own_ACK_denials':4,'author_logic_windows_controls_fresh_rerun':27,'all_final_exit_codes':0,'reviewer_failed_fixture_attempts_preserved':2,'unchanged_limits':{'cap_MiB':128,'reserve_GiB':10,'worker_hardwall_ms':300000,'host_extract_timeout_ms':60000,'CPU':1,'memory_MiB':1536},'extraction':controls['controls'][-1]['detail'],'actual_R100':False,'Docker_calls':0,'prepare_calls':0,'selector_invocations':0,'previous_METHOD06_attempt':'NOT_ACCEPTED_EXPORT_TIMEOUT_NATIVE_VOLUME_RETAINED','human470':'HOLD_UNCHANGED','full_P05_PASS':False,'next':'separate exact frozen preparation and root one-attempt ACK'}
(out/'report.json').write_text(json.dumps(report,indent=2)+'\n')
files=[{'path':p.relative_to(out).as_posix(),'bytes':p.stat().st_size,'sha256':sha(p)} for p in sorted(out.rglob('*')) if p.is_file() and p.name!='INDEX.json']
(out/'INDEX.json').write_text(json.dumps({'schema_version':1,'scope':'METHOD07_INDEPENDENT_METHOD_ONLY_NOT_RUN','files':files},indent=2)+'\n')
print(json.dumps({'status':'PASS_METHOD_ONLY','INDEX_sha256':sha(out/'INDEX.json'),'children':len(files),'REPORT_sha256':sha(out/'REPORT.md')}))
