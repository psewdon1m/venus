import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import {createHash} from 'node:crypto';
const root='C:/.projects/venus',old=root+'/.artifacts/p05-public-wire-adjunct05',current=root+'/.artifacts/p05-public-wire-adjunct06',read=p=>fs.readFileSync(p),sha=p=>createHash('sha256').update(read(p)).digest('hex'),before=read(old+'/integration.mjs').toString(),after=read(current+'/integration.mjs').toString(),checks=[];
const prior="await Promise.race([entered,new Promise((_,reject)=>setTimeout(()=>reject(Error('Ordinary private parent final SQL not selected')),15000))])",next="await Promise.race([Promise.all([entered,ordinary(f,actor)]),new Promise((_,reject)=>setTimeout(()=>reject(Error('Ordinary private parent final SQL not selected')),15000))])";
const check=async(name,fn)=>{await fn();checks.push(name);console.log('PASS '+name);};
await check('full_integration_inverse_is_exact_wire05_except_one_setup_expression',()=>{assert.equal(after.split(next).length,2);assert.equal(after.replace(next,prior),before);});
await check('other_four_MJS_and_fixed_descriptor_are_byteexact_wire05',()=>{for(const n of ['runner.mjs','positive.mjs','public-wire-observer.mjs','ordinary-observation.mjs','DESCRIPTOR.json'])assert.deepEqual(read(current+'/'+n),read(old+'/'+n));});
await check('ACK_denied_no_copied_active_ACK_all_native_source_and_method_pins_bound',()=>{assert(!fs.readdirSync(current).some(n=>/^ROOT-ACK\.run/.test(n)));const ack=JSON.parse(read(current+'/ROOT-ACK.template.json'));assert.equal(ack.status,'NOT_AUTHORIZED');assert.equal(ack.source_identity,'658b710bdca35b678421a51c1c276028305f28362901b2c065a3867aa754f4de');assert.equal(ack.image_id,'sha256:021a57ecd11d8e5df300a5030c78312f66c5595ebb5d97f156ab71cf7de3b689');assert.equal(Object.keys(ack.runtime_files).length,299);for(const[n,h]of Object.entries(ack.producer_files))assert.equal(sha(current+'/'+n),h);for(const[n,h]of Object.entries(ack.method_files))assert.equal(sha(current+'/'+n),h);assert.equal(ack.method_review_path,'PENDING_FRESH_WIRE06_INDEPENDENT_REVIEW');});
function body(source){const mark="await check('P05-OWS-10',async()=>{",start=source.indexOf(mark)+mark.length,end=source.indexOf('\n });',start);assert(start>mark.length&&end>start);return source.slice(start,end);}
async function execute(source,{selection=true,reconnectError=false,baselineError=false,latePrivate=false,counterZero=false}={}){
 const trace=[],actor={id:'owner',credential:'credential',wire:{frames:[]}},peer={id:'peer',credential:'peer',wire:{frames:[]}},f={room:'room',members:[actor,peer]},connection={},timers=[];let hook,finished=false,value,error;
 const held={query:async sql=>{trace.push(sql.startsWith('SELECT pg_advisory_unlock')?'unlock':'lock');},release:()=>trace.push('release')};
 const h={pool:{connect:async()=>held,query:async()=>{trace.push('observed-lock-wait');return {rowCount:1};}},setQueryHook:fn=>{hook=fn;trace.push(fn?'arm':'unarm');},call:async()=>({status:503})};
 const sandbox={assert,WeakMap,Promise,Error,hash:x=>x,h,actors:g=>g.members,freshPrivate:async()=>f,released:async g=>{trace.push('positive-baseline');if(baselineError)throw Error('MISSING_POSITIVE_PRIVATE_BASELINE');return g;},ordinary:async(g,a)=>{trace.push('ordinary-real-helper-delegation');assert.equal(g,f);assert.equal(a,actor);assert.equal(typeof hook,'function');if(reconnectError)throw Error('NATIVE_RECONNECT_FAILURE');if(selection){await hook(connection,['BEGIN']);await hook(connection,['SELECT session_id,round_id,game_rev,stream_rev FROM topic_game_private_refs',[f.room,a.id]]);const changed=await hook(connection,['SELECT s.expires_at FROM room_sessions',[a.credential,f.room]]);assert(changed[0].startsWith('SELECT pg_advisory_xact_lock(746826629) AS fixture_wait,'));trace.push('actual-query-selector-selected');}return {};},sourceFault:()=>{trace.push('source-fault');return {assertions:()=>counterZero?0:1,counters:()=>({active:1,pinned:0,assertCurrent:0}),restore:()=>trace.push('source-restored')};},pause:async ms=>{trace.push('pause:'+ms);if(ms===1300&&latePrivate)actor.wire.frames.push({stream:'private'});},until:async fn=>{assert(await fn());},privateFrames:(wire,start=0)=>wire.frames.slice(start).filter(f=>f.stream==='private'),ping:async()=>trace.push('ping'),setTimeout:(fn,ms)=>{timers.push({fn,ms});}};
 const pending=vm.runInNewContext('(async()=>{'+body(source)+'})()',sandbox);pending.then(v=>{finished=true;value=v;},e=>{finished=true;error=e;});
 for(let n=0;n<100&&!finished;n++)await Promise.resolve();
 if(!finished){assert.equal(timers.length,1);assert.equal(timers[0].ms,15000);timers[0].fn();for(let n=0;n<100&&!finished;n++)await Promise.resolve();}
 assert(finished);return {trace,value,error,timers:timers.map(x=>x.ms)};
}
await check('wire05_no_transition_reproduces_selector_timeout_before_fault',async()=>{const r=await execute(before);assert.match(r.error.message,/Ordinary private parent final SQL not selected/);assert(!r.trace.includes('source-fault'));assert(!r.trace.includes('ordinary-real-helper-delegation'));assert(r.trace.includes('unlock'));assert(r.trace.includes('release'));});
await check('wire06_after_arm_delegates_one_reconnect_selects_wait_then_same_fault_oracle',async()=>{const r=await execute(after);assert.equal(r.error,undefined);assert.equal(r.trace.filter(x=>x==='ordinary-real-helper-delegation').length,1);assert(r.trace.indexOf('arm')<r.trace.indexOf('ordinary-real-helper-delegation'));assert(r.trace.indexOf('observed-lock-wait')<r.trace.indexOf('source-fault'));assert(r.trace.indexOf('source-fault')<r.trace.indexOf('unlock'));assert(r.trace.includes('source-restored'));assert.equal(r.value.actual_pg_lock_wait,true);assert.equal(r.value.no_private_after_wait,true);assert.equal(r.value.ordinary_room_ws_survived,true);assert.deepEqual(r.timers,[15000]);});
await check('reconnect_failure_not_retried_or_hidden_unlocks_without_source_fault',async()=>{const r=await execute(after,{reconnectError:true});assert.match(r.error.message,/NATIVE_RECONNECT_FAILURE/);assert.equal(r.trace.filter(x=>x==='ordinary-real-helper-delegation').length,1);assert(!r.trace.includes('source-fault'));assert(r.trace.includes('unlock'));assert(r.trace.includes('release'));});
await check('no_selected_private_ref_remains_setupFAIL_same15s_not_laundered',async()=>{const r=await execute(after,{selection:false});assert.match(r.error.message,/Ordinary private parent final SQL not selected/);assert.deepEqual(r.timers,[15000]);assert(!r.trace.includes('source-fault'));});
await check('missing_prior_positive_private_baseline_still_fails_before_hook',async()=>{const r=await execute(after,{baselineError:true});assert.match(r.error.message,/MISSING_POSITIVE_PRIVATE_BASELINE/);assert(!r.trace.includes('arm'));assert(!r.trace.includes('ordinary-real-helper-delegation'));});
await check('post_wait_private_frame_still_fails_original_zero_private_oracle',async()=>{const r=await execute(after,{latePrivate:true});assert.equal(r.error.code,'ERR_ASSERTION');assert(r.trace.includes('source-restored'));});
await check('missing_actual_source_fault_assertion_still_fails_original_oracle',async()=>{const r=await execute(after,{counterZero:true});assert.equal(r.error.code,'ERR_ASSERTION');assert(r.trace.includes('source-restored'));});
console.log(JSON.stringify({status:'PASS_FINITE_SETUP_DELEGATION_NOT_NATIVE_DISPATCH_OR_AUTH',checks:checks.length,checks_detail:checks,no_Docker:true,no_APP_edits:true,no_active_ACK:true}));
