/** Invokes the actual production ticker callback at preregistered barriers. */
import assert from 'node:assert/strict';
export function pollRegistry(){const entries=new Map();let barriers=0;return{register(socket,callback){assert.equal(typeof callback,'function');assert(!entries.has(socket));assert(entries.size<8,'NO_NINTH_OBSERVER');entries.set(socket,callback);socket.once('close',()=>entries.delete(socket));return{unref(){}};},async barrier(){barriers++;for(const[socket,callback]of [...entries]){assert.equal(socket.readyState,1,'ACTUAL_WS_CLOSED');await callback();assert.equal(socket.readyState,1,'ACTUAL_WS_POLL_FAILED');}return{barrier:barriers,actual_callbacks:entries.size};},get size(){return entries.size;}};}
