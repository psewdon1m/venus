/** Synthetic canaries only. No Docker/PG or statistical selector run. */
import assert from 'node:assert/strict';
import {mkdtempSync,rmSync} from 'node:fs';
import {join,dirname,resolve} from 'node:path';
import {tmpdir} from 'node:os';
import {failureLedger} from './failure-ledger.mjs';
import {durableSink} from './durable-sink.mjs';
import {safeError,safeWorkerStop} from './safe-metadata.mjs';
import {confirmStop} from './owned-worker.mjs';
const owner='a'.repeat(32),results=[],root=mkdtempSync(join(tmpdir(),'venus-stats03b-privacy-'));
function check(name,fn){fn();results.push({name,status:'PASS'});}
const clean=(row)=>assert(!JSON.stringify(row).includes('PRIVATE_'));
try{
 check('exact prior raw-stop counterexample is projected',()=>{let text;const ledger=failureLedger(owner,{send:x=>text=x});ledger.record(Error('PRIVATE_FIRST'), 'execution');ledger.emit('STOP_FAILED',{status:'STOP_FAILED',worker_unconfirmed:true,errors:['PRIVATE_WORKER_STOP_CANARY'],first_stop_failure:'PRIVATE_FIRST_STOP_CANARY',nested:{secret:'PRIVATE_UNKNOWN'}});const row=JSON.parse(text);clean(row);assert.equal(row.worker_stop.status,'STOP_FAILED');assert.equal(row.worker_stop.worker_unconfirmed,true);assert.equal(row.worker_stop.first_stop_failure_present,true);assert.equal(row.worker_stop.error_categories[0],'UNLISTED');assert.equal(row.worker_stop.metadata_unlisted,true);});
 check('exact prior sink arbitrary-name/code counterexample is projected and cause retained',()=>{let reject=false;const fault=Object.assign(Error('PRIVATE_MSG'),{name:'PRIVATE_SINK_NAME_CANARY',code:'PRIVATE_SINK_CODE_CANARY'}),sink=durableSink(join(root,'poison'),{owner,guard:()=>{if(reject)throw fault;}});reject=true;assert.throws(()=>sink.append('features',{}),e=>e===fault);const row=sink.abort();clean(row);assert.equal(row.poisoned,true);assert.equal(row.first_error.metadata_unlisted,true);assert.equal(sink.fault,fault);assert.throws(()=>sink.append('features',{}),e=>e.cause===fault);});
 check('first and secondary ordering/cause equality survives projection',()=>{let text;const l=failureLedger(owner,{send:x=>text=x}),first=Error('PRIVATE_A'),second=Object.assign(Error('PRIVATE_B'),{code:'ENOSPC'});assert.equal(l.record(first,'execution'),first);assert.equal(l.record(second,'worker-stop'),first);l.emit('STOP_FAILED',{status:'STOP_FAILED',worker_unconfirmed:true});const r=JSON.parse(text);clean(r);assert.equal(l.firstError,first);assert.equal(r.first_failure.stage,'execution');assert.equal(r.secondary_failures[0].stage,'worker-stop');assert.equal(r.secondary_failures[0].code,'ENOSPC');});
 for(const status of ['STOP_CONFIRMED','EXIT_CONFIRMED','STOP_CONFIRMED_WITH_MANAGER_FAILURE'])check('normal native fields '+status,()=>{const t={kind:'TERMINAL',owner,status,active_processes:0,worker_code:137,stop_requested:true,errors:[],job_destroyed:true},r=safeWorkerStop(t,owner);assert.equal(r.status,status);assert.equal(r.owner,owner);assert.equal(r.confirmed,true);assert.equal(r.worker_code,137);assert.equal(r.stop_requested,true);assert.equal(r.job_destroyed,true);assert.equal(r.errors_count,0);assert.equal(r.metadata_unlisted,false);if(status!=='STOP_CONFIRMED_WITH_MANAGER_FAILURE')assert.equal(confirmStop({code:0,error:null,terminal:t},owner),t);});
 check('STOP_FAILED remains a fault even with native zero',()=>{const t={owner,status:'STOP_FAILED',active_processes:0,worker_unconfirmed:false},r=safeWorkerStop(t,owner);assert.equal(r.confirmed,false);assert.equal(r.status,'STOP_FAILED');assert.throws(()=>confirmStop({code:0,error:null,terminal:t},owner));});
 for(const [label,patch] of [['wrong owner',{owner:'b'.repeat(32)}],['unknown owner',{owner:'PRIVATE_OWNER'}],['malformed count',{active_processes:'0'}],['oversize count',{active_processes:33}],['negative count',{active_processes:-1}],['NaN count',{active_processes:NaN}],['malformed bool',{worker_unconfirmed:'false'}],['unknown status',{status:'PRIVATE_STATUS'}]])check('invalid confirmation '+label,()=>{const r=safeWorkerStop({owner,status:'STOP_CONFIRMED',active_processes:0,...patch},owner);clean(r);assert.equal(r.confirmed,false);assert.equal(r.metadata_unlisted,true);});
 check('huge unknown/nested fields bounded and never copied',()=>{const r=safeWorkerStop({owner,status:'STOP_FAILED',active_processes:1,errors:Array(20000).fill({kind:'PRIVATE_KIND',nested:'PRIVATE_PAYLOAD'}),first_stop_failure:'PRIVATE_FIRST'.repeat(5000),unknown:'PRIVATE_UNKNOWN'.repeat(5000)},owner);clean(r);assert.equal(r.error_categories.length,16);assert.equal(r.errors_count,16);assert.equal(r.errors_truncated,true);assert(JSON.stringify(r).length<2000);});
 check('typed known categories survive; native errors never copy nested details',()=>{const r=safeWorkerStop({owner,status:'STOP_FAILED',active_processes:1,errors:[{kind:'TERMINATE_JOB_FAILED',winerror:5,detail:'PRIVATE_EXTRA'},{kind:'INVALID_OR_CLOSED_OWNER_CONTROL'}]},owner);clean(r);assert.deepEqual(r.error_categories,['TERMINATE_JOB_FAILED','INVALID_OR_CLOSED_OWNER_CONTROL']);});
 check('missing/array/primitives are explicit unavailable, never raw',()=>{for(const v of [undefined,null,'PRIVATE_VALUE',42,[]]){const r=safeWorkerStop(v,owner);clean(r);assert.equal(r.confirmed,false);assert.equal(r.metadata_unlisted,true);assert.equal(r.status,'UNLISTED');}});
 check('metadata getters never run or leak',()=>{const input={};let called=0;for(const k of ['status','owner','errors','first_stop_failure','name','code'])Object.defineProperty(input,k,{get(){called++;throw Error('PRIVATE_GETTER');}});clean(safeWorkerStop(input,owner));clean(safeError(input));assert.equal(called,0);});
 check('sink and ledger share one error whitelist',()=>{for(const code of ['EIO','ENOSPC','EDQUOT','EACCES','ERR_ASSERTION'])assert.equal(safeError(Object.assign(Error('PRIVATE_TEXT'),{code})).code,code);const r=safeError({name:'PRIVATE_NAME',code:'PRIVATE_CODE'});clean(r);assert.deepEqual(r,{name:'Error',code:null,metadata_unlisted:true});});
 check('oversized ledger secondary errors remain capped with original first fault',()=>{let text;const l=failureLedger(owner,{send:x=>text=x}),first=Error('PRIVATE_FIRST');l.record(first,'execution');for(let i=0;i<25;i++)l.record(Error('PRIVATE_SECOND'),'worker-stop');l.emit('STOP_FAILED',null);const r=JSON.parse(text);clean(r);assert.equal(r.secondary_failures.length,16);assert.equal(r.dropped_secondary_failures,9);assert.equal(l.firstError,first);});
}finally{assert.equal(dirname(resolve(root)),resolve(tmpdir()));assert(root.startsWith(join(resolve(tmpdir()),'venus-stats03b-privacy-')));rmSync(root,{recursive:true,force:true});}
console.log(JSON.stringify({status:'PASS_AUTHOR_PRIVACY_FINITE_ONLY',count:results.length,results,Docker_calls:0,statistical_RUN:false},null,2));
