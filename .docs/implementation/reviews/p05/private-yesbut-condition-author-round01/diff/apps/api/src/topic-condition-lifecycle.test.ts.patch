+import {describe,it,expect,vi} from 'vitest';
+import {applyPrivateConversation,consentResponse,digest,proposeConsent,type PrivateConversation} from '@venus/relationship-engine';
+import {TopicGames} from './topic-games.js';
+import type {Rooms} from './rooms.js';
+import type {StoredConversation} from './topic-game-model.js';
+
+/** Native API lifecycle/FSM; persistence, target authorization and transactions
+ * are explicit doubles. This is not PostgreSQL/transport acceptance. */
+function fixture(interaction='pair_private'){
+ let now=1000,member='bob';
+ const games=new TopicGames({now:()=>now,options:{}} as unknown as Rooms,{enabled:true,privateTextChat:true,
+  source:{active:async()=>null,pinned:async()=>{throw Error('unused');},assertCurrent:()=>{}},
+  safety:{read:async()=>{throw Error('unused');},excludeLocked:async()=>{throw Error('unused');},assertCurrent:()=>{}}});
+ const actors=['alice','bob'];let invitation=proposeConsent('invitation',actors,'invitation',now);
+ for(const id of actors)invitation=consentResponse(invitation,id,'accept',now,{offer_id:'invitation',scope:'invitation',proposal_revision:1});
+ const card={id:'YB-TEST',revision:1,mode:'yes_but',text:Object.fromEntries(['ru','en','tr'].map(locale=>[locale,{proposal:'Synthetic proposal',responder:'Synthetic responder'}]))};
+ const data={plan:{interaction,actors,primary_member_id:'alice',requires_action_consent:true,card:{card_id:card.id,card_revision:1,card_sha256:digest(card)}},
+  state:'pending',boot_id:games.bootId,clock_floor:1000,invitation,action:null,choice:null,condition:null,content_revision:1,conversation_id:'conversation'};
+ const game={id:'session',room_id:'room',rev:'3',mode:'yes_but',state:'active'},row={id:'round'},
+  map={pins:{map_sha256:'2'.repeat(64),taxonomy_digest:'3'.repeat(64)},topics:[{topic_id:'creative',labels:{ru:'Творчество',en:'Creative',tr:'Yaratıcılık'}}],entry:()=>({topic_ids:['creative']})},
+  safety={members:actors.map(member_id=>({member_id,revision:1,allow_topic_ids:['creative'],excluded_topic_ids:[]}))},
+  loaded={game,row,data,map,safety,snapshot:{baseline:{context:'online',capabilities:['private_text_chat']}},pack:{digest:'1'.repeat(64),card:()=>card}};
+ let stored:StoredConversation|null=null;
+ const saveConversation=vi.fn(async(_c:unknown,_l:unknown,state:PrivateConversation,bindings:StoredConversation['bindings'])=>{stored={schema_version:2,state,bindings};});
+ const saveRound=vi.fn(),unpack=Reflect.get(games,'unpack'),auth=()=>({member:{id:member},room:{id:'room',rev:'1'}});
+ Object.assign(games,{mutation:async(...args:unknown[])=>(args.at(-1) as (c:unknown,a:unknown)=>unknown)({},auth()),target:async()=>loaded,
+  actor:async(_c:unknown,_g:unknown,_r:unknown,id:string,role?:string)=>{if(!actors.includes(id)||role&&id!==(role==='secondary'?'bob':'alice'))throw Error('ROUND_ACTOR_REQUIRED');},
+  conversation:async()=>stored?unpack.call(games,stored,loaded):null,saveConversation,saveRound});
+ return {games,data,game,saveConversation,saveRound,get stored(){return stored;},setNow:(n:number)=>now=n,setMember:(id:string)=>member=id,
+  begin:()=>Reflect.get(games,'beginConversation').call(games,{},loaded),
+  command:(text='Synthetic condition')=>games.condition('room','credential','session','round',{request_id:'request',expected_rev:3,text}),
+  finish:()=>games.finish('room','credential','session','round',{request_id:'request',expected_rev:3}),
+  own:()=>Reflect.get(games,'selfActionsValue').call(games,auth(),{g:game,r:{row,data},member:true,host:false,role:member==='bob'?'secondary':'primary',ordinary:true,l:loaded,conv:stored?unpack.call(games,stored,loaded):null},true),
+  acceptTopics:()=>{for(const actor of actors){const o=stored!.state.offer!,r=applyPrivateConversation(stored!.state,{kind:'respond_topic',offer_id:o.offer_id,epoch:o.epoch,proposal_revision:o.proposal_revision,token:o.token,decision:'accept'},{scope:stored!.state.scope,actor,now});expect(r.error).toBeNull();stored={...stored!,state:r.state};}}
+ };
+}
+
+describe('private YesBut condition is required content, not a premature replacement',()=>{
+ it('does not create a topic offer before the first condition',async()=>{const f=fixture();await f.begin();expect(f.stored).toBeNull();expect(f.saveConversation).not.toHaveBeenCalled();expect(f.own().round_actions).toMatchObject({propose_condition:true,finish:false,accept_action:false});});
+ it('creates the first offer immediately from the first condition with zero acknowledgements',async()=>{const f=fixture();await expect(f.command()).resolves.toMatchObject({schema_version:2,game_rev:3});expect(f.data.condition).toMatchObject({revision:1,text:'Synthetic condition'});expect(f.stored?.state).toMatchObject({topic_attempts:1,last_offer_at:1000,offer:{state:'pending',acks:[]}});expect(f.stored?.bindings).toHaveLength(1);expect(f.stored?.bindings[0]?.condition).toBe('Synthetic condition');expect(f.data.action).toBeNull();expect(f.own().round_actions).toMatchObject({propose_condition:false,finish:false,accept_action:false});});
+ it('rejects a private finish without the required condition',async()=>{const f=fixture();f.setMember('alice');await expect(f.finish()).rejects.toMatchObject({code:'CONDITION_REQUIRED'});expect(f.saveRound).not.toHaveBeenCalled();});
+ it('refuses an early edit before any content, consent, binding or epoch change',async()=>{const f=fixture();await f.command();f.acceptTopics();f.setNow(5999);const before=JSON.stringify({data:f.data,stored:f.stored});f.saveConversation.mockClear();f.saveRound.mockClear();expect(f.own().round_actions.propose_condition).toBe(false);await expect(f.command('Too early')).resolves.toMatchObject({deferred_error:'RATE_LIMIT',status:409});expect(JSON.stringify({data:f.data,stored:f.stored})).toBe(before);expect(f.saveConversation).not.toHaveBeenCalled();expect(f.saveRound).not.toHaveBeenCalled();});
+ it('at exactly five seconds replaces content with a new topic and fresh action consent requirement',async()=>{const f=fixture();await f.command();f.acceptTopics();const old=f.stored!.state.offer!;Reflect.set(f.data,'action',proposeConsent('old-action',['alice','bob'],'action',1000,181000));f.setNow(6000);expect(f.own().round_actions.propose_condition).toBe(true);await f.command('Changed condition');expect(f.stored?.state.offer?.epoch).toBeGreaterThan(old.epoch);expect(f.stored?.state.offer).toMatchObject({state:'pending',acks:[]});expect(f.data.condition).toMatchObject({revision:2,text:'Changed condition'});expect(f.data.action).toBeNull();expect(f.stored?.bindings).toHaveLength(2);expect(f.own().round_actions).toMatchObject({finish:false,accept_action:false});const stale=applyPrivateConversation(f.stored!.state,{kind:'respond_topic',offer_id:old.offer_id,epoch:old.epoch,proposal_revision:old.proposal_revision,token:old.token,decision:'accept'},{scope:f.stored!.state.scope,actor:'alice',now:6000});expect(stale.error).toBe('STALE');});
+ it('keeps the three-attempt cap and refuses the fourth condition without mutation',async()=>{const f=fixture();await f.command();for(const now of [6000,11000]){f.setNow(now);await f.command('Edit '+now);}f.setNow(16000);expect(f.stored?.state.topic_attempts).toBe(3);const before=JSON.stringify({data:f.data,stored:f.stored});expect(f.own().round_actions.propose_condition).toBe(false);await expect(f.command('Fourth')).resolves.toMatchObject({deferred_error:'LIMIT',status:409});expect(JSON.stringify({data:f.data,stored:f.stored})).toBe(before);});
+ it('keeps primary-actor input denied',async()=>{const f=fixture();f.setMember('alice');expect(f.own().round_actions.propose_condition).toBe(false);await expect(f.command()).rejects.toThrow('ROUND_ACTOR_REQUIRED');expect(f.saveConversation).not.toHaveBeenCalled();});
+ it('retains the independent three-binding cap before mutating a condition',async()=>{const f=fixture();await f.command();f.stored!.bindings.push(f.stored!.bindings[0]!,f.stored!.bindings[0]!);f.setNow(6000);const before=JSON.stringify({data:f.data,stored:f.stored});expect(f.own().round_actions.propose_condition).toBe(false);await expect(f.command('Bounded')).rejects.toMatchObject({code:'TOPIC_ATTEMPT_LIMIT'});expect(JSON.stringify({data:f.data,stored:f.stored})).toBe(before);});
+ it('can edit after a safety cancellation left no current offer without bypassing its cooldown',async()=>{const f=fixture();await f.command();const state=f.stored!.state,o=state.offer!,cancelled=applyPrivateConversation(state,{kind:'other_question',offer_id:o.offer_id,epoch:o.epoch,proposal_revision:o.proposal_revision,token:o.token,exclude_current_topics:false},{scope:state.scope,actor:'bob',now:1001});expect(cancelled.error).toBeNull();Reflect.set(f.stored!,'state',cancelled.state);f.setNow(5999);await expect(f.command('Early after cancel')).resolves.toMatchObject({deferred_error:'RATE_LIMIT'});f.setNow(6000);await f.command('New after cancel');expect(f.stored!.state).toMatchObject({topic_attempts:2,offer:{state:'pending',acks:[]}});expect(f.data.action).toBeNull();});
+ it('throws a late native expiry into the existing savepoint rollback path instead of returning Deferred partial content',async()=>{const f=fixture();await f.command();let reads=0;Object.assign(f.games.rooms,{now:()=>++reads<3?6000:181000});await expect(f.command('Expiry during edit')).rejects.toMatchObject({code:'CLOSED'});});
+ it('preserves the immediate public-pair condition path',async()=>{const f=fixture('pair_public');await f.command();expect(f.data.condition).toMatchObject({revision:1});expect(f.data.action).toMatchObject({scope:'action',created_at:1000,acks:[]});expect(f.saveConversation).not.toHaveBeenCalled();expect(f.own().round_actions.propose_condition).toBe(true);});
+});
