 base=workspace/directory;proof=workspace/'.docs/implementation/evidence/p05'/freeze;manifest=json.loads((proof/'inputs.json').read_bytes());index=json.loads((proof/'index.json').read_bytes());archive=proof/'included-source.zip';assert manifest['identity']==wanted;assert sha(archive)==archivewanted==index['archive_sha256']
 receipt=json.loads((workspace/'.artifacts'/receiptname).read_bytes());assert receipt['source_identity']==wanted
 with zipfile.ZipFile(archive)as z:
  names=z.namelist();assert len(names)==len(set(names))==1813;assert set(names)==set(manifest['files'])
  for n in names:
   p=PurePosixPath(n);assert not p.is_absolute()and'..'not in p.parts and':'not in n and'\\'not in n;assert hashlib.sha256(z.read(n)).hexdigest()==manifest['files'][n]
  if label=='B':
   assert not base.exists(),'B destination already exists; never overwrite';base.mkdir()
   for n in names:
    target=base/n;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(z.read(n))
   for n,h in receipt['host_compiled_files_sha256'].items():
    src=workspace/n;assert sha(src)==h;target=base/n;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src,target)
 actual=inventory(base);assert actual==manifest['files'];assert identity(actual)==wanted
 for n,h in receipt['host_compiled_files_sha256'].items():assert sha(base/n)==h
 contexts[label]={'root':str(base),'qualification':'INDEPENDENT_VERIFIED_ROOT_A_CONTEXT'if label=='A'else'AUTHOR_PREPARED_B_CONTEXT_REQUIRES_SEPARATE_REVIEW','source_identity':wanted,'included_files':len(actual),'archive_sha256':archivewanted,'legacy_image':receipt['image'],'compiled64_copied_and_verified_not_fresh_build':len(receipt['host_compiled_files_sha256']),'dockerfile_sha256':sha(base/'infra/venus/Dockerfile.p05-tests'),'dockerignore_sha256':sha(base/'infra/venus/Dockerfile.p05-tests.dockerignore'),'immutable_archive_verified_every_entry':True,'build_or_pull_executed_by_agent':False}
 plan={'created_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'HISTORICAL_BUILD_CONTEXTS_VERIFIED_NO_NEW_IMAGE_PROOF','contexts':contexts,'new_images_must_get_new_digests_and_receipts':True,'current_live_stage_qualification':False,'no_stage_inventory_change':True,'Docker_calls':0}
