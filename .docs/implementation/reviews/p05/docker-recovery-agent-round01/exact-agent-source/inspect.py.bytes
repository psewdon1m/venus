from pathlib import Path
import subprocess,json,datetime
out=Path('.docs/implementation/reviews/p05/docker-recovery-agent-round01/raw');out.mkdir(parents=True,exist_ok=True)
docker=r'C:\Program Files\Docker\Docker\resources\bin\docker.exe';rows=[]
commands=[['info','--format','{{json .ServerVersion}} {{json .ID}} {{json .Name}} {{json .DockerRootDir}}'],['image','inspect','sha256:ff371010e110cbcc56e029d8396f1195bbcb8b41866ba9e1be73dde2b6da09c4','--format','{{json .Id}}'],['image','inspect','sha256:5e30414ad64516422b61f630aa37639fb1920e795e2c7008752131a5c961647e','--format','{{json .Id}}'],['image','inspect','postgres:16.14-bookworm@sha256:64154d0babcb1741988719e703419af0382b19953706149f9872fbd0f438efa8','--format','{{json .Id}} {{json .RepoDigests}}']]
for args in commands:
 try:
  r=subprocess.run([docker,'--context','desktop-linux',*args],capture_output=True,timeout=10);assert len(r.stdout)+len(r.stderr)<65536;rows.append({'args':args,'exit_code':r.returncode,'stdout':r.stdout.decode('utf8','replace'),'stderr':r.stderr.decode('utf8','replace')})
 except subprocess.TimeoutExpired:rows.append({'args':args,'exit_code':'TIMEOUT10s'})
value={'at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'read_only':True,'commands':rows}
(out/'daemon-after-restart.json').write_text(json.dumps(value,indent=2)+'\n');print(json.dumps(value,indent=2))
