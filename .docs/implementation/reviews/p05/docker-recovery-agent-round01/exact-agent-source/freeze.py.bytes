from pathlib import Path
import hashlib,json,shutil,datetime
out=Path('.docs/implementation/reviews/p05/docker-recovery-agent-round01');work=Path('.artifacts/p05-docker-recovery-agent01');sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
for p in work.iterdir():
 if p.is_file():q=out/'exact-agent-source'/(p.name+'.bytes');q.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,q)
daemon=json.loads((out/'raw/daemon-after-restart.json').read_text('utf-8-sig'));assert daemon['commands'][0]['exit_code']==0
r={'created_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'DOCKER_DAEMON_RECOVERED_HISTORICAL_IMAGES_MISSING_REBIND_REQUIRED','daemon':daemon,'recovery':'samequietstopcycle reversiblemovesoftwoproven0bytesocketonlyparents','no_manual_docker_data_or_credential_edits':True,'no_factory_reset_prune_delete_upgrade':True,'agent_build_pull_calls':0,'Docker_ownership':'RETURNED_TO_ROOT_FOR_SEPARATELY_AUTHORIZED_BUILD_PULL','contexts':json.loads((out/'contexts-verification-and-B-preparation.json').read_bytes()),'full_current_source_acceptance':False,'human470':'HOLD_UNCHANGED','full_P05_PASS':False,'next':'newrootimages/independentreceipts/rebindreview/freshACKs; Bcontextauthorprepneedsdifferentacceptor'}
(out/'report.json').write_text(json.dumps(r,indent=2)+'\n');files=[{'path':p.relative_to(out).as_posix(),'bytes':p.stat().st_size,'sha256':sha(p)}for p in sorted(out.rglob('*'))if p.is_file()and p.name!='INDEX.json'];(out/'INDEX.json').write_text(json.dumps({'schema_version':1,'scope':'REVERSIBLE_DOCKER_SOCKET_RECOVERY_AND_HISTORICAL_CONTEXT_PROVENANCE_NO_IMAGE_BUILD','files':files},indent=2)+'\n');print(json.dumps({'status':r['status'],'INDEX_sha256':sha(out/'INDEX.json'),'children':len(files),'REPORT_sha256':sha(out/'REPORT.md')}))
