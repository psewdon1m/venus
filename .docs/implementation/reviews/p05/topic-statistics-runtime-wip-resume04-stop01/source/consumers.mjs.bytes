import assert from 'node:assert/strict';
import {pairedRatioCI} from '../p05-topic-measurements/statistics.mjs';
import {cell,orderedCoverage} from './protocol.mjs';
export function sessionConsumer(section){
 const coverage=orderedCoverage(section),cells=new Map(),invariants=new Map();let refusal=0,violations=0;
 return{add(record){const d=record.descriptor;coverage.add(d);const key=cell(d),r=cells.get(key)??{key,size:d.size,sessions:0,completed_rounds:0,requested_rounds:0,refusals:0,K:0,D:0,Kprivate:0,invitations:Array(d.size).fill(0),max_individual_session_share:0,zero_pair_sessions:0,early_private:0,strict_anti_repeat_violations:0,cap_violations:0,diagnostic_violations:0,late_eligible:0,late_selected:0,stages:{}};
  const s=record.summary,c=record.counts,diag=record.diagnostics;assert(Number.isInteger(s.completed_rounds)&&s.completed_rounds>=0&&s.completed_rounds<=d.rounds);assert.equal(s.requested_rounds,d.rounds);assert(['COMPLETE','SAFE_REFUSAL'].includes(s.status));
  r.sessions++;r.completed_rounds+=s.completed_rounds;r.requested_rounds+=d.rounds;if(s.status==='SAFE_REFUSAL'){r.refusals++;refusal++;}
  if(section==='C2_negative')assert.equal(s.status,'SAFE_REFUSAL','EXPECTED_NEGATIVE_SAFE_REFUSAL');
  else if(s.status!=='COMPLETE'||s.completed_rounds!==d.rounds)violations++;
  assert.equal(c.invitations.length,d.size);assert(c.invitations.every(x=>Number.isSafeInteger(x)&&x>=0));assert(Number.isSafeInteger(c.K)&&c.K>=0&&Number.isSafeInteger(c.Kprivate)&&c.Kprivate>=0&&c.Kprivate<=c.K,'INVALID_PAIR_COUNTS');assert.equal(c.D,2*c.K);assert.equal(c.invitations.reduce((a,b)=>a+b,0),c.D);assert.equal(diag.status,'PASS','SESSION_DIAGNOSTICS_NOT_PASS');
  r.K+=c.K;r.D+=c.D;r.Kprivate+=c.Kprivate;r.early_private+=c.earlyPrivate;r.cap_violations+=Number(c.Kprivate>Math.ceil(.25*d.rounds));
  if(c.D)r.max_individual_session_share=Math.max(r.max_individual_session_share,...c.invitations.map(x=>x/c.D));else r.zero_pair_sessions++;
  for(let i=0;i<d.size;i++)r.invitations[i]+=c.invitations[i];
  r.strict_anti_repeat_violations+=diag.counters.strict_anti_repeat_violations;r.diagnostic_violations+=diag.violations.length;
  for(const[stage,value]of Object.entries(diag.stages)){const target=r.stages[stage]??={rounds:0,private_eligible_after_cap:0,private_selected:0,empty_selected:0};for(const[k,v]of Object.entries(value))target[k]+=v;if(Number(stage)>=3){r.late_eligible+=value.private_eligible_after_cap;r.late_selected+=value.private_selected;}}
  assert.deepEqual(record.invariants.rows.map(r=>r.id).sort(),Array.from({length:15},(_,i)=>'I'+String(i+1).padStart(2,'0')));for(const inv of record.invariants.rows){assert(Number.isSafeInteger(inv.checks)&&inv.checks>=0&&Number.isSafeInteger(inv.violations)&&inv.violations>=0);const target=invariants.get(inv.id)??{id:inv.id,checks:0,violations:0,runtime_evidence_required:inv.runtime_evidence_required};target.checks+=inv.checks;target.violations+=inv.violations;invariants.set(inv.id,target);}
  cells.set(key,r);
 },finish(){const totals=coverage.finish(),rows=[...cells.values()].map(r=>{
   const shares=r.D?r.invitations.map(x=>x/r.D):[],gap=r.D?Math.max(...shares)-Math.min(...shares):null,privateSupported=!r.key.includes('/online/DEFAULT_OFF/');
   const fairness=section==='fairness',nondegenerate=!fairness||!privateSupported||(r.late_eligible>0&&r.late_selected>0);
   return{...r,individual_shares:shares,aggregate_player_share_gap:gap,nondegenerate_private:nondegenerate,status:!r.early_private&&!r.cap_violations&&!r.strict_anti_repeat_violations&&!r.diagnostic_violations&&(!fairness||(r.D>0&&r.max_individual_session_share<=.5&&gap<=.02&&nondegenerate))?'PASS':'FAIL'};
  });const inv=[...invariants.values()];return{section,status:totals.status==='COMPLETE'&&!violations&&rows.every(r=>r.status==='PASS')&&inv.every(r=>r.violations===0)?'PASS_PURE_STATISTICAL_SECTION_ONLY':'NOT_ACCEPTED',coverage:totals,retained_refusals:refusal,unexpected_incomplete_sessions:violations,cells:rows,invariants:inv,I14:'SEPARATE_ACTUAL_RUNTIME_CLOSE_REQUIRED',full_P05_PASS:false};}
 };
}
export function eligibilityConsumer(){const coverage=orderedCoverage('C2_eligibility'),statuses={},privateStatuses={};let parity=0;return{add(row){coverage.add(row.descriptor);assert(['ELIGIBLE','NA_UNREACHABLE_STAGE','SAFE_REFUSAL_NO_ELIGIBLE_CONTENT'].includes(row.status));assert(typeof row.private_status==='string');if(row.reachable&&row.private_status==='SUPPORTED_COMPLETE'){assert(row.baseline_private_options_before_cap>0&&row.effective_private_options_before_cap>0&&row.private_distinct_family_count>0,'SUPPORTED_GUARD_HAS_NO_CANDIDATES');}else if(row.reachable&&row.private_status==='TOPIC_SAFE_EMPTY'){assert(row.baseline_private_options_before_cap>0&&row.effective_private_options_before_cap===0&&row.counts.pair_private===0,'EXPECTED_TOPIC_EMPTY_MISMATCH');}else if(row.reachable)assert.equal(row.counts.pair_private,0,'RULE_EXCLUDED_PRIVATE_HAS_CANDIDATES');statuses[row.status]=(statuses[row.status]??0)+1;privateStatuses[row.private_status]=(privateStatuses[row.private_status]??0)+1;parity+=row.parity_checks;},finish(){const c=coverage.finish();return{status:c.status==='COMPLETE'?'COMPLETE_ELIGIBILITY_ROWS_NOT_CONTENT_APPROVAL':'NOT_ACCEPTED',coverage:c,statuses,private_statuses:privateStatuses,hard_parity_checks:parity};}};}
export function gfConsumer(){const coverage=orderedCoverage('gf'),counts={both:0,g_only:0,f_only:0,neither:0};return{add({descriptor,g,f}){coverage.add(descriptor);assert(typeof g==='boolean'&&typeof f==='boolean');counts[g?(f?'both':'g_only'):(f?'f_only':'neither')]++;},finish(){const c=coverage.finish(),metric=pairedRatioCI(counts);return{status:c.status==='COMPLETE'&&metric.status==='PASS'?'PASS_PURE_PAIRED_GF_ONLY':'NOT_ACCEPTED',coverage:c,metric};}};}
