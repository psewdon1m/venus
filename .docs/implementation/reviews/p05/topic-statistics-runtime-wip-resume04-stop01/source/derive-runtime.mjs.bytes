/** Marked fixture derivative only. Production files are never written. */
import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,mkdirSync,existsSync,symlinkSync} from 'node:fs';
import {resolve,join,dirname} from 'node:path';
import {pathToFileURL} from 'node:url';
import {createHash} from 'node:crypto';
import ts from '../../node_modules/typescript/lib/typescript.js';
const sha=b=>createHash('sha256').update(b).digest('hex');
export function deriveRuntime(repository,output,{expectedInputs,fixtureDirectory}={}){
 repository=resolve(repository);output=resolve(output);assert(!existsSync(output));
 const sourceNames=['apps/api/dist/topic-games.js','apps/api/dist/room-routes.js','apps/api/dist/app.js','tests/p05-topic-lifecycle/harness.mjs'];
 const records=[],emissions=[];
 function transform(name,change){const original=readFileSync(join(repository,name),'utf8');assert.equal(sha(original),expectedInputs[name],'DERIVATIVE_SOURCE_PIN:'+name);const tree=ts.createSourceFile(name,original,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);assert.equal(tree.parseDiagnostics.length,0);let text=change(original,tree);const changes=[];
  // Import relocation is a separately recorded, syntax-bound mechanical edit.
  const parsed=ts.createSourceFile(name,text,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);for(const s of parsed.statements){const lit=(ts.isImportDeclaration(s)||ts.isExportDeclaration(s))?s.moduleSpecifier:null;if(lit&&ts.isStringLiteral(lit)&&lit.text.startsWith('.')){let target=pathToFileURL(resolve(repository,dirname(name),lit.text)).href;if(name.endsWith('/app.js')&&lit.text==='./room-routes.js')target='./room-routes.fixture.mjs';if(name.endsWith('/harness.mjs')){if(lit.text==='../../apps/api/dist/topic-games.js')target='./topic-games.fixture.mjs';if(lit.text==='../../apps/api/dist/app.js')target='./app.fixture.mjs';if(lit.text==='../p05-topic-games/fixtures.mjs')target='./fixture-source.mjs';}changes.push({start:lit.getStart(parsed),end:lit.end,replacement:JSON.stringify(target),kind:'IMPORT_RELOCATION',from:lit.text,to:target});}}
  for(const c of changes.sort((a,b)=>b.start-a.start))text=text.slice(0,c.start)+c.replacement+text.slice(c.end);
  assert.equal(ts.createSourceFile(name,text,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS).parseDiagnostics.length,0);const dest=name.endsWith('/harness.mjs')?'harness.fixture.mjs':name.split('/').at(-1).replace('.js','.fixture.mjs');emissions.push([dest,text]);records.push({source:name,source_sha256:sha(original),derived:dest,derived_sha256:sha(text),original_lines:original.split('\n').length,derived_lines:text.split('\n').length,imports:changes,original_utf8:original,derived_utf8:text});}
 transform(sourceNames[0],(text,tree)=>{const edits=[];function visit(n){if(ts.isMethodDeclaration(n)&&n.name.getText(tree)==='draftSnapshot'){function find(x){if(ts.isPropertyAssignment(x)&&x.name.getText(tree)==='seed'){assert.equal(x.initializer.getText(tree),"randomBytes(32).toString('hex')");edits.push({start:x.initializer.getStart(tree),end:x.initializer.end});}ts.forEachChild(x,find);}find(n);}ts.forEachChild(n,visit);}visit(tree);assert.equal(edits.length,1,'ONLY_DRAFT_SEED_SEAM');const e=edits[0];return text.slice(0,e.start)+'this.__fixtureSeedHex'+text.slice(e.end);});
 transform(sourceNames[1],(text,tree)=>{const edits=[];function visit(n){if(ts.isVariableDeclaration(n)&&n.name.getText(tree)==='ticker'){const call=n.initializer;assert(ts.isCallExpression(call)&&call.expression.getText(tree)==='setInterval');assert.equal(call.arguments[1].getText(tree),'1000');const fn=call.arguments[0];assert(ts.isArrowFunction(fn)&&ts.isBlock(fn.body));const body=text.slice(fn.body.getStart(tree)+1,fn.body.end-1);assert(body.includes('rooms.socketState(grant, false, lastPrivate)'));edits.push({start:call.getStart(tree),end:call.end,replacement:'globalThis.__venusStatsPoll.register(socket, () => {'+body+'\nreturn chain;\n})'});}ts.forEachChild(n,visit);}visit(tree);assert.equal(edits.length,1,'EXACT_ONE_PRODUCTION_WS_TICKER');const e=edits[0];return text.slice(0,e.start)+e.replacement+text.slice(e.end);});
 transform(sourceNames[2],text=>text);
 transform(sourceNames[3],text=>{const replace=(a,b)=>{assert.equal(text.split(a).length-1,1,'HARNESS_SEAM_COUNT:'+a);text=text.replace(a,b);};replace('export function harness(){','export function harness({capability}){');replace('privateTextChat:true','privateTextChat:capability===\'CHAT_ON\'');replace('new PrivateTopicPreferences(rooms,registry,pins)','new PrivateTopicPreferences(rooms,registry,pins,source.map.topics)');replace('logger:false,probe:','roomCreationProtocol:2,logger:false,probe:');return text;});
 mkdirSync(output);symlinkSync(join(repository,'node_modules'),join(output,'node_modules'),'dir');for(const[n,text]of emissions)writeFileSync(join(output,n),text,{flag:'wx'});
 const fixtureImport=pathToFileURL(join(repository,'.artifacts/p05-topic-measurements/fixture.mjs')).href,engineImport=pathToFileURL(join(repository,'packages/relationship-engine/dist/index.js')).href;
 writeFileSync(join(output,'fixture-source.mjs'),`import{loadFixture}from${JSON.stringify(fixtureImport)};import{digest}from${JSON.stringify(engineImport)};export function sourceFixture(){const f=loadFixture(${JSON.stringify(resolve(fixtureDirectory))});return{...f,provider:{active:async()=>({pack:f.pack,map:f.map}),pinned:async(_c,pins)=>{if(digest(pins)!==digest(f.map.pins))throw Error('FIXTURE_PIN_MISMATCH');return{pack:f.pack,map:f.map};},assertCurrent:pins=>{if(digest(pins)!==digest(f.map.pins))throw Error('FIXTURE_PIN_MISMATCH');}}};}\n`,{flag:'wx'});
 const manifest={schema:1,kind:'MARKED_MACHINE_FIXTURE_DERIVATIVE_NOT_UNMODIFIED_PRODUCTION_PROOF',changes:['Owned temporary node_modules import-resolution alias; source/dependencies unchanged; native tmpfs quota/accounting required','AST-selected draftSnapshot seed expression only; caller must validate SHA256 predeclared seed','Production WebSocket ticker body retained byte for byte; manual fixed barrier replaces scheduler and returns real promise chain','Harness fixture/capability/source vocabulary and app protocol seams','Mechanical absolute import relocation'],records};writeFileSync(join(output,'DERIVATIVE.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});return manifest;
}
