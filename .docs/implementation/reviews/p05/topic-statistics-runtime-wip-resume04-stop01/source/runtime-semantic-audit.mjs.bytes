/** Assertions over actual persisted plans/states and actual delivered private DTOs. */
import assert from 'node:assert/strict';
import {assertActorConversation} from '../p05-topic-measurements/private-transcript.mjs';
const key=(...x)=>x.join('/'),pair=actors=>[...actors].sort().join(':'),same=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
export function runtimeSemanticAudit(fixture,cell,{onRaw}){
 const publicUsed=new Map(),privateUsed=new Map(),rounds=new Map(),contexts=new Map(),selected=new Set(),counts={plans:0,private_plans:0,private_attempts:0,different_pair_reuse:0,public_prior_blocks:0,same_pair_prior_blocks:0,persistent_states:0,private_HTTP:0,private_WS:0,outsider_denials:0,targeted_commands:0,quarantine_checks:0},modes=new Set();
 function captureState(value){const s=value.state,id=key(value.session,value.round,s.revision);assert(!contexts.has(id)||same(contexts.get(id).state,s),'PERSISTED_REVISION_CHANGED');contexts.set(id,structuredClone(value));assert(contexts.size<=10000,'PRIVATE_STATE_AUDIT_CAP');counts.persistent_states++;onRaw({kind:'actual-persisted-conversation',...value});}
 function inspectPlan(session,plan){const snapshot=session.snapshot.baseline,id=key(snapshot.session_id,plan.round_id),actors=pair(plan.actors),old=rounds.get(id);modes.add(snapshot.mode);assert.equal(plan.stage,Math.min(4,1+Math.floor(4*(plan.round_index-1)/99)));assert(plan.attempts.length<=3);assert(session.history.rounds.filter(r=>r.interaction==='pair_private').length<=25);if(old){assert.equal(old.actors,actors);assert.equal(old.stage,plan.stage);assert.equal(old.primary,plan.primary_member_id);}else{rounds.set(id,{actors,stage:plan.stage,primary:plan.primary_member_id});counts.plans++;if(plan.interaction==='pair_private')counts.private_plans++;}
  const candidates=plan.interaction==='pair_private'?plan.attempts.map((a,i)=>{assert(Object.hasOwn(a,'card')&&Object.hasOwn(a,'candidate_counter'),'EXACT_PERSISTED_ATTEMPT_SHAPE');return{card:a.card,attempt:i};}).filter(v=>v.card):[{card:plan.card,attempt:0}];
  // The current binding is always checked; older actual attempts are also bound
  // through persisted history/private conversation state (never fabricated here).
  if(plan.card&&!candidates.some(v=>v.card.card_id===plan.card.card_id))candidates.push({card:plan.card,attempt:plan.attempts.length-1});
  for(const{card,attempt}of candidates){if(!card)continue;const entry=fixture.map.entry(card.card_id);assert(entry);assert(!fixture.map.excluded_card_ids.includes(card.card_id),'QUARANTINED_FAMILY_SELECTED');counts.quarantine_checks++;const candidate=key(id,attempt,card.card_id);if(selected.has(candidate))continue;selected.add(candidate);
   for(const family of entry.semantic_family_ids){if(plan.interaction==='pair_private'){assert(plan.stage>=3);for(const actor of plan.actors){const own=session.safety.members.find(m=>m.member_id===actor);assert(own&&entry.topic_ids.every(t=>own.allow_topic_ids.includes(t)&&!own.excluded_topic_ids.includes(t)),'FULL_UNION_PERSISTENT_SAFETY');}assert(!publicUsed.has(family),'ROOM_PUBLIC_FAMILY_REUSED_PRIVATELY');const used=privateUsed.get(actors)??new Map();assert(!used.has(family),'SAME_PAIR_FAMILY_REPEATED');for(const[other,values]of privateUsed)if(other!==actors&&values.has(family))counts.different_pair_reuse++;used.set(family,{candidate,mode:snapshot.mode,session:snapshot.session_id});privateUsed.set(actors,used);}else{assert(!publicUsed.has(family),'ROOM_PUBLIC_FAMILY_REPEATED');publicUsed.set(family,{candidate,mode:snapshot.mode});}}
   if(plan.interaction==='pair_private')counts.private_attempts++;
  }
  if(session.history.public_history.some(r=>r.session_id!==snapshot.session_id))counts.public_prior_blocks++;if(session.history.private_history.some(r=>r.session_id!==snapshot.session_id))counts.same_pair_prior_blocks++;
 }
 function delivered(member,body,origin){assert(body&&typeof body==='object');const context=contexts.get(key(body.session_id,body.round_id,body.revision));assert(context,'PRIVATE_DELIVERY_WITHOUT_CAPTURED_PERSISTENT_CONTEXT');assert(context.actors.includes(member),'NONACTOR_PRIVATE_PAYLOAD');const accepted=(context.state.advice??[]).filter(a=>a.recipient===member&&a.state==='accepted').map(a=>a.advice_id);assertActorConversation(JSON.stringify(body),{bilateral_topic_accepted:context.state.offer?.state==='active',recipient_advice_accept_ids:accepted});if(origin==='WS')counts.private_WS++;else counts.private_HTTP++;}
 function inspectFrame(actor,frame){if(frame.audience==='member'){assert.equal(frame.target_member_id,actor.id,'WS_CROSS_RECIPIENT');if(frame.type==='private_conversation_v2')delivered(actor.id,frame.payload,'WS');else if(actor.id===cell.observer_id&&frame.type==='game.private_cleared')throw Error('UNMODELED_OBSERVER_GENERIC_CLEAR_REQUIRES_PUBLIC_MODEL');}}
 return{counts,captureState,inspectPlan,inspectFrame,delivered,recordOutsiderDenial(){counts.outsider_denials++;},recordTargeted(topicIds,plan){assert(Array.isArray(topicIds)&&topicIds.length>0);assert(plan.interaction==='pair_private'&&plan.stage>=3&&plan.attempts.length<=3);if(plan.card){const entry=fixture.map.entry(plan.card.card_id);assert(topicIds.every(t=>entry.topic_ids.includes(t)),'TARGETED_FULL_UNION_NOT_OBSERVED');}counts.targeted_commands++;},finish(){assert.equal(modes.size,3,'CROSS_MODE_CANARY_MISSING');assert(counts.plans===300,'THREE_COMPLETE_R100_REQUIRED');assert(counts.quarantine_checks>0&&fixture.map.excluded_card_ids.length>=2);assert(counts.public_prior_blocks>0,'PUBLIC_PRIOR_CASE_NOT_OBSERVED');if(cell.private_positive){assert(counts.private_plans>0&&counts.private_attempts>0&&counts.same_pair_prior_blocks>0&&counts.persistent_states>0&&counts.private_HTTP>0&&counts.private_WS>0&&counts.outsider_denials>0&&counts.targeted_commands>0,'PRIVATE_POSITIVE_SETUP_NOT_OBSERVED');if(cell.different_pair)assert(counts.different_pair_reuse>0,'DIFFERENT_PAIR_ALLOWANCE_NOT_OBSERVED_NO_SEED_RETRY');}return{status:'ACTUAL_PERSISTENT_SEMANTICS_OBSERVED_REQUIRES_RAW_INDEPENDENT_AUDIT',counts:{...counts},modes:[...modes],assertions:{same_pair_cross_session_cross_mode_family_block:cell.private_positive?'PASS':'NA_PRIVATE_CAPABILITY',different_pair_private_family_allowed:cell.different_pair?'PASS':cell.private_positive?'NA_SINGLE_UNORDERED_PAIR':'NA_PRIVATE_CAPABILITY',public_history_blocks_roomwide:'PASS',mixed_visibility_whole_family_quarantined:'PASS',full_union_targeted_attempt_actor_stage_budget_fence:'PASS',fresh_authority_serializers_and_private_boundaries:'PASS'}};}};
}
