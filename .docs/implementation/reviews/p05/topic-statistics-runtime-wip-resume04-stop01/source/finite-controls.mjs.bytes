import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {descriptors,orderedCoverage,featureHash,sha,dense} from './protocol.mjs';
import {evaluateCell,evaluatePooled} from './inference.mjs';
import {sessionConsumer,gfConsumer} from './consumers.mjs';
import {pairedRatioCI,trainLDA} from '../p05-topic-measurements/statistics.mjs';
import {serializerParity,runtimeCells,runtimeReceipt} from './prerequisites.mjs';
import {authorize} from './section-runner.mjs';
const names=JSON.parse(readFileSync('.artifacts/p05-topic-measurements/contracts/public-features.json')).names,rows=[];
async function check(name,fn){try{await fn();rows.push({name,status:'PASS'});}catch(e){rows.push({name,status:'FAIL',error:e.message});}}
function corpus(kind='same'){
 const output=[];for(const cl of ['F','G'])for(const split of ['train','holdout'])for(let index=0;index<(split==='train'?100:400);index++){
  const label=Number(cl==='G'),value=kind==='same'?0:kind==='reverse'&&split==='holdout'?1-label:label;
  output.push({schema:1,descriptor:{section:'social',size:2,mode:'questions',context:'in_person',capability:'DEFAULT_OFF',regime:'T0_ALL',comparison:'FG',class_profile:cl,split,index},feature_dictionary_sha256:featureHash,dimension:1075,sparse:value?[[0,value]]:[],summary:{status:'COMPLETE'}});
 }return output;
}
for(const section of ['C2_eligibility','C2_neutral','C2_negative','C2_private','invariants','fairness','gf','social','exclusion'])await check(section+' incomplete fixed prefix never complete',()=>{const c=orderedCoverage(section);c.add(descriptors(section).next().value);assert.equal(c.finish().status,'INCOMPLETE');});
await check('changed seed denied',()=>{const c=orderedCoverage('fairness'),d=descriptors('fairness').next().value;assert.throws(()=>c.add({...d,seed_literal:d.seed_literal+'X'}),/DESCRIPTOR_ORDER/);});
await check('duplicate or missing first descriptor denied',()=>{const c=orderedCoverage('gf'),it=descriptors('gf'),a=it.next().value,b=it.next().value;assert.throws(()=>c.add(b),/DESCRIPTOR_ORDER/);const c2=orderedCoverage('gf');c2.add(a);assert.throws(()=>c2.add(a),/DESCRIPTOR_ORDER/);});
await check('sparse duplicates and unordered indexes denied',()=>{const r=corpus()[0];assert.throws(()=>dense({...r,sparse:[[2,1],[2,2]]}),/BAD_SPARSE/);assert.throws(()=>dense({...r,sparse:[[3,1],[2,2]]}),/BAD_SPARSE/);assert.throws(()=>dense({...r,sparse:[[3,Infinity]]}),/BAD_SPARSE/);});
await check('same-distribution LDA ties preserve AUC.5 and no decoder',()=>{const r=evaluateCell(corpus(),names);assert.equal(r.status,'PASS');assert.equal(r.metric.auc,.5);assert.equal(r.structural_deterministic_decoders.length,0);});
await check('direct decoder blocks even if pretend report says privacy',()=>{const r=evaluateCell(corpus('separated'),names);assert.equal(r.status,'FAIL');assert.equal(r.metric.auc,1);assert(r.structural_deterministic_decoders.includes(names[0]));});
await check('holdout cannot flip train-only orientation',()=>{const r=evaluateCell(corpus('reverse'),names);assert.equal(r.metric.auc,0);});
await check('missing holdout and duplicate index denied',()=>{const c=corpus();assert.throws(()=>evaluateCell(c.slice(1),names),/SPLIT_COUNTS/);assert.throws(()=>evaluateCell([...c,c[0]],names),/DUPLICATE/);});
await check('refusals retained and cause compatible inference failure',()=>{const c=corpus();c[0].summary.status='SAFE_REFUSAL';const r=evaluateCell(c,names);assert.equal(r.status,'FAIL');assert.equal(r.refusals_retained,1);});
await check('pooled LDA independently equals historical train math on supplied raw corpus',async()=>{const c=corpus('separated'),replay=async function*(){yield* c;},r=await evaluatePooled(replay,names,{expectedCells:1}),training=[c.filter(x=>x.descriptor.class_profile==='F'&&x.descriptor.split==='train').map(dense),c.filter(x=>x.descriptor.class_profile==='G'&&x.descriptor.split==='train').map(dense)],model=trainLDA(...training);assert.deepEqual(r.weights,Array.from(model.weights));assert.equal(r.intercept,model.intercept);assert.equal(r.status,'FAIL');assert.deepEqual(r.structural_deterministic_decoders,[names[0]]);});
await check('paired GF zero count fails; positive ratio retains original CI',()=>{assert.equal(pairedRatioCI({both:0,g_only:1,f_only:0,neither:100}).status,'FAIL');assert.equal(pairedRatioCI({both:100,g_only:1000,f_only:10,neither:100}).status,'PASS');const c=gfConsumer();c.add({descriptor:descriptors('gf').next().value,g:true,f:false});assert.equal(c.finish().status,'NOT_ACCEPTED');});
function result(section,change={}){const d=descriptors(section).next().value;return{descriptor:d,summary:{status:'COMPLETE',requested_rounds:d.rounds,completed_rounds:d.rounds},counts:{K:1,D:2,Kprivate:0,invitations:[1,1],earlyPrivate:0},diagnostics:{status:'PASS',counters:{strict_anti_repeat_violations:0},violations:[],stages:{1:{rounds:1,private_eligible_after_cap:0,private_selected:0,empty_selected:0}}},invariants:{rows:Array.from({length:15},(_,i)=>({id:'I'+String(i+1).padStart(2,'0'),checks:0,violations:0,runtime_evidence_required:true}))},...change};}
await check('fairness prefix cannot pass full fixed2000-cell section',()=>{const c=sessionConsumer('fairness');c.add(result('fairness'));assert.equal(c.finish().status,'NOT_ACCEPTED');});
await check('fairness individual>.5 fails even if aggregate has data',()=>{const c=sessionConsumer('fairness'),r=result('fairness');r.counts.invitations=[2,0];c.add(r);assert.equal(c.finish().cells[0].status,'FAIL');});
await check('invalid invitation denominator rejected',()=>{const c=sessionConsumer('fairness'),r=result('fairness');r.counts.D=3;assert.throws(()=>c.add(r));});
await check('missing C2 negative refusal rejected',()=>{const c=sessionConsumer('C2_negative');assert.throws(()=>c.add(result('C2_negative')),/EXPECTED_NEGATIVE/);});
await check('15 invariants required, runtime close remains separate',()=>{const c=sessionConsumer('invariants'),r=result('invariants');r.invariants.rows.pop();assert.throws(()=>c.add(r));const x=sessionConsumer('invariants');x.add(result('invariants'));assert.equal(x.finish().I14,'SEPARATE_ACTUAL_RUNTIME_CLOSE_REQUIRED');});
function observation(value,transport,label='start'){const raw=JSON.stringify(value);return{raw_serialized_UTF8:raw,raw_sha256:sha(raw),transport,channel:'game',http_status:200,operation_kind_diagnostic_only:label,emitted_frame:false,modeled_frame:false};}
await check('serializer parity retains public revisions and rejects changed rev',()=>{const a=[observation({game_rev:2},'HTTP')],b=[observation({game_rev:2},'MODELED_HTTP')];assert.equal(serializerParity(a,b,{requiredLabels:['start']}).observations,1);b[0]=observation({game_rev:3},'MODELED_HTTP');assert.throws(()=>serializerParity(a,b,{requiredLabels:['start']}),/SERIALIZER_OR_MUTATION/);});
await check('serializer parity rejects missing mutation/raw tamper/extra observation',()=>{const a=[observation({},'HTTP')],b=[observation({},'MODELED_HTTP')];assert.throws(()=>serializerParity(a,b),/MISSING_PARITY/);assert.throws(()=>serializerParity(a,[...b,b[0]]),/OBSERVATION_COUNT/);a[0].raw_sha256='0'.repeat(64);assert.throws(()=>serializerParity(a,b,{requiredLabels:['start']}));});
await check('serializer parity cannot rename actors to hide different selected roles',()=>{const id0='00000000-0000-4000-8000-000000000001',id1='00000000-0000-4000-8000-000000000002',roles={[id0]:'ACTOR_0',[id1]:'ACTOR_1'},a=[observation({actors:[id0]},'HTTP')],b=[observation({actors:[id1]},'MODELED_HTTP')];assert.throws(()=>serializerParity(a,b,{requiredLabels:['start'],actualActorRoles:roles,modeledActorRoles:roles}),/SERIALIZER_OR_MUTATION/);});
await check('runtime84 manifest distinguishes63private and54different-pair cells',()=>{const c=runtimeCells();assert.equal(c.length,84);assert.equal(c.filter(x=>x.private_positive).length,63);assert.equal(c.filter(x=>x.different_pair).length,54);});
await check('runtime self-description lacks actual trace proof and missing cases deny',()=>{assert.throws(()=>runtimeReceipt({kind:'ACTUAL_PG_HTTP_WS_TOPIC_CANARIES',source_identity:'s',image:'i',input_pins:{},synthetic_machine_only:true,human_content_approval:false,cleanup:'completed',cells:[]},{source:'s',image:'i',pins:{}}));});
await check('dispatch refuses absent root authority before engine/fixture',()=>assert.throws(()=>authorize(null,{}),/ROOT_STATS_RUN_ACK/));
console.log(JSON.stringify({status:rows.every(r=>r.status==='PASS')?'PASS_AUTHOR_FAKE_CONTROLS_ONLY':'FAIL',count:rows.length,controls:rows,selectors:0,actual_mutator_sessions:0,Docker_calls:0,statistics_RUN:false,actual_runtime_canaries:false},null,2));if(rows.some(r=>r.status!=='PASS'))process.exitCode=1;
