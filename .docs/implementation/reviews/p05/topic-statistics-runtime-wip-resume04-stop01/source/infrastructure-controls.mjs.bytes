/** Finite filesystem/model/source controls; no selector/session/Docker RUN. */
import assert from 'node:assert/strict';
import {mkdtempSync,readFileSync,writeFileSync,readdirSync,rmSync,linkSync} from 'node:fs';
import {setTimeout} from 'node:timers';
import {tmpdir} from 'node:os';
import {join,resolve,sep} from 'node:path';
import {createHash} from 'node:crypto';
import {EventEmitter} from 'node:events';
import {durableSink} from './durable-sink.mjs';
import {limits,resourceLease} from './resource32-policy.mjs';
import {checkSample,validatePlan,validateProbe} from './supervisor32.mjs';
import {deriveRuntime} from './derive-runtime.mjs';
import {pollRegistry} from './poll-registry.mjs';
import {pairNormalization} from './pair-normalization.mjs';
const root=mkdtempSync(join(tmpdir(),'venus-stats32-controls-')),owner='a'.repeat(32),results=[];let n=0;const guard=()=>{},sha=b=>createHash('sha256').update(b).digest('hex');
const check=async(name,fn)=>{try{await fn();results.push({name,status:'PASS'});}catch(error){results.push({name,status:'FAIL',error:error.stack});}};
const sink=()=>durableSink(join(root,'sink-'+n++),{guard,owner});const collect=async it=>{const a=[];for await(const r of it)a.push(r);return a;};
try{
 await check('durable append and filtered persisted replay exact',async()=>{const s=sink();assert.equal(s.append('features',{a:1},{group:'g'}).durable,true);s.append('features',{a:2},{group:'h'});assert.deepEqual(await collect(s.replay('features',{group:'g'})),[{a:1}]);const done=await s.finish({status:'NOT_ACCEPTED_CONTROL'});assert.equal(done.records,3);assert.equal(done.segments,2);assert.throws(()=>s.append('features',{}));assert.deepEqual(await collect(s.replay('features')),[{a:1},{a:2}]);});
 await check('replay rejects immutable gzip byte tamper',async()=>{const s=sink();s.append('features',{a:1});s.seal();const p=join(s.root,'payload',readdirSync(join(s.root,'payload'))[0]),b=readFileSync(p);b[5]^=1;writeFileSync(p,b);await assert.rejects(()=>collect(s.replay('features')));s.abort();});
 await check('replay rejects hardlinked segment',async()=>{const s=sink();s.append('features',{a:1});s.seal();const p=join(s.root,'payload',readdirSync(join(s.root,'payload'))[0]);linkSync(p,p+'.linked');await assert.rejects(()=>collect(s.replay('features')));s.abort();});
 await check('sink checks guard before write and preserves prefix on abort',()=>{let reject=false;const s=durableSink(join(root,'guard-sink'),{owner,guard:()=>{assert(!reject);}});s.append('features',{prefix:true});reject=true;assert.throws(()=>s.append('features',{lost:true}));assert.equal(s.abort().sequence,1);assert(readFileSync(join(s.root,'active','current.gz.partial')).length>0);});
 await check('sink refuses existing output and oversized/raw escape rows',()=>{const s=sink();assert.throws(()=>durableSink(s.root,{guard,owner}));assert.throws(()=>s.append('../escape',{}));assert.throws(()=>s.append('features',{}, {actor:'private'}));assert.throws(()=>s.append('features',{raw:'x'.repeat(2*1024**2)}));s.abort();});
 const sample={global_cap_bytes:limits.global,native_reserved_bytes:limits.native,payload_allocated_bytes:0,archive_allocated_bytes:0,inputs_allocated_bytes:0,control_allocated_bytes:0,actual_host_free_bytes:String(limits.global+limits.reserve),actual_native_free_bytes:String(limits.global+limits.reserve)};
 await check('32GiB ledger exactly partitions and accepts boundary free reserve',()=>{assert.equal(limits.payload+limits.archive+limits.inputs+limits.control+limits.native+limits.active+limits.safety,limits.global);assert(checkSample(sample));});
 for(const part of ['payload','archive','inputs','control'])await check(part+' physical allocation overflow denied',()=>assert.throws(()=>checkSample({...sample,[part+'_allocated_bytes']:limits[part]+1})));
 for(const part of ['host','native'])await check(part+' actual free low denied',()=>assert.throws(()=>checkSample({...sample,['actual_'+part+'_free_bytes']:String(limits.global+limits.reserve-1)})));
 await check('native reservation cannot silently widen/change',()=>assert.throws(()=>checkSample({...sample,native_reserved_bytes:16*1024**2})));
 await check('guard owner stop counter cap denied',()=>{const p=join(root,'guard.json'),lease=resourceLease(p,owner),base={owner,counter:1,stop_requested:false,global_cap_bytes:limits.global,actual_host_free_bytes:sample.actual_host_free_bytes,actual_native_free_bytes:sample.actual_native_free_bytes,host_payload_allocated_bytes:0};writeFileSync(p,JSON.stringify(base));lease();for(const change of [{owner:'b'.repeat(32)},{stop_requested:true},{counter:0},{global_cap_bytes:limits.global+1},{host_payload_allocated_bytes:limits.payload}]){writeFileSync(p,JSON.stringify({...base,...change}));assert.throws(()=>lease());}});
 await check('guard unchanged counter becomes stale',async()=>{const p=join(root,'stale.json');writeFileSync(p,JSON.stringify({owner,counter:1,stop_requested:false,global_cap_bytes:limits.global,actual_host_free_bytes:sample.actual_host_free_bytes,actual_native_free_bytes:sample.actual_native_free_bytes,host_payload_allocated_bytes:0}));const lease=resourceLease(p,owner);lease();await new Promise(r=>setTimeout(r,2050));assert.throws(()=>lease(),/STALE/);});
 await check('plan refuses output inside clean repo and missing authority',()=>assert.throws(()=>validatePlan({})));
 await check('actual inspect probe rejects default IPC and unexpected mounts',()=>{const p={project:'venus-stats32-'+owner.slice(0,12),owner,image:'sha256:'+'f'.repeat(64)},r={Name:'/'+p.project+'-native-free',Image:p.image,Config:{Labels:{'com.venus.stats32.owner':owner},Entrypoint:['node']},HostConfig:{NetworkMode:'none',IpcMode:'none',ReadonlyRootfs:true,Memory:64*1024**2,LogConfig:{Type:'none'}},Mounts:[]};assert(validateProbe(r,p));assert.throws(()=>validateProbe({...r,HostConfig:{...r.HostConfig,IpcMode:'private'}},p));assert.throws(()=>validateProbe({...r,Mounts:[{}]},p));});
 await check('UUID/token bijection retains digests/revisions/frame counts',()=>{const a='11111111-1111-4111-8111-111111111111',b='22222222-2222-4222-8222-222222222222',p=pairNormalization();p.equal({id:a,token:'a'.repeat(64),candidate_ref:'c'.repeat(64),rev:1},{id:b,token:'b'.repeat(64),candidate_ref:'c'.repeat(64),rev:1});assert.deepEqual(p.translate({offer_id:a,token:'a'.repeat(64)}),{offer_id:b,token:'b'.repeat(64)});assert.throws(()=>p.equal({candidate_ref:'c'.repeat(64)},{candidate_ref:'d'.repeat(64)}));assert.throws(()=>p.equal({rev:1},{rev:2}));assert.throws(()=>p.equal([1],[1,2]));assert.throws(()=>p.equal(a,'33333333-3333-4333-8333-333333333333'));});
 await check('poll awaits actual callback chain; close removes; ninth denied',async()=>{const p=pollRegistry(),s=new EventEmitter();s.readyState=1;let calls=0;p.register(s,async()=>{await Promise.resolve();calls++;});assert.equal((await p.barrier()).actual_callbacks,1);assert.equal(calls,1);s.emit('close');assert.equal(p.size,0);for(let i=0;i<8;i++){const a=new EventEmitter();a.readyState=1;p.register(a,()=>{});}assert.throws(()=>p.register(new EventEmitter(),()=>{}));});
 await check('AST derivative exactly pinned sources only, production ticker retained',()=>{const names=['apps/api/dist/topic-games.js','apps/api/dist/room-routes.js','apps/api/dist/app.js','tests/p05-topic-lifecycle/harness.mjs'],expectedInputs=Object.fromEntries(names.map(p=>[p,sha(readFileSync(p))])),out=join(root,'derived');const result=deriveRuntime(resolve('.'),out,{expectedInputs,fixtureDirectory:resolve('.artifacts/p05-topic-measurements/fixture')});assert.equal(result.records.length,4);for(const r of result.records)assert.equal(sha(readFileSync(r.source)),r.source_sha256);const topic=readFileSync(join(out,'topic-games.fixture.mjs'),'utf8');assert.equal(topic.split('seed: this.__fixtureSeedHex').length-1,1);assert(topic.includes("token: randomBytes(32).toString('hex')"));const route=readFileSync(join(out,'room-routes.fixture.mjs'),'utf8');assert(route.includes('globalThis.__venusStatsPoll.register(socket'));assert(route.includes('rooms.socketState(grant, false, lastPrivate)'));assert(route.includes('return chain;'));assert.throws(()=>deriveRuntime(resolve('.'),join(root,'bad-derived'),{expectedInputs:{...expectedInputs,[names[0]]:'0'.repeat(64)},fixtureDirectory:root}));});
}finally{assert(resolve(root).startsWith(resolve(tmpdir())+sep));rmSync(root,{recursive:true,force:true});}
console.log(JSON.stringify({status:results.every(x=>x.status==='PASS')?'PASS_FINITE_INFRASTRUCTURE_ONLY':'FAIL',count:results.length,controls:results,selectors:0,Docker_calls:0,actual_PG_HTTP_WS_sessions:0,statistics_RUN:false},null,2));if(results.some(x=>x.status!=='PASS'))process.exitCode=1;
