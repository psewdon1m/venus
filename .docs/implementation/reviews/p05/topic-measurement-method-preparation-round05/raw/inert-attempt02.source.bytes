/** Finite source-bound mocked supervisor/cleanup, actual filesystem only for empty control dir. */
import assert from 'node:assert/strict';
import {mkdtempSync,rmSync,readFileSync} from 'node:fs';
import {resolve,join} from 'node:path';
import {createHash} from 'node:crypto';
import {supervise,phaseLimits} from './r100-v3-watchdog.mjs';
import {cleanupOwned} from './owned-cleanup.mjs';
import {beforeHostAllocation} from './host-output-guard.mjs';
const root=mkdtempSync(resolve('.artifacts/p05/method05-inert-')),owner='a'.repeat(32),container='venus-r100-v3-123456789abc',image='sha256:'+'b'.repeat(64),MiB=1024**2,RESERVE=10*1024**3,CAP=128*MiB,controls=[];
const check=async(name,fn)=>{await fn();controls.push({name,status:'PASS'});};
const config={kind:'ROOT_R100_V3_OPERATIONAL_DIAGNOSTIC_ACK',method_revision:'METHOD05-HOST-OUTPUT-FENCES',status:'AUTHORIZED',independent_method_and_producer_review:'PASS',owner,container,volume:container+'-output',image,source_identity:'c'.repeat(64),global_owned_cap_bytes:CAP,reserve_bytes:RESERVE,attempts:1,phase_limits_ms:phaseLimits,statistics_RUN:false,control_directory:root,host_output_path:root,counter_freshness_ms:2000};
async function replay({fault='low',normal=false,reordered=false,stale=false,pretendExport=false}={}){
 let clock=0,seq=0,stopping=false,afterStop=0;const writes=[],messages=[];
 const result=await supervise(config,{now:()=>clock,pause:async()=>{clock+=normal?250:1000;},free:()=>{if(stopping){afterStop++;if(fault==='unknown')throw Error('INERT_SPACE_UNAVAILABLE');if(fault==='low')return 0n;}return 12n*1024n**3n;},writeAtomic:(path,value)=>{writes.push({path,value:structuredClone(value),stopping,afterStop});return true;},emit:m=>{messages.push(structuredClone(m));if(m.type==='failure-state')stopping=true;},docker:async()=>({code:0,stdout:''}),readProbe:()=>({owner,volume:config.volume,image,uid:1000,gid:1000,status:'WRITE_FSYNC_READ_DELETE_EMPTY_PASS',native_available_bytes:String(RESERVE+CAP)}),readPhase:()=>{
  const phase=normal?['BOOTSTRAP','PROBE','RUN','STOP','EXPORT','ARCHIVE','CLEANUP','DONE'][Math.min(Math.floor(clock/250),7)]:!stopping?(clock===0?'BOOTSTRAP':clock<2000?'PROBE':'RUN'):afterStop<4?'EXPORT':afterStop<8?'ARCHIVE':afterStop<12?'CLEANUP':'DONE';
  return {owner,counter:reordered&&stopping?1:stale&&stopping?seq:++seq,phase,worker_stopped:true,export_verified:normal||pretendExport,export_verified_counter:pretendExport?999999:1,owned_cleanup:normal?'completed':'retained'};
 }});return{result,writes,messages,afterStop};
}
try{
 await check('healthy complete loop accepts exact export+cleanup',async()=>{const r=await replay({normal:true,fault:'none'});assert.equal(r.result.status,'SUPERVISOR_COMPLETE_NON_GATING');assert.equal(r.result.capacity_fault,null);assert(r.writes.some(x=>x.path.endsWith('watchdog-terminal.json')));});
 await check('timeout then actualfree0 samples through cleanup, allocates nothing after fault',async()=>{const r=await replay();assert(r.result.reason.includes('EXTERNAL_RUN_MONOTONIC_DEADLINE'));assert.equal(r.result.minimum_actual_host_free_bytes,'0');assert(r.result.actual_space_samples_after_stop>=12);assert.equal(r.writes.filter(x=>x.stopping&&x.afterStop>0).length,0);assert(r.messages.some(x=>x.type==='space'&&x.sample.host_output_allowed===false));assert.equal(r.result.status,'CAPACITY_FAULT_RETAINED_NOT_ACCEPTED');assert.equal(r.result.terminal_receipt_written,false);assert(r.result.events.some(x=>x.phase==='PREFIX_NOT_EXPORTED_OR_RETAINED_NOT_ACCEPTED'));});
 await check('unknown actual free after timeout stops all output while IPC keeps sampling',async()=>{const r=await replay({fault:'unknown'});assert(r.result.capacity_fault.reason.startsWith('ACTUAL_HOST_C_SPACE_UNKNOWN'));assert(r.afterStop>=12);assert.equal(r.writes.filter(x=>x.stopping&&x.afterStop>0).length,0);});
 await check('capacityfault cannot be converted to exported PASS by late claimed counter',async()=>{const r=await replay({pretendExport:true});assert(!r.result.events.some(x=>x.phase==='FAILURE_PREFIX_EXPORTED_BEFORE_CAPACITY_FAULT_AND_CLEANED'));assert.notEqual(r.result.status,'SUPERVISOR_COMPLETE_NON_GATING');});
 await check('healthy space after timeout still supervises but never promotes failure',async()=>{const r=await replay({fault:'none'});assert.equal(r.result.status,'STOPPED_NOT_ACCEPTED');assert(r.result.actual_space_samples_after_stop>=12);assert(r.writes.some(x=>x.stopping));});
 for(const type of ['reordered','stale'])await check(type+' phase after stop does not disable actualspace sampling',async()=>{const r=await replay({[type]:true});assert(r.result.actual_space_samples_after_stop>=170);assert.equal(r.result.status,'CLEANUP_FAILED_RETAINED_NOT_ACCEPTED');assert(r.result.reason.includes(type==='stale'?'POST_STOP_MAIN_HEARTBEAT_STALE':'false == true'));assert.equal(r.writes.filter(x=>x.stopping&&x.afterStop>0).length,0);});
 for(const value of [0n,BigInt(RESERVE+CAP-1)])await check('JS realspace adapter rejects low '+value,()=>assert.throws(()=>beforeHostAllocation(config,1,{probe:()=>({bavail:value,bsize:1n})}),/CAPACITY_FAULT/));
 await check('JS unknown actualspace rejects',()=>assert.throws(()=>beforeHostAllocation(config,1,{probe:()=>{throw Error('INERT');}}),/CAPACITY_FAULT/));
 await check('JS positive actualspace accepts bounded allocation',()=>beforeHostAllocation(config,65536,{probe:()=>({bavail:12n*1024n**3n,bsize:1n})}));
 function adapter({foreign=false,badImage=false,failedKill=false,deadline=false}={}){let ids=['owned'],volumes=[config.volume],running=true,time=0;const calls=[];return{calls,now:()=>time,docker:async(args,opts)=>{calls.push({args,timeout:opts.timeout});if(deadline)time+=31000;let result;if(args[0]==='ps')result=ids.join('\n');else if(args[0]==='volume'&&args[1]==='ls')result=volumes.join('\n');else if(args[0]==='inspect')result=JSON.stringify(ids.map(Id=>({Id,Name:'/'+container,Config:{Labels:{'com.venus.measurement.owner':foreign?'other':owner}},Image:badImage?'wrong':image,State:{Running:running}})));else if(args[0]==='kill'){if(failedKill)return{code:1,stdout:''};running=false;result='';}else if(args[0]==='rm'){ids=[];result='';}else if(args[0]==='volume'&&args[1]==='inspect')result=JSON.stringify([{Name:config.volume,Labels:{'com.venus.measurement.owner':owner}}]);else if(args[0]==='volume'&&args[1]==='rm'){volumes=[];result='';}else throw Error('UNEXPECTED_INERT_COMMAND');return{code:0,stdout:result};}};}
 const clean=async(options,exportVerified)=>{const a=adapter(options),r=await cleanupOwned({docker:a.docker,now:a.now,owner,image,container,volume:config.volume,exportVerified});return{a,r};};
 await check('cleanup kills/removes owned worker without any artifact writer; retains unexported volume',async()=>{const{a,r}=await clean({},false);assert.equal(r.artifact_write_calls,0);assert.equal(r.workerStopped,true);assert.equal(r.cleanup,'retained');assert(a.calls.some(x=>x.args[0]==='kill'));assert(a.calls.some(x=>x.args[0]==='rm'));assert(!a.calls.some(x=>x.args[0]==='volume'&&x.args[1]==='rm'));});
 await check('verified-export cleanup removes exact owner volume',async()=>{const{a,r}=await clean({},true);assert.equal(r.cleanup,'completed');assert(a.calls.some(x=>x.args[0]==='volume'&&x.args[1]==='rm'));});
 for(const option of ['foreign','badImage','failedKill','deadline'])await check('cleanup '+option+' is retained, never falsecomplete',async()=>{const{a,r}=await clean({[option]:true},true);assert.equal(r.cleanup,'retained');assert(r.error);assert(!a.calls.some(x=>x.args[0]==='volume'&&x.args[1]==='rm'));if(['foreign','badImage','deadline'].includes(option))assert(!a.calls.some(x=>x.args[0]==='kill'));});
 const files=['r100-v3-watchdog.mjs','owned-cleanup.mjs','host-output-guard.mjs','method05-inert-controls.mjs'];
 console.log(JSON.stringify({status:'PASS_AUTHOR_FINITE_ONLY',controls,source:Object.fromEntries(files.map(n=>[n,createHash('sha256').update(readFileSync(join(import.meta.dirname,n))).digest('hex')])),Docker_calls:0,selector_invocations:0,statistics_RUN:false},null,2));
}finally{assert(root.startsWith(resolve('.artifacts/p05')+'/')||root.startsWith(resolve('.artifacts/p05')+'\\'));rmSync(root,{recursive:true,force:true});}
