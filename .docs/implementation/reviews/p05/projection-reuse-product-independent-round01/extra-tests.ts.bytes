describe('independent projection changed-boundary negatives',()=>{
 it('requires strictly more than2s remaining, without sliding the existing expiry',async()=>{const f=fixture();await f.prepare();f.setNow(3999);await f.prepare();expect(f.dto).toHaveBeenCalledTimes(1);expect(f.stored().expires_at).toBe(6000);f.setNow(4000);await f.prepare();expect(f.dto).toHaveBeenCalledTimes(2);expect(f.stored().expires_at).toBe(9000);});
 it('checks captured delivery again when its projection expires after construction',async()=>{const f=fixture();await f.prepare();f.setNow(2000);const view=await f.deliver();expect(view.server_time).toBe(new Date(2000).toISOString());f.setNow(6000);expect(()=>view[gameDeliveryFence]!()).toThrowError(expect.objectContaining({code:'TOPIC_DELIVERY_EXPIRED'}));expect(f.stored().expires_at).toBe(6000);});
 it('does not hit when reconcile denies the formerly prepared round',async()=>{const f=fixture();await f.prepare();Reflect.set(f.games,'reconcile',async()=>false);expect(await f.prepare()).toMatchObject({deferred_error:'ROUND_NOT_ACTIVE'});expect(f.dto).toHaveBeenCalledTimes(1);expect(f.stream()).toBe(1);});
 it('refuses a consent that expires during fresh-name read',async()=>{const f=fixture();await f.prepare();Reflect.set(f.games,'names',async()=>{f.setNow(181000);return f.names;});await expect(f.deliver()).rejects.toMatchObject({code:'TOPIC_DELIVERY_EXPIRED'});});
 it('ignores names query order and rejects legacy missing digest at final delivery',async()=>{const f=fixture();await f.prepare();f.names.reverse();await f.prepare();expect(f.dto).toHaveBeenCalledTimes(1);const p=f.stored();Reflect.deleteProperty(p,'names_digest');objects.values.set('a',p);await expect(f.deliver()).rejects.toMatchObject({code:'TOPIC_DELIVERY_STALE'});});
 it('rechecks old-parent expiration even with a long projection timestamp',async()=>{const f=fixture();await f.prepare();const p=f.stored();p.expires_at=999999;objects.values.set('a',p);f.setNow(181000);await expect(f.deliver()).rejects.toMatchObject({code:'TOPIC_DELIVERY_EXPIRED'});});
});
