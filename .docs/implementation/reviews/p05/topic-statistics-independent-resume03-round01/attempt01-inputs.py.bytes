copies=[]
for p in P.iterdir():
 if p.is_file():
  matches=[r['path'] for r in j['files'] if r['sha256']==sha(p)];assert matches,p.name;copies.append({'path':p.name,'sha256':sha(p),'frozen_copies':matches})
old=ROOT/'.artifacts/p05-topic-statistics-resume02'
for n in ['protocol.mjs','consumers.mjs','inference.mjs','resource32-policy.mjs','worker.mjs','section-runner.mjs','prerequisites.mjs','session-adapter.mjs','derive-runtime.mjs','actual-session.mjs','coalesced-observer.mjs','FEASIBILITY.json']:assert sha(P/n)==sha(old/n),n
