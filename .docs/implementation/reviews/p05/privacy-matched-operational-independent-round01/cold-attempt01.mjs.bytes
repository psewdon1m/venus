const rawBinding=read('binding.json'),rawPrereg=read('PREREG.json'),reviewPath=root+'/.docs/implementation/reviews/p05/privacy-matched-independent-round01/INDEX.json',reviewRaw=fs.readFileSync(reviewPath),template=JSON.parse(fs.readFileSync(root+'/.artifacts/p05-privacy-matched-root-ack.template02.json')),hostRaw=fs.readFileSync(root+'/.artifacts/p05-privacy-matched-host01.mjs'),hostHash=sha(hostRaw),pins=producerPins(producer),parents=producerPins(parent);
const a={...template,status:'ROOT_RUN_ACK',no_actual_approval:false,owner:'b'.repeat(32)},validate=ack=>validateMatchedAuthority(ack,rawBinding,rawPrereg,reviewRaw,pins,parents,hostHash);
const checks=[];async function check(n,f){await f();checks.push(n);}
await check('valid_in_memory_only_and_pending_external_template_denies_before_allocation',()=>{validate(a);validateAck(a,rawBinding,rawPrereg,reviewRaw);assert.throws(()=>main([root+'/.artifacts/p05-privacy-matched-root-ack.template02.json',reviewPath]));});
await check('range_keys_and_shift_fraction_NaN_negative_or_foreignsection_denied',()=>{for(const range of [{...a.range,start:1,end:85},{...a.range,count:83.5},{...a.range,count:NaN},{...a.range,start:-1},{...a.range,section:'m3-inference'},{...a.range,extra:true}])assert.throws(()=>validate({...a,range}));});
await check('worker_cannot_accept_changed_binding_prereg_or_unaccepted_domainreview',()=>{assert.throws(()=>validateAck(a,Buffer.from('{}'),rawPrereg,reviewRaw));assert.throws(()=>validateAck(a,rawBinding,Buffer.from('{}'),reviewRaw));const foreign=Buffer.from(JSON.stringify({verdict:'PASS_OTHER_SCOPE'}));assert.throws(()=>validateAck({...a,method_review_sha256:sha(foreign)},rawBinding,rawPrereg,foreign));});
await check('unknown_measure_error_identity_retained_without_nextordinal_or_replay',async()=>{const marker=Error('INERT_CANARY'),rows=[];let n=0,replayed=false;await assert.rejects(executeMatched({},{append:(_k,row)=>rows.push(row),measure:(_e,d)=>{n++;if(d.ordinal===2)throw marker;return {descriptor:d,comparisons:{one:{status:'NOT_COVERED'}}};},replay:async function*(){replayed=true;yield* rows;},reduce:()=>{throw Error('SHOULD_NOT_REACH');}}),e=>e===marker);assert.equal(n,3);assert.equal(rows.length,2);assert.equal(replayed,false);});
await check('comparisonFAIL_is_durable_before_no_nextordinal',async()=>{const rows=[];let n=0;await assert.rejects(executeMatched({},{append:(_k,row)=>rows.push(row),measure:(_e,d)=>{n++;return {descriptor:d,comparisons:{one:{status:'FAIL_MATCHED'}}};},replay:async function*(){yield* rows;},reduce:()=>{throw Error('SHOULD_NOT_REACH');}}),/MATCHED_SELECTOR/);assert.equal(rows.length,n);assert.equal(n,1);});
await check('NOT_COVERED_reaches_full84replay_without_becoming_PASS',async()=>{const rows=[],guards=[];const result=await executeMatched({},{guard:n=>guards.push(n),append:(_k,row)=>rows.push(row),measure:(_e,d)=>({descriptor:d,comparisons:{one:{status:'NOT_COVERED'}}}),replay:async function*(){yield* rows;},reduce:records=>{assert.equal(records.length,84);assert.deepEqual(records.map(r=>r.descriptor.ordinal),Array.from({length:84},(_,i)=>i));return {status:'NOT_COVERED',full_P05_PASS:false};}});assert.equal(result.status,'NOT_COVERED');assert.equal(result.full_P05_PASS,false);assert(guards.length>=170);});
const dir=root+'/.artifacts/p05-matched-operational-cold-export01';assert(!fs.existsSync(dir));fs.mkdirSync(dir);const sink=durableSink(path.join(dir,'raw'),{guard:()=>{},owner:a.owner,payloadLimit:200*1024**2});
for(let ordinal=0;ordinal<84;ordinal++)sink.append('corpus-case',{section:'privacy-matched',ordinal,result:{descriptor:{ordinal},raw:{prior:{status:'SAFE_REFUSAL'}},comparisons:{one:{status:'NOT_COVERED'}}}},{group:'privacy-matched',cell:String(ordinal)});
const summary={status:'MATCHED_EXECUTION_COMPLETE_NOT_PRIVACY_ACCEPTANCE',range:a.range,completed:84,owner:a.owner,source_identity:a.source_identity,image:a.image_id,binding_sha256:a.binding_sha256,prereg_sha256:a.prereg_sha256,method_review_sha256:a.method_review_sha256,elapsed_ms:1,typed_refusals:0,native_arm_refusals:84,native_replay_completed:true,matched:{status:'NOT_COVERED'},full_section_PASS:false,full_P05_PASS:false};summary.raw=await sink.finish(summary);summary.elapsed_ms=2;const summaryPath=path.join(dir,'summary.json'),save=v=>fs.writeFileSync(summaryPath,JSON.stringify(v));save(summary);
await check('actual_shared_export_verifier_sealed_fake84_retains_refusal_NOT_COVERED',()=>{const out=verifyRangeExport(dir,a,a.range);assert.equal(out.records,85);assert.equal(out.summary.native_arm_refusals,84);assert.equal(out.summary.matched.status,'NOT_COVERED');});
await check('summary_unsealed_status_or_refusalcount_tamper_rejected',()=>{for(const s of [{...summary,matched:{status:'PASS_MATCHED_DOMAIN_ONLY_PENDING_STRUCTURAL_AND_WIRE_ACCEPTANCE'}},{...summary,native_arm_refusals:0}]){save(s);assert.throws(()=>verifyRangeExport(dir,a,a.range),/SEALED_TERMINAL/);}save(summary);});
