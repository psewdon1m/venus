await check('shared_original20min_and_new60min_are_literal_separate_profiles',()=>{assert(fs.readFileSync(root+'/.artifacts/p05-fixedrange-host03.mjs','utf8').includes('],1205000)'));const host=hostRaw.toString();assert(host.includes('],3605000)'));assert(host.includes("if(report.export_verified)ok(['rm',name])"));assert(host.includes("'NOT_COVERED','PASS_MATCHED_DOMAIN_ONLY_PENDING_STRUCTURAL_AND_WIRE_ACCEPTANCE'"));assert(!host.includes("'UNKNOWN','NOT_COVERED'"));assert.equal(JSON.parse(rawPrereg).raw_row_bytes,2097152);});
