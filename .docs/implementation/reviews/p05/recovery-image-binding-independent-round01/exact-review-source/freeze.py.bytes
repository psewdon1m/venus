from pathlib import Path
import hashlib,json,shutil,datetime
work=Path('.artifacts/p05-recovery-image-independent01');out=Path('.docs/implementation/reviews/p05/recovery-image-binding-independent-round01');sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
r=json.loads((out/'actual-image-review.json').read_bytes());assert r['error']is None and len(r['images'])==2 and all(x['union_pins']==81for x in r['images'])
for p in work.iterdir():
 if p.is_file():q=out/'exact-review-source'/(p.name+'.bytes');q.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,q)
for name in ['p05-recovery-image-a-receipt01.json','p05-recovery-image-b-receipt01.json','p05-recovery-source13b-root-verification01.json']:
 q=out/'root-receipts'/name;q.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(Path('.artifacts')/name,q)
files=[{'path':p.relative_to(out).as_posix(),'bytes':p.stat().st_size,'sha256':sha(p)}for p in sorted(out.rglob('*'))if p.is_file()and p.name!='INDEX.json'];(out/'INDEX.json').write_text(json.dumps({'schema_version':1,'status':r['status'],'scope':'INDEPENDENT_ACTUAL_REBUILT_HISTORICAL_IMAGE_PINS_NOT_CURRENT_STAGE','files':files},indent=2)+'\n');print(json.dumps({'INDEX_sha256':sha(out/'INDEX.json'),'children':len(files),'REPORT_sha256':sha(out/'REPORT.md'),'status':r['status']}))
