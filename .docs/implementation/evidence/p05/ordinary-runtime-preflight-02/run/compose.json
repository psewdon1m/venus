{
  "services": {
    "db": {
      "image": "postgres:16.14-bookworm@sha256:64154d0babcb1741988719e703419af0382b19953706149f9872fbd0f438efa8",
      "environment": {
        "POSTGRES_DB": "venus",
        "POSTGRES_USER": "venus",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password"
      },
      "secrets": [
        "db_password"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql/data"
      ],
      "networks": [
        "isolated"
      ],
      "mem_limit": "512m",
      "cpus": 1,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U venus -d venus"
        ],
        "interval": "1s",
        "timeout": "2s",
        "retries": 60
      }
    },
    "monitor": {
      "image": "sha256:495de503501615d438a6530b792418a2a58230bf5586c86a0c35d27106ef7786",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "768m",
      "cpus": 1,
      "pids_limit": 96,
      "tmpfs": [
        "/tmp:size=16m,mode=1777"
      ],
      "environment": {
        "RUNTIME_ARTIFACT_DIRECTORY": "/artifacts"
      },
      "secrets": [
        "db_password"
      ],
      "volumes": [
        "venus-state:/var/lib/venus",
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\.artifacts\\p05\\venus-runtime-a0764950e2a9",
          "target": "/artifacts"
        },
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\tests\\p05-runtime\\probe.mjs",
          "target": "/app/runtime-probe.mjs",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\tests\\p05-runtime\\monitor.mjs",
          "target": "/app/runtime-monitor.mjs",
          "read_only": true
        }
      ],
      "networks": [
        "isolated"
      ],
      "command": [
        "node",
        "/app/runtime-monitor.mjs"
      ]
    },
    "app": {
      "image": "sha256:495de503501615d438a6530b792418a2a58230bf5586c86a0c35d27106ef7786",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "768m",
      "cpus": 1,
      "pids_limit": 96,
      "tmpfs": [
        "/tmp:size=16m,mode=1777"
      ],
      "environment": {
        "NODE_ENV": "production",
        "DB_HOST": "db",
        "DB_PASSWORD_FILE": "/run/secrets/db_password",
        "IMAGE_DIGEST": "sha256:495de503501615d438a6530b792418a2a58230bf5586c86a0c35d27106ef7786",
        "KEYRING_FILE": "/run/secrets/keyring",
        "DELETION_LEDGER_FILE": "/var/lib/venus/deletions.jsonl",
        "APP_ORIGIN": "https://127.0.0.1",
        "VENUS_DEPLOYMENT_PROFILE": "local-pilot",
        "VENUS_PRIVATE_TEXT_CHAT": "false",
        "CATALOG_REVOCATION_LEDGER_FILE": "",
        "VENUS_PRIVATE_TOPICS": "false"
      },
      "secrets": [
        "db_password",
        "keyring"
      ],
      "volumes": [
        "venus-state:/var/lib/venus"
      ],
      "network_mode": "service:monitor",
      "depends_on": {
        "monitor": {
          "condition": "service_started"
        },
        "db": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:4300/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
        ],
        "interval": "1s",
        "timeout": "2s",
        "retries": 60
      }
    }
  },
  "secrets": {
    "db_password": {
      "file": "C:\\Temp\\venus-runtime-secrets-d9nKLM\\password"
    },
    "keyring": {
      "file": "C:\\Temp\\venus-runtime-secrets-d9nKLM\\keyring.json"
    }
  },
  "volumes": {
    "postgres-data": {},
    "venus-state": {}
  },
  "networks": {
    "isolated": {
      "internal": true
    }
  }
}
