      "environment": {
        "DB_HOST": "db",
        "DB_PASSWORD_FILE": "/run/secrets/db_password",
        "VENUS_P05_ISOLATED_FIXTURE": "1",
        "VENUS_P05_LAYOUT_RUN": "1",
        "P05_ARTIFACT_DIRECTORY": "/artifacts",
        "P05_LAYOUT_ENGINE": "webkit",
        "P05_LAYOUT_LOCALE": "ru"
      },
      "secrets": [
        "db_password"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\.artifacts\\p05-pilot-bundle-source30\\.artifacts\\p05\\venus-v2-layout-cca536111dbe",
          "target": "/artifacts"
        },
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\.artifacts\\p05-pilot-bundle-source30\\.artifacts\\p05-v2-layout-producer-a33-01",
          "target": "/app/tests/p05-v2-layout-producer",
          "read_only": true
        }
      ],
      "networks": [
        "isolated"
      ],
      "labels": {
        "venus.p05.project": "venus-v2-layout-cca536111dbe",
        "venus.p05.role": "browser"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "command": [
        "node",
        "/app/tests/p05-v2-layout-producer/browser.mjs"
