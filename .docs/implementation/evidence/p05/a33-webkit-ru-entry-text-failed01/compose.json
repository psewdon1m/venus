  "secrets": {
    "db_password": {
      "file": "C:\\Temp\\venus-v2-layout-secret-uDBzx2\\password"
    }
  },
  "volumes": {
    "postgres-data": {
      "labels": {
        "venus.p05.project": "venus-v2-layout-cca536111dbe"
      }
    }
  },
  "networks": {
    "isolated": {
      "internal": true,
      "labels": {
        "venus.p05.project": "venus-v2-layout-cca536111dbe"
      }
    }
  }
