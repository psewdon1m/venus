      "init": true,
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "shm_size": "1gb",
      "mem_limit": "3g",
      "cpus": 2,
      "pids_limit": 512,
      "tmpfs": [
        "/tmp:size=1g,mode=1777,exec",
        "/home/node:size=64m,uid=1000,gid=1000"
