{
  "services": {
    "db": {
      "image": "postgres:16.14-bookworm@sha256:64154d0babcb1741988719e703419af0382b19953706149f9872fbd0f438efa8",
      "pull_policy": "never",
      "environment": {
        "POSTGRES_DB": "venus",
        "POSTGRES_USER": "venus",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password"
      },
      "secrets": [
        "db_password"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql/data"
      ],
      "networks": [
        "isolated"
      ],
      "labels": {
        "venus.p05.project": "venus-v2-layout-cca536111dbe",
        "venus.p05.role": "db"
      },
      "mem_limit": "512m",
      "cpus": 1,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U venus -d venus"
