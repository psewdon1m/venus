{
  "services": {
    "db": {
      "image": "postgres:16.14-bookworm@sha256:64154d0babcb1741988719e703419af0382b19953706149f9872fbd0f438efa8",
      "environment": {
        "POSTGRES_DB": "venus",
        "POSTGRES_USER": "venus",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/password"
      },
      "secrets": [
        "password"
      ],
      "volumes": [
        "dbdata:/var/lib/postgresql/data"
      ],
      "networks": [
        "isolated"
      ],
      "mem_limit": "512m",
      "cpus": 1,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U venus -d venus"
        ],
        "interval": "1s",
        "timeout": "2s",
        "retries": 60
      }
    },
    "api": {
      "image": "sha256:25311e4177c8358b7fb43e0b046cbc77ed72b954f07be00b0c60598b85eeef2a",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "768m",
      "cpus": 1,
      "pids_limit": 96,
      "tmpfs": [
        "/tmp:size=128m,mode=1777",
        "/home/node:size=32m,uid=1000,gid=1000"
      ],
      "environment": {
        "DB_HOST": "db",
        "DB_PASSWORD_FILE": "/run/secrets/password",
        "VENUS_P05_ISOLATED_FIXTURE": "1",
        "P05_ARTIFACT_DIRECTORY": "/artifacts"
      },
      "secrets": [
        "password"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\.docs\\implementation\\evidence\\p05\\topic-lifecycle-independent-01",
          "target": "/artifacts"
        },
        {
          "type": "bind",
          "source": "C:\\.projects\\venus\\.docs\\implementation\\evidence\\p05\\topic-lifecycle-independent-01\\controls.mjs",
          "target": "/app/tests/p05-topic-lifecycle/reviewer.mjs",
          "read_only": true
        }
      ],
      "networks": [
        "isolated"
      ]
    }
  },
  "secrets": {
    "password": {
      "file": "C:\\Temp\\venus-tlc-review-secret-xFOIL9\\password"
    }
  },
  "volumes": {
    "dbdata": {}
  },
  "networks": {
    "isolated": {
      "internal": true
    }
  }
}
