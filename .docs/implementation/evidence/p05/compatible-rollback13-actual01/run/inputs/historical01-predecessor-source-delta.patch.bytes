+}
+const hash=b=>createHash('sha256').update(b).digest('hex');
+export function rawEvidenceMap(root){const map={};const visit=(p,rel='')=>{const s=lstatSync(p);assert(!s.isSymbolicLink());assert(s.isDirectory()||s.isFile());if(s.isDirectory()){for(const n of readdirSync(p).sort()){const next=rel?rel+'/'+n:n;if(next==='control')continue;visit(join(p,n),next);}}else if(!['runner.json','RAW_INDEX.json','TERMINAL.json'].includes(rel)){const b=readFileSync(p);map[rel]={bytes:b.length,sha256:hash(b)};}};visit(resolve(root));return map;}
+export function validateEvidence(root,r){const raw=readFileSync(join(root,r.raw_evidence_index.path));assert.equal(hash(raw),r.raw_evidence_index.sha256);assert.equal(raw.length,r.raw_evidence_index.bytes);const index=JSON.parse(raw);assert.equal(index.scope,r.raw_evidence_index.scope);assert.deepEqual(index.files,rawEvidenceMap(root));for(const row of r.controls)for(const e of row.evidence){const actual=index.files[e.path];assert(actual);assert.equal(actual.bytes,e.bytes);assert.equal(actual.sha256,e.sha256);}return true;}
+export function validateAuthority(binding,ack,indexSha){
+ assert.equal(binding.status,'AUTHOR_FROZEN_READY_FOR_INDEPENDENT_PRE_RUN_REVIEW');assert.equal(binding.profile,'LIVE_SAME_POLICY_COMPATIBILITY_14');assert.equal(binding.resource_profile,'QRB_BOUND_ONLY_1');assert.equal(binding.source_freeze_complete,true);assert(digest.test(binding.source_identity));assert(digest.test(binding.prior_source_identity));assert(Number.isSafeInteger(binding.included_files)&&binding.included_files>0);assert(digest.test(binding.expanded_actual_image_UI_migration_maps_sha256));assert.equal(binding.root_run_ack,false);for(const key of ['A','B']){assert(/^sha256:[a-f0-9]{64}$/.test(binding.images[key]));assert.equal(Object.keys(binding.per_image_compiled[key]).length,64);for(const[path,h]of Object.entries(binding.per_image_compiled[key])){assert(/^(apps\/api|packages\/[a-z-]+)\/dist\/[A-Za-z0-9._/-]+$/.test(path)&&!path.split('/').includes('..'));assert(digest.test(h));}assert.equal(binding.private_policies[key],'ROOM-TOPIC-2');}assert.deepEqual(Object.keys(binding.per_image_compiled.A).sort(),Object.keys(binding.per_image_compiled.B).sort());assert.notEqual(binding.images.A,binding.images.B);assert.equal(ack.status,'AUTHORIZED');assert.equal(ack.root_run_ack,true);assert.equal(ack.attempts,1);assert.equal(ack.statistics_RUN,false);assert.equal(ack.profile,binding.profile);assert.equal(ack.resource_profile,binding.resource_profile);assert.equal(ack.producer_index_sha256,indexSha);assert.equal(ack.source_identity,binding.source_identity);assert.deepEqual(ack.images,binding.images);assert(digest.test(ack.independent_review_index_sha256));assert(digest.test(ack.application_source_review_index_sha256));assert.equal(ack.application_source_review_source,binding.source_identity);assert.equal(ack.expanded_image_map_sha256,binding.expanded_actual_image_UI_migration_maps_sha256);assert.equal(ack.whole_ms,900000);assert.equal(ack.total_cap_bytes,512*1024**2);assert.equal(ack.reserve_bytes,10*1024**3);return true;
+}
