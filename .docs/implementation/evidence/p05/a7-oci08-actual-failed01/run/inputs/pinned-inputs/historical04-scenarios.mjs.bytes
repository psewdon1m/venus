/** Five fixed synthetic rooms; all admission/consent/policy writes use real HTTP. */
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {protectedRequest} from './http-client.mjs';
export const serialize=f=>({room:f.room,invite:f.invite,host:f.host,members:f.members,game:f.game,plan:{round_id:f.plan?.round_id},requests:f.requests??[],excludedActor:f.excludedActor});
export const restore=f=>({...f,host:{...f.host},members:f.members.map(m=>({...m})),plan:{...f.plan},requests:[...f.requests]});
const actor=(f,id)=>{const a=f.members.find(m=>m.id===id);assert(a);return a;};
async function consent(h,f,scope,requests){for(const id of f.plan.actors){const a=actor(f,id),target=await h.ok(a,h.round(f)+'/target'),offer=target[scope];assert(offer);if(offer.state==='pending'&&offer.own_state!=='accepted'){const body={request_id:randomUUID(),kind:'accept',scope,offer_id:offer.offer_id,proposal_revision:offer.proposal_revision};requests.push({actor:id,suffix:'/response',body,receipt:await h.ok(a,h.round(f)+'/response','POST',body)});}}}
export async function activePrivate(h){
 const f=await h.create(2,{context:'online'});f.members=[f.host];for(let i=0;i<3;i++){const previous=[...f.members];const peer=await h.joinRoom(f);f.members=[...previous,peer];}assert.equal(f.members.length,4);await h.setup(f);
 const selected=f.members.slice(1,3);assert(selected.every(a=>a.id!==f.host.id));const room=await h.roomView(f),prepared=await h.ok(f.host,h.base(f)+'/prepare','POST',{request_id:randomUUID(),expected_rev:room.room_rev,mode:'questions',round_count:20,players:selected.map(a=>a.id)});await h.ok(f.host,h.base(f)+'/start','POST',{request_id:randomUUID(),draft_rev:prepared.game_rev});let found=false;
 for(let i=1;i<=20;i++){await h.current(f);assert.equal(f.plan.round_index,i);if(f.plan.interaction==='pair_private'){found=true;break;}await h.ok(actor(f,f.plan.primary_member_id),h.round(f)+'/response','POST',{request_id:randomUUID(),kind:'skip'});if(i<20){const g=await h.current(f);await h.ok(f.host,h.base(f)+`/${f.game}/round/advance`,'POST',{request_id:randomUUID(),expected_rev:Number(g.rev)});}}
 assert(found,'FIXED_ONE_SESSION20_PRIVATE_OPPORTUNITY_REQUIRED');assert(f.plan.actors.every(id=>selected.some(a=>a.id===id)));const requests=[];await consent(h,f,'invitation',requests);await h.current(f);assert.equal(f.plan.requires_action_consent,true);
 for(const id of f.plan.actors){const a=actor(f,id),v=await h.ok(a,h.round(f)+'/conversation');assert(v.offer);if(!v.offer.own_accepted){const body={request_id:randomUUID(),kind:'respond_topic',offer_id:v.offer.offer_id,epoch:v.epoch,proposal_revision:v.offer.proposal_revision,token:v.offer.token,decision:'accept'};requests.push({actor:id,suffix:'/conversation/commands',body,receipt:await h.ok(a,h.round(f)+'/conversation/commands','POST',body)});}}
 await consent(h,f,'action',requests);const first=actor(f,f.plan.actors[0]),second=actor(f,f.plan.actors[1]),v=await h.ok(first,h.round(f)+'/conversation');assert(v.prompt?.text.includes('SYNTHETIC'));
 const adviceBody={request_id:randomUUID(),kind:'offer_advice',epoch:v.epoch,offer_id:v.offer.offer_id,text:'SYNTHETIC OCI PRIVATE ADVICE'},offered=await h.ok(first,h.round(f)+'/conversation/commands','POST',adviceBody);requests.push({actor:first.id,suffix:'/conversation/commands',body:adviceBody,receipt:offered});const seen=await h.ok(second,h.round(f)+'/conversation'),advice=seen.advice.find(a=>a.advice_id===offered.advice_id);assert(advice&&advice.state==='pending'&&advice.text===undefined);
 const accept={request_id:randomUUID(),kind:'respond_advice',advice_id:advice.advice_id,proposal_revision:advice.revision,epoch:advice.epoch,decision:'accept'},receipt=await h.ok(second,h.round(f)+'/conversation/commands','POST',accept);requests.push({actor:second.id,suffix:'/conversation/commands',body:accept,receipt});assert((await h.ok(second,h.round(f)+'/conversation')).advice.some(a=>a.text===adviceBody.text));
 const chat={request_id:randomUUID(),conversation_id:v.conversation_id,epoch:v.epoch,text:'SYNTHETIC OCI PRIVATE CHAT'},chatReceipt=await h.ok(first,h.round(f)+'/conversation/chat','POST',chat);requests.push({actor:first.id,suffix:'/conversation/chat',body:chat,receipt:chatReceipt});assert((await h.ok(second,h.round(f)+'/conversation/chat')).messages.some(m=>m.text===chat.text));for(const id of f.plan.actors)assert((await h.ok(actor(f,id),h.round(f)+'/conversation')).prompt);f.requests=requests;f.excludedActor=first.id;return f;
}
export async function deniedPrivate(response){assert([404,409].includes(response.status));assert(['ROUND_STALE','ROUND_NOT_ACTIVE','CONVERSATION_STALE','CONVERSATION_UNAVAILABLE','PRIVATE_CHAT_UNAVAILABLE','PRIVATE_CONVERSATION_REQUIRED','CONSENT_NOT_ACTIVE','CONSENT_EXPIRED'].includes(response.body.code));assert(!response.raw.includes('SYNTHETIC'));}
export async function ACL(h,f,config){for(const a of [f.host,f.members[3]]){const r=await h.call(a,h.round(f)+'/conversation');assert.equal(r.status,403);assert.equal(r.body.code,'ROUND_ACTOR_REQUIRED');assert(!r.raw.includes('SYNTHETIC'));}const selected=actor(f,f.plan.actors[0]),path=h.round(f)+'/conversation',noCookie=await protectedRequest(config,path);assert.equal(noCookie.status,401);const badCSRF=await protectedRequest(config,path,{headers:{cookie:'venus_room_session='+selected.credential,'x-csrf-token':'INVALID','sec-fetch-site':'same-origin'}});assert.equal(badCSRF.status,403);const badOrigin=await protectedRequest(config,h.round(f)+'/response',{method:'POST',headers:{cookie:'venus_room_session='+selected.credential,origin:'https://evil.invalid','content-type':'application/json','x-csrf-token':h.rooms.csrf(selected.credential)},body:JSON.stringify({request_id:randomUUID(),kind:'skip'})});assert.equal(badOrigin.status,403);return{nonselected_host_denied:true,observer_denied:true,auth_CSRF_Origin_negatives:true};}
export async function seed(h,obs,config){const A=await activePrivate(h),D=await activePrivate(h),B=await h.create(2,{context:'online'}),C=await h.create(2,{context:'online'});for(const f of [B,C]){await h.joinRoom(f);await h.setup(f);}const acl=await ACL(h,A,config),baseline={A:await obs.liveUntouched(h.pool,h.keys,A,h.time()),D:await obs.liveUntouched(h.pool,h.keys,D,h.time())};return{A:serialize(A),B:serialize(B),C:serialize(C),D:serialize(D),baseline,acl,sourcePins:h.source.map.pins,initialAuthority:obs.authorityMap(h.directory)};}
export async function narrow(h,obs,state){const A=restore(state.A),B=restore(state.B),C=restore(state.C);await h.current(A);const excluded=actor(A,A.excludedActor);assert.equal((await h.exclude(A,excluded,['romance'])).status,200);assert((await h.getTopics(A,excluded)).exclude_topic_ids.includes('romance'));assert.equal((await h.mutateRoom(B,B.host,'close')).status,200);assert.equal((await h.mutateRoom(C,C.members.find(a=>a.id!==C.host.id),'leave')).status,200);const roots=obs.authorityMap(h.directory);assert.notEqual(obs.sha(roots),obs.sha(state.initialAuthority));assert.deepEqual(obs.roomAuthority(roots,state.D.room),obs.roomAuthority(state.initialAuthority,state.D.room));const d=restore(state.D);const liveD=await obs.liveUntouched(h.pool,h.keys,d,h.time());return{...state,authorityAfterNarrow:roots,liveD_before_switch:liveD};}
export async function preserved(h,obs,state){const A=restore(state.A),B=restore(state.B),C=restore(state.C),stored=await obs.storedGame(h.pool,h.keys,A);assert.equal(obs.sha(stored.game.snapshot_cipher),state.baseline.A.snapshot_sha256);assert.equal(obs.sha(stored.history),state.baseline.A.history_sha256);const own=await h.getTopics(A,actor(A,A.excludedActor));assert(own.exclude_topic_ids.includes('romance')&&!own.allow_topic_ids.includes('romance'));for(const[f,a]of [[B,B.host],[C,C.members.find(a=>a.id!==C.host.id)]]){const r=await h.call(a,h.roomPath(f));assert(r.status>=400&&r.status<500);assert(!r.raw.includes('SYNTHETIC'));}return{A_exclusion:true,B_closed:true,C_retired:true};}
export async function replay(h,obs,effects,saved,baseline){const f=restore(saved),rows=[];for(const id of (await obs.storedGame(h.pool,h.keys,f)).data.plan.actors){const ordinary=await h.call(actor(f,id),h.roomPath(f));assert.equal(ordinary.status,200);}
 for(const suffix of ['/target','/conversation','/conversation/chat']){const a=actor(f,(await obs.storedGame(h.pool,h.keys,f)).data.plan.actors[0]),before=await effects.effectSnapshot(h),r=await h.call(a,h.round(f)+suffix);await deniedPrivate(r);rows.push({kind:'read',status:r.status,code:r.body.code,effects:await effects.verifyEffects(h,f,a,before,await effects.effectSnapshot(h),{allowRevocationOnly:true,baseline})});}
 for(const request of f.requests){const a=actor(f,request.actor),before=await effects.effectSnapshot(h),r=await h.call(a,h.round(f)+request.suffix,'POST',request.body);let receipt=null;if(request.suffix==='/conversation/chat')await deniedPrivate(r);else if(r.status===200)receipt=effects.originalReceipt(r,request.receipt);else await deniedPrivate(r);const effect=await effects.verifyEffects(h,f,a,before,await effects.effectSnapshot(h),{allowRevocationOnly:r.status!==200,baseline});const body={...request.body,request_id:randomUUID()},freshBefore=await effects.effectSnapshot(h),fresh=await h.call(a,h.round(f)+request.suffix,'POST',body);await deniedPrivate(fresh);const freshEffect=await effects.verifyEffects(h,f,a,freshBefore,await effects.effectSnapshot(h),{allowRevocationOnly:true,baseline});assert.equal(Number((await h.pool.query('SELECT count(*) AS n FROM topic_game_requests WHERE room_id=$1 AND member_id=$2 AND request_id=$3',[f.room,a.id,body.request_id])).rows[0].n),0);rows.push({kind:'exact_and_new_ID',status:r.status,receipt,effect,fresh_status:fresh.status,fresh_code:fresh.body.code,new_receipts:0,freshEffect});}return rows;
}
