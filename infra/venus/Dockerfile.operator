ARG DOCKER_CLI_IMAGE
FROM ${DOCKER_CLI_IMAGE} AS dockercli
FROM node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS runtime
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
WORKDIR /opt/venus
COPY tools/venus-operator tools/venus-operator
COPY tools/media-provision.mjs tools/media-provision.mjs
COPY tools/presentation-provision.mjs tools/presentation-provision.mjs
COPY infra/venus/compose.standalone.yml infra/venus/compose.standalone.yml
COPY infra/venus/compose.media.standalone.yml infra/venus/compose.media.standalone.yml
COPY infra/venus/compose.presentations.standalone.yml infra/venus/compose.presentations.standalone.yml
USER 1001:1002
ENTRYPOINT ["node","tools/venus-operator/cli.mjs"]

FROM runtime AS fixture
COPY tests/p06 tests/p06
COPY tests/presentations tests/presentations
