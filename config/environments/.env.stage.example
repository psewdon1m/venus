# ==============================================
# Venus Platform - Stage Environment Variables
# ==============================================
# This file contains stage-specific configurations
# Copy to .env.stage on server
# ==============================================

# Environment
NODE_ENV=stage
LOG_LEVEL=debug

# ==============================================
# Domain Configuration (Stage)
# ==============================================

DOMAIN=stage.tgcall.us
NEXT_PUBLIC_SITE_URL=https://tgcall.us
NEXT_PUBLIC_API_URL=https://api.tgcall.us
NEXT_PUBLIC_CDN_URL=https://cdn.tgcall.us

# ==============================================
# Database Configuration (Stage)
# ==============================================

DATABASE_URL=postgresql://venus_stage:VenusStage2025!@postgres:5432/venus_stage
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=venus_stage
DATABASE_USER=venus_user
DATABASE_PASSWORD=VenusStage2025!
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://:VenusRedis2025!@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=VenusRedis2025!
REDIS_DB=1

# ==============================================
# API & Services
# ==============================================

API_GATEWAY_PORT=4000
CORS_ORIGINS=https://stage.tgcall.us

# Auth
JWT_SECRET=N5VOUSMpkTuVTRskZYwZODyVpAFpRtNkCd6wNgRslseJn5xnJZWwOwMhT0sWIyBE
SESSION_SECRET=OfyxBY/Oq/VpN9u4Qgf4dwS1jQlPF8xCOQblLYB4SAk=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Services
PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# ==============================================
# Storage (Stage)
# ==============================================

S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=venus-media-stage
S3_ACCESS_KEY=YOUR_STAGE_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_STAGE_R2_SECRET_KEY
S3_PUBLIC_URL=https://cdn.stage.tgcall.us

CDN_URL=https://cdn.stage.tgcall.us
CDN_CACHE_TTL=3600

# ==============================================
# AI & Email (Stage)
# ==============================================

OPENAI_API_KEY=sk-STAGE_OPENAI_KEY
OPENAI_MODEL=gpt-4
RESEND_API_KEY=re_STAGE_RESEND_KEY
EMAIL_FROM=stage@tgcall.us

# ==============================================
# Monitoring (Stage)
# ==============================================

SENTRY_DSN=https://STAGE_SENTRY_DSN@sentry.io/PROJECT
SENTRY_ENVIRONMENT=stage
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=stage.tgcall.us
NEXT_PUBLIC_PLAUSIBLE_ENABLED=true

# ==============================================
# Feature Flags (Stage - all enabled for testing)
# ==============================================

FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=true

# ==============================================
# Security (Stage - slightly relaxed)
# ==============================================

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true

MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=15m

# ==============================================
# Deployment
# ==============================================

DEPLOYMENT_ENVIRONMENT=stage
COMPOSE_PROJECT_NAME=venus-stage

ADMIN_EMAIL=admin@venus.app
ADMIN_PASSWORD=VenusAdmin2025!