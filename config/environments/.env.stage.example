# ==================================================
# Venus Platform - Stage Environment (.env.stage)
# ==================================================

# -- Runtime --------------------------------------------------
NODE_ENV=stage
LOG_LEVEL=info
WATCH_FILES=false

# -- Domains --------------------------------------------------
DOMAIN={{STAGE_SITE_DOMAIN}}
NEXT_PUBLIC_SITE_URL=https://{{STAGE_SITE_DOMAIN}}
NEXT_PUBLIC_API_URL=https://{{STAGE_API_DOMAIN}}
NEXT_PUBLIC_CDN_URL=https://{{STAGE_CDN_DOMAIN}}
FRONTEND_PORT=3000

# -- Database (PostgreSQL in docker network) -----------------
DATABASE_URL={{STAGE_DATABASE_URL}}
DATABASE_INTERNAL_URL={{STAGE_DATABASE_INTERNAL_URL}}
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=venus_stage
DATABASE_USER=venus_stage
DATABASE_PASSWORD={{STAGE_DATABASE_PASSWORD}}
DATABASE_SSL=false
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20

# -- Redis ----------------------------------------------------
REDIS_URL={{STAGE_REDIS_URL}}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{STAGE_REDIS_PASSWORD}}
REDIS_DB=1

# -- API Gateway ----------------------------------------------
API_GATEWAY_PORT=4000
CORS_ORIGINS=https://{{STAGE_SITE_DOMAIN}}

# -- Auth -----------------------------------------------------
JWT_SECRET={{STAGE_JWT_SECRET}}
SESSION_SECRET={{STAGE_SESSION_SECRET}}
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# -- Services -------------------------------------------------
PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# -- Storage (Cloudflare R2) ---------------------------------
S3_ENDPOINT=https://{{STAGE_S3_ACCOUNT_ID}}.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET={{STAGE_S3_BUCKET}}
S3_ACCESS_KEY={{STAGE_S3_ACCESS_KEY}}
S3_SECRET_KEY={{STAGE_S3_SECRET_KEY}}
S3_PUBLIC_URL=https://{{STAGE_CDN_DOMAIN}}
CDN_URL=https://{{STAGE_CDN_DOMAIN}}
CDN_CACHE_TTL=3600

# -- AI & Email ----------------------------------------------
OPENAI_API_KEY={{STAGE_OPENAI_API_KEY}}
OPENAI_MODEL=gpt-4
RESEND_API_KEY={{STAGE_RESEND_API_KEY}}
EMAIL_FROM=stage@example.com

# -- Monitoring / Analytics ----------------------------------
SENTRY_DSN={{STAGE_SENTRY_DSN}}
SENTRY_ENVIRONMENT=stage
NEXT_PUBLIC_PLAUSIBLE_DOMAIN={{STAGE_SITE_DOMAIN}}
NEXT_PUBLIC_PLAUSIBLE_ENABLED=true

# -- Feature Flags -------------------------------------------
FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=true

# -- Security -------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=15m

# -- Deployment metadata -------------------------------------
DEPLOYMENT_ENVIRONMENT=stage
COMPOSE_PROJECT_NAME=venus-stage
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30s

# -- Bootstrap admin -----------------------------------------
ADMIN_EMAIL={{STAGE_ADMIN_EMAIL}}
ADMIN_PASSWORD={{STAGE_ADMIN_PASSWORD}}
