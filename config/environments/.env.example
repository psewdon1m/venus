# ==================================================
# Venus Platform - Generic Environment Template
# ==================================================
# Скопируй в нужный файл (.env, .env.stage, .env.prod)
# и заполните реальными значениями.
# ==================================================

# -- Runtime --------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# -- Domains --------------------------------------------------
DOMAIN=<your-domain>
NEXT_PUBLIC_SITE_URL=https://<your-site-domain>
NEXT_PUBLIC_API_URL=https://api.<your-domain>
NEXT_PUBLIC_CDN_URL=https://cdn.<your-domain>
FRONTEND_PORT=3000

# -- Database (PostgreSQL) ------------------------------------
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_INTERNAL_URL=postgresql://<db_user>:<db_password>@postgres:5432/<db_name>
DATABASE_HOST=<db_host>
DATABASE_PORT=5432
DATABASE_NAME=<db_name>
DATABASE_USER=<db_user>
DATABASE_PASSWORD=<db_password>
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -- Redis ----------------------------------------------------
REDIS_URL=redis://:<redis_password>@<redis_host>:6379/<db_index>
REDIS_HOST=<redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_DB=0

# -- API Gateway ----------------------------------------------
API_GATEWAY_PORT=4000
CORS_ORIGINS=https://<allowed-origin>

# -- Auth -----------------------------------------------------
JWT_SECRET=<64-char-secret>
SESSION_SECRET=<32-char-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# -- Services -------------------------------------------------
PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# -- Storage (S3/R2) -----------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<bucket>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_PUBLIC_URL=https://cdn.<your-domain>
CDN_URL=https://cdn.<your-domain>
CDN_CACHE_TTL=3600

# -- AI & Email ----------------------------------------------
OPENAI_API_KEY=<openai-key>
OPENAI_MODEL=gpt-4
RESEND_API_KEY=<resend-key>
EMAIL_FROM=noreply@<your-domain>

# -- Monitoring/Analytics ------------------------------------
SENTRY_DSN=<sentry-dsn>
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=<your-domain>
NEXT_PUBLIC_PLAUSIBLE_ENABLED=true

# -- Feature Flags -------------------------------------------
FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=false
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=false

# -- Security -------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m

# -- Deployment ----------------------------------------------
DEPLOYMENT_ENVIRONMENT=production
COMPOSE_PROJECT_NAME=venus-prod
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30s

# -- Admin bootstrap -----------------------------------------
ADMIN_EMAIL=admin@<your-domain>
ADMIN_PASSWORD=<strong-password>
