# ==============================================
# Venus Platform - Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to git
# ==============================================

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/venus_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=venus_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================
# API Gateway Configuration
# ==============================================

API_GATEWAY_PORT=4000
API_GATEWAY_HOST=localhost
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_USER=200

# ==============================================
# Frontend Configuration
# ==============================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/cdn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_PORT=3000

# Production example (tgcall.us):
# NEXT_PUBLIC_API_URL=https://api.tgcall.us
# NEXT_PUBLIC_CDN_URL=https://cdn.tgcall.us
# NEXT_PUBLIC_SITE_URL=https://tgcall.us

# ==============================================
# Authentication Service
# ==============================================

AUTH_SERVICE_PORT=4001
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=your-session-secret-change-this
BCRYPT_ROUNDS=12

# Password Requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ==============================================
# Project Service
# ==============================================

PROJECT_SERVICE_PORT=4002

# ==============================================
# Persona Service
# ==============================================

PERSONA_SERVICE_PORT=4003

# ==============================================
# Media Service
# ==============================================

MEDIA_SERVICE_PORT=4004

# Object Storage (S3/R2)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=auto
S3_BUCKET=venus-media-dev
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_PUBLIC_URL=https://cdn.tgcall.us

# CDN
CDN_URL=http://localhost:4000/cdn
# Production: https://cdn.tgcall.us
CDN_CACHE_TTL=3600

# Upload Limits
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_DOCUMENT_SIZE=20971520

# Supported Formats
ALLOWED_IMAGE_FORMATS=jpeg,jpg,png,webp,avif,svg
ALLOWED_VIDEO_FORMATS=mp4,webm
ALLOWED_DOCUMENT_FORMATS=pdf

# ==============================================
# AI CV Service
# ==============================================

AI_CV_SERVICE_PORT=4005

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# PDF Generation
PDF_GENERATION_TIMEOUT=30s
PDF_STORAGE_PATH=/tmp/cv-generated

# ==============================================
# Email Service (optional)
# ==============================================

# Email Provider (resend, sendgrid, mailgun)
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@tgcall.us
EMAIL_FROM_NAME=Venus Platform

# Resend
RESEND_API_KEY=your-resend-api-key

# SendGrid (alternative)
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun (alternative)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.venus.app

# ==============================================
# Monitoring & Analytics
# ==============================================

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tgcall.us
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false

# ==============================================
# Feature Flags
# ==============================================

FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=false
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=false

# ==============================================
# Security
# ==============================================

# CORS
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m

# ==============================================
# Development Tools
# ==============================================

# Hot Reload
WATCH_FILES=true
RELOAD_ON_CHANGE=true

# Debug
DEBUG=false
VERBOSE_LOGGING=false

# Seeding
SEED_TEST_DATA=true
SEED_ADMIN_EMAIL=admin@venus.app
SEED_ADMIN_PASSWORD=Admin123!@#

# ==============================================
# Testing
# ==============================================

# Test Database
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/venus_test
TEST_REDIS_URL=redis://localhost:6379/1

# ==============================================
# Docker Configuration
# ==============================================

# Docker Compose
COMPOSE_PROJECT_NAME=venus
COMPOSE_FILE=docker-compose.yml

# Container Names
POSTGRES_CONTAINER_NAME=venus-postgres
REDIS_CONTAINER_NAME=venus-redis

# ==============================================
# Deployment (Stage/Production)
# ==============================================

# Only set these in stage/production environments

# DEPLOYMENT_ENVIRONMENT=stage
# DEPLOYMENT_REGION=us-east-1
# HEALTH_CHECK_PATH=/health
# HEALTH_CHECK_INTERVAL=30s

# SSL/TLS
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Backup
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 0 * * *
# BACKUP_RETENTION_DAYS=30