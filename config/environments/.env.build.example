# ==================================================
# Venus Platform - CI Build/Test Environment (.env.build)
# Tailored for docker-compose build overlay in CI/E2E jobs
# ==================================================

# Runtime
NODE_ENV=stage
LOG_LEVEL=debug
WATCH_FILES=false

# Domains / Public URLs
DOMAIN=localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/cdn
FRONTEND_PORT=3000

# Database (local Postgres in docker network)
DATABASE_URL=postgresql://postgres:password@localhost:5432/venus_dev
DATABASE_INTERNAL_URL=postgresql://postgres:password@postgres:5432/venus_dev
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=venus_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Gateway
API_GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Auth / Security
JWT_SECRET=test-jwt-secret
SESSION_SECRET=test-session-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10

# Services
PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# Storage (dummy values for CI)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=venus
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_PUBLIC_URL=http://localhost:4000/cdn
CDN_URL=http://localhost:4000/cdn
CDN_CACHE_TTL=300

# AI & Email (dummy)
OPENAI_API_KEY=dummy-openai-key
OPENAI_MODEL=gpt-4
RESEND_API_KEY=dummy-resend-key
EMAIL_FROM=ci@example.com

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=ci
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=localhost
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false

# Feature Flags
FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=true
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=false

# Cookies / Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=15m

# Deployment metadata
DEPLOYMENT_ENVIRONMENT=ci
COMPOSE_PROJECT_NAME=venus-ci
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30s

# Bootstrap admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
