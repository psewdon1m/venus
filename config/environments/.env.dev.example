# ==================================================
# Venus Platform - Local Development (.env.dev)
# ==================================================

NODE_ENV=development
LOG_LEVEL=debug
WATCH_FILES=true

# -- Domains --------------------------------------------------
DOMAIN=localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/cdn
FRONTEND_PORT=3000

# -- Database -------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/venus_dev
DATABASE_INTERNAL_URL=postgresql://postgres:password@postgres:5432/venus_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=venus_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false

# -- Redis ----------------------------------------------------
REDIS_URL=redis://:dev-password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-password
REDIS_DB=0

# -- API Gateway ----------------------------------------------
API_GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000

# -- Auth -----------------------------------------------------
JWT_SECRET=dev-secret-key-change-in-production
SESSION_SECRET=dev-session-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# -- Services -------------------------------------------------
PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# -- Storage --------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=auto
S3_BUCKET=venus-media-dev
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
S3_PUBLIC_URL=http://localhost:4000/cdn
CDN_URL=http://localhost:4000/cdn

# -- AI & Email ----------------------------------------------
OPENAI_API_KEY=dummy-openai-key
OPENAI_MODEL=gpt-4
RESEND_API_KEY=dummy-resend-key
EMAIL_FROM=dev@venus.local

# -- Monitoring ----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=localhost
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false

# -- Feature Flags -------------------------------------------
FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=false
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=false

# -- Security -------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true

# -- Bootstrap admin -----------------------------------------
ADMIN_EMAIL=admin@venus.app
ADMIN_PASSWORD=Admin123!@#
