# ==============================================
# Venus Platform - Production Environment Variables
# ==============================================
# This file contains production-specific configurations
# Copy to .env.production on server and fill with actual values
# NEVER commit .env.production to git
# ==============================================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# ==============================================
# Server Configuration
# ==============================================

SERVER_IP=31.172.78.81
SERVER_LOCATION=Netherlands
DEPLOYMENT_REGION=eu-west

# ==============================================
# Domain Configuration
# ==============================================

# Primary Domain
DOMAIN=tgcall.us
NEXT_PUBLIC_SITE_URL=https://tgcall.us

# API
API_DOMAIN=api.tgcall.us
NEXT_PUBLIC_API_URL=https://api.tgcall.us

# CDN
CDN_DOMAIN=cdn.tgcall.us
NEXT_PUBLIC_CDN_URL=https://cdn.tgcall.us

# Admin (internal)
ADMIN_DOMAIN=admin.tgcall.us

# ==============================================
# Database Configuration (Production)
# ==============================================

# PostgreSQL (set strong password)
DATABASE_URL=postgresql://venus_user:CHANGE_THIS_PASSWORD@postgres:5432/venus_prod
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=venus_prod
DATABASE_USER=venus_user
DATABASE_PASSWORD=CHANGE_THIS_PASSWORD
DATABASE_SSL=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis (set strong password)
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD
REDIS_DB=0

# ==============================================
# API Gateway Configuration
# ==============================================

API_GATEWAY_PORT=4000
API_GATEWAY_HOST=0.0.0.0
CORS_ORIGINS=https://tgcall.us,https://staging.tgcall.us

# Rate Limiting (stricter for production)
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_PER_USER=100

# ==============================================
# Frontend Configuration
# ==============================================

FRONTEND_PORT=3000

# ==============================================
# Authentication Service
# ==============================================

AUTH_SERVICE_PORT=4001

# CRITICAL: Generate strong random secrets
# Use: openssl rand -base64 32
JWT_SECRET=GENERATE_STRONG_SECRET_32_CHARS_MIN
SESSION_SECRET=GENERATE_STRONG_SECRET_32_CHARS_MIN

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Password Requirements (strict)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ==============================================
# Microservices Ports
# ==============================================

PROJECT_SERVICE_PORT=4002
PERSONA_SERVICE_PORT=4003
MEDIA_SERVICE_PORT=4004
AI_CV_SERVICE_PORT=4005

# ==============================================
# Media Service & Storage
# ==============================================

# Cloudflare R2 or AWS S3
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=venus-media-prod
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_R2_SECRET_KEY
S3_PUBLIC_URL=https://cdn.tgcall.us

# CDN Configuration
CDN_URL=https://cdn.tgcall.us
CDN_CACHE_TTL=31536000

# Upload Limits
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_DOCUMENT_SIZE=20971520

# Supported Formats
ALLOWED_IMAGE_FORMATS=jpeg,jpg,png,webp,avif,svg
ALLOWED_VIDEO_FORMATS=mp4,webm
ALLOWED_DOCUMENT_FORMATS=pdf

# ==============================================
# AI CV Service
# ==============================================

# OpenAI API (required for CV generation)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# PDF Generation
PDF_GENERATION_TIMEOUT=60s
PDF_STORAGE_PATH=/app/tmp/cv-generated

# ==============================================
# Email Service
# ==============================================

EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@tgcall.us
EMAIL_FROM_NAME=Venus Platform

# Resend API Key
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ==============================================
# Monitoring & Analytics
# ==============================================

# Sentry (error tracking)
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Plausible Analytics (privacy-friendly)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tgcall.us
NEXT_PUBLIC_PLAUSIBLE_ENABLED=true

# ==============================================
# Feature Flags (Production)
# ==============================================

FEATURE_AI_CV=true
FEATURE_MULTIPLE_PERSONAS=true
FEATURE_PUBLIC_API=false
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=true

# ==============================================
# Security (Production)
# ==============================================

# CORS (strict)
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Cookie Settings (secure)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=.tgcall.us

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30m

# Session
SESSION_LIFETIME=24h
SESSION_ABSOLUTE_TIMEOUT=7d

# ==============================================
# SSL/TLS Configuration
# ==============================================

SSL_ENABLED=true
SSL_CERT_PATH=/etc/letsencrypt/live/tgcall.us/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/tgcall.us/privkey.pem

# ==============================================
# Backup Configuration
# ==============================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/opt/venus/backups
BACKUP_S3_BUCKET=venus-backups-prod

# ==============================================
# Performance
# ==============================================

# Node.js
NODE_OPTIONS=--max-old-space-size=2048

# Connection pools
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
REDIS_POOL_MAX=50

# Cache
CACHE_TTL_DEFAULT=300
CACHE_TTL_STATIC=31536000

# ==============================================
# Logging
# ==============================================

LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/venus/app.log
LOG_ROTATION=daily
LOG_MAX_SIZE=100M
LOG_MAX_FILES=30

# ==============================================
# Health Checks
# ==============================================

HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ==============================================
# Docker Configuration
# ==============================================

COMPOSE_PROJECT_NAME=venus-prod
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ==============================================
# Deployment Metadata
# ==============================================

DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_VERSION=0.0.1-alpha
DEPLOYMENT_DATE=2025-11-21