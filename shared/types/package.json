{
  "name": "@venus/types",
  "version": "0.0.1-alpha",
  "description": "Shared TypeScript types for Venus Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "venus",
    "types",
    "typescript"
  ],
  "author": "Venus Contributors",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ]
}
